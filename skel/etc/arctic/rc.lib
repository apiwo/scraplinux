#!/bin/sh
# Arctic Linux - boot output helpers, shared by rc.boot, rc.shutdown and
# service. Sourced, never executed.
# shellcheck shell=sh disable=SC2039

# Console width, worked out on first use and remembered.
#
# It used to be measured once, when this file was sourced - which is the first
# thing rc.boot does, before it has mounted /dev. There was no /dev/console to
# ask yet, so every boot fell back to 80 columns and then right-aligned the
# whole boot against column 80 of a console that is usually far wider. On a
# 1080p framebuffer that is 240 columns: the status sat a third of the way
# across and the rest of the line was empty.
#
# Asking at first use instead means /dev is mounted by the time the question
# is put, and the answer is cached so it is still only asked once.
_rc_cols=""
_rc_width() {
	if [ -z "$_rc_cols" ]; then
		_rc_cols=$(stty size 2>/dev/null </dev/console | cut -d" " -f2)
		case "$_rc_cols" in
		''|*[!0-9]*) _rc_cols="" ;;
		esac
		# The framebuffer knows even when there is no controlling terminal
		# to ask. 8 pixels per column is the built-in console font.
		if [ -z "$_rc_cols" ] && [ -r /sys/class/graphics/fb0/virtual_size ]; then
			_rc_fbw=$(cut -d, -f1 /sys/class/graphics/fb0/virtual_size 2>/dev/null)
			case "$_rc_fbw" in
			''|*[!0-9]*) ;;
			*) _rc_cols=$(( _rc_fbw / 8 )) ;;
			esac
		fi
		case "$_rc_cols" in
		''|*[!0-9]*) _rc_cols=80 ;;
		esac
		[ "$_rc_cols" -ge 40 ] || _rc_cols=80
		[ "$_rc_cols" -le 300 ] || _rc_cols=300
	fi
	printf '%s' "$_rc_cols"
}

if [ -t 1 ] && [ "${TERM:-linux}" != "dumb" ]; then
	_R=$(printf '\033[0m');   _B=$(printf '\033[1m')
	_VIO=$(printf '\033[38;5;99m'); _IND=$(printf '\033[38;5;69m')
	_ICE=$(printf '\033[38;5;81m'); _TEAL=$(printf '\033[38;5;44m')
	_MINT=$(printf '\033[38;5;49m'); _SNOW=$(printf '\033[38;5;231m')
	_GREY=$(printf '\033[38;5;245m'); _RED=$(printf '\033[38;5;203m')
	_AMB=$(printf '\033[38;5;215m')
else
	_R= ; _B= ; _VIO= ; _IND= ; _ICE= ; _TEAL= ; _MINT= ; _SNOW= ; _GREY= ; _RED= ; _AMB=
fi

_rc_msg=""

# One line per action, with the result right-aligned. Quiet boots print nothing
# until something actually goes wrong.
# Elapsed time, in hundredths of a second, from /proc/uptime.
#
# Not `date`: this runs before the clock is set, and busybox's date has no
# reliable sub-second format anyway. /proc/uptime is two numbers, the first
# being seconds with two decimals - "12.34" becomes 1234, and the arithmetic
# stays integer, which is all POSIX sh has.
_rc_cs() {
	# rc.boot times its first step - mounting the pseudo-filesystems - which
	# means this runs before /proc exists. A failed input redirection is the
	# shell's own error and it is written before "2>/dev/null" is in effect,
	# so redirecting stderr never silenced it: every boot opened with
	# "can't open /proc/uptime" and then an arithmetic error, because the
	# empty result was subtracted from a moment later. Test first.
	[ -r /proc/uptime ] || { printf '0'; return; }
	read -r _c_up _c_rest </proc/uptime || { printf '0'; return; }
	[ -n "${_c_up:-}" ] || { printf '0'; return; }
	case "$_c_up" in
	*.*) _c_i=${_c_up%.*}; _c_f=${_c_up#*.} ;;
	*)   _c_i=$_c_up;      _c_f=00 ;;
	esac
	# Exactly two digits of hundredths, whatever the kernel chose to print.
	case "$_c_f" in
	?)  _c_f="${_c_f}0" ;;
	??) ;;
	*)  _c_f=$(printf '%.2s' "$_c_f") ;;
	esac
	_c_v="$_c_i$_c_f"
	# A leading zero makes the shell read the number as octal, and "086" is
	# not a valid octal number: the arithmetic that subtracts these values
	# then failed with a syntax error and took rc.boot down with it, part way
	# through the boot, before any service had started. Under ten seconds of
	# uptime - which is every step of an ordinary boot - most values have that
	# leading zero, and whether a given boot survived came down to which
	# hundredth it happened to be timed at. That is what made a live session
	# come up with no network "sometimes".
	while [ -n "$_c_v" ] && [ "$_c_v" != "${_c_v#0}" ]; do _c_v=${_c_v#0}; done
	printf '%s' "${_c_v:-0}"
}

# Hundredths to "1.32s". Both digits, not one: almost every service starts in
# well under a tenth of a second, so a single decimal place printed "t=0.0s"
# against nearly every line of the boot and the timing column said nothing at
# all. Two digits is the full resolution /proc/uptime offers.
_rc_secs() { printf '%s.%02ds' $(( ${1:-0} / 100 )) $(( ${1:-0} % 100 )); }

_rc_boot_start=$(_rc_cs)
_rc_step_start=$_rc_boot_start

begin() {
	_rc_msg="$*"
	_rc_step_start=$(_rc_cs)
	[ "${QUIET:-0}" = "1" ] && return 0
	printf '%s  ::%s %s' "$_TEAL$_B" "$_R" "$_rc_msg"
}

# Width of the status field "[ done ]" and of the "  :: " prefix begin()
# writes. No time follows it any more.
_RC_STATUS_W=9
_RC_PREFIX_W=5

# Pad so the status sits flush right without ever reaching the last column - one
# character too many wraps the closing bracket onto the next line, which is what
# made the boot read as "[ OK" on one line and "]" on the next.
_rc_pad() {
	_p=$(( $(_rc_width) - ${#_rc_msg} - _RC_PREFIX_W - _RC_STATUS_W - 1 ))
	[ "$_p" -lt 1 ] && _p=1
	_i=0; _sp=""
	while [ "$_i" -lt "$_p" ]; do _sp="$_sp "; _i=$((_i+1)); done
	printf '%s' "$_sp"
}

# No elapsed time. Every service starts in a few hundredths of a second and
# the column said nothing; what a boot line is for is whether the thing came
# up, not how long it took. _rc_cs and _rc_secs are still here because
# rc_done still reports the total.
good() {
	[ "${QUIET:-0}" = "1" ] && return 0
	printf '%s%s[%s done %s]%s\n' "$(_rc_pad)" "$_GREY" "$_MINT$_B" \
		"$_R$_GREY" "$_R"
}

bad() {
	# Failures are always shown, even on a quiet boot.
	if [ "${QUIET:-0}" = "1" ]; then
		printf '%s  ::%s %s' "$_RED$_B" "$_R" "$_rc_msg"
	fi
	printf '%s%s[%s fail %s]%s\n' "$(_rc_pad)" "$_GREY" "$_RED$_B" \
		"$_R$_GREY" "$_R"
	[ -n "${1:-}" ] && printf '%s     %s%s\n' "$_GREY" "$*" "$_R"
	# Tested, not redirected-and-hoped. A redirection that cannot be opened is
	# reported by the shell itself, before the command's own "2>/dev/null" is
	# in effect - so a failure before /run/arctic exists printed
	# "can't create /run/arctic/boot.errors" onto the console in the middle of
	# the boot, on top of the failure it was trying to record.
	if [ -d /run/arctic ] || mkdir -p /run/arctic 2>/dev/null; then
		printf '%s\n' "rc: failed: $_rc_msg ${*:-}" >>/run/arctic/boot.errors 2>/dev/null || :
	fi
}

skip() {
	[ "${QUIET:-0}" = "1" ] && return 0
	printf '%s%s[%s skip %s]%s\n' "$(_rc_pad)" "$_GREY" "$_GREY" "$_GREY" "$_R"
}

# The gradient rule and wordmark shown at the top of a boot.
# The top of the boot. One thin rule in the Arctic palette, the release and
# the kernel on one line between two of them.
#
# This used to be a full-width row of "=" in seven colours, which on a real
# screen is a solid band of punctuation with the title floating under it -
# the wider the display, the worse it looked.
_rc_rule() {
	seg=$(( $(_rc_width) / 7 ))
	[ "$seg" -lt 1 ] && seg=1
	for n in 99 63 69 75 81 44 49; do
		printf '\033[38;5;%sm' "$n"
		i=0; while [ "$i" -lt "$seg" ]; do printf '\342\224\200'; i=$((i+1)); done
	done
	printf '%s\n' "$_R"
}

banner() {
	[ "${QUIET:-0}" = "1" ] && return 0
	# The release label, not the build date: BUILD_ID is a timestamp, and a
	# boot banner reading "2026.08.14" tells you when the image was rolled
	# rather than which release of Arctic you are looking at.
	v=$(sed -n 's/^VERSION=//p' /etc/arctic-release 2>/dev/null | tr -d '"' | head -1)
	[ -n "$v" ] || v="Arctic Linux"
	k=$(uname -r)

	# The kernel sits at the right margin. Width is counted from the plain
	# text, never from the escape sequences around it, which is how a line
	# like this ends up wrapping on a narrow console.
	_pad=$(( $(_rc_width) - 4 - ${#v} - ${#k} ))
	[ "$_pad" -lt 2 ] && _pad=2
	_sp=$(printf "%${_pad}s" '')

	printf '\n'
	_rc_rule
	printf '  %s%s%s%s%s%s%s\n' \
		"$_SNOW$_B" "$v" "$_R" "$_sp" "$_GREY" "$k" "$_R"
	_rc_rule
	printf '\n'
}

rc_done() {
	[ "${QUIET:-0}" = "1" ] && return 0
	if [ -s /run/arctic/boot.errors ]; then
		printf '\n  %s%s problem(s) during boot - see /run/arctic/boot.errors%s\n\n' \
			"$_AMB" "$(wc -l </run/arctic/boot.errors | tr -d ' ')" "$_R"
	else
		printf '\n  %sInit done%s %s%s%s\n\n' "$_MINT$_B" "$_R" "$_GREY" \
			"$(_rc_secs $(( $(_rc_cs) - ${_rc_boot_start:-0} )))" "$_R"
	fi
}
