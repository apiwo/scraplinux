#!/bin/sh
# ScrapLinux - service script helpers.
# A service script sources this, sets NAME/CMD/ARGS, then calls svc_main "$@".
# shellcheck shell=sh disable=SC2039

: "${PIDFILE:=/run/$NAME.pid}"
: "${ARGS:=}"
: "${BACKGROUND:=yes}"

svc_running() {
	# A pidfile is authoritative when we have one.
	if [ -f "$PIDFILE" ]; then
		p=$(cat "$PIDFILE" 2>/dev/null)
		[ -n "$p" ] && kill -0 "$p" 2>/dev/null && return 0
		return 1
	fi
	# Otherwise look for a process whose executable really is $CMD.
	#
	# Do not match on the process name here. When the kernel runs an interpreted
	# script it sets comm to the basename of the *script*, so a service script
	# called "bluetoothd" makes "pgrep -x bluetoothd" match its own shell and
	# every service reports itself as running.
	for d in /proc/[0-9]*; do
		[ "$d" = "/proc/$$" ] && continue
		[ -e "$d/exe" ] || continue
		[ "$(readlink "$d/exe" 2>/dev/null)" = "$CMD" ] && return 0
	done
	return 1
}

svc_start() {
	svc_running && { echo "$NAME is already running"; return 0; }
	[ -x "$CMD" ] || { echo "$NAME: $CMD is not installed" >&2; return 1; }
	[ -n "${PRESTART:-}" ] && eval "$PRESTART"
	if [ "$BACKGROUND" = yes ]; then
		start-stop-daemon --start --quiet --background \
			--make-pidfile --pidfile "$PIDFILE" \
			--exec "$CMD" -- $ARGS 2>/dev/null \
		|| { $CMD $ARGS & echo $! >"$PIDFILE"; }
	else
		# The daemon backgrounds itself and writes its own pidfile.
		$CMD $ARGS || return 1
	fi
	return 0
}

svc_stop() {
	svc_running || { echo "$NAME is not running"; return 0; }
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry 10 2>/dev/null \
		|| { p=$(cat "$PIDFILE" 2>/dev/null); [ -n "$p" ] && kill "$p" 2>/dev/null; }
	else
		# No pidfile - svc_running only found this one by scanning /proc for a
		# process whose exe is $CMD (started outside svc_start, or the
		# pidfile was lost some other way). Without this, a service in that
		# state could be reported as running but could never actually be
		# stopped: start-stop-daemon --pidfile and the kill fallback above
		# both need a pidfile that does not exist.
		for d in /proc/[0-9]*; do
			[ "$(readlink "$d/exe" 2>/dev/null)" = "$CMD" ] || continue
			kill "${d#/proc/}" 2>/dev/null
		done
	fi
	rm -f "$PIDFILE"
	[ -n "${POSTSTOP:-}" ] && eval "$POSTSTOP"
	return 0
}

svc_main() {
	case "${1:-}" in
	start)   svc_start ;;
	stop)    svc_stop ;;
	restart) svc_stop; sleep 1; svc_start ;;
	status)  svc_running ;;
	*) echo "usage: $0 start|stop|restart|status" >&2; exit 2 ;;
	esac
}
