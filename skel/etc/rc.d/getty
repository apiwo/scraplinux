#!/bin/sh
# A login prompt on tty1.
#
# This is a respawn entry, not a one-shot service - see
# /etc/scraplinux/respawn/getty and scinit itself (skel/sbin/scinit), which
# runs `/etc/rc.d/getty start` in a forever-loop, restarting it the instant
# it exits (a logout, a crash, whatever). rc.boot's own one-shot service
# loop never touches this script at all.
#
# CMD is plain getty here, not wrapped in s6-setsid the way this script
# used to need under 66: that wrapper existed only because s6's own
# process-group setup made busybox getty's internal setsid() call fail with
# EPERM, silently, forever. scinit forks a plain subshell for each respawn
# loop with no such supervision-imposed session, so getty's own setsid()
# succeeds the same way it always has under busybox init or a bare shell -
# there is nothing here for a wrapper to work around.
NAME=getty
CMD=/sbin/getty
ARGS="-L 0 tty1"
BACKGROUND=no
. /etc/scraplinux/svc.lib
svc_main "$@"
