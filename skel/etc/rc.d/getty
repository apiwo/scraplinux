#!/bin/sh
# A login prompt on tty1.
#
# busybox init and OpenRC both spawn getty their own way - busybox init via
# /etc/inittab respawn entries, OpenRC via its own agetty runlevel service -
# neither goes through this rc.d/services.conf mechanism at all. s6/66 has
# no such built-in concept: every respawning process it supervises has to be
# a real service definition here, the same as dbus or pipewire. Without
# this, an s6-66 boot reaches "Starting services of trees in group: boot"
# and then never shows a login prompt at all - the boot isn't stuck, there
# is just nothing left to spawn one.
#
# CMD is s6-setsid, not getty itself: busybox getty calls setsid() on
# startup and treats EPERM as fatal, silently exiting over and over. Under
# s6 supervision the run script's process is already its own process-group
# leader, so that setsid() call always fails that way - with no controlling
# tty yet attached, getty's own error message has nowhere visible to go, so
# it just vanishes and the service crash-loops forever with no sign onscreen.
# s6-setsid forks first and setsid()s *before* exec'ing getty, so getty's own
# internal call is never reached in the state that fails.
NAME=getty
CMD=/usr/bin/s6-setsid
ARGS="/sbin/getty -L 0 tty1"
BACKGROUND=no
. /etc/scraplinux/svc.lib
svc_main "$@"
