#!/bin/sh
# The system message bus. pipewire, bluetoothd and the display managers
# register themselves on it at startup - connecting to a bus that was
# never started is exactly the "failed to initialize dbus" error this
# used to give back.
#
# dbus-daemon --system refuses to start at all without a machine ID at
# /etc/machine-id (or /var/lib/dbus/machine-id) - nothing on Arctic ever
# generated one, so dbus-daemon was exiting immediately on every boot, and
# rc.boot's service loop swallows stderr, so it looked like nothing was
# wrong until whatever needed the bus tried to connect and failed. Generated
# once, on first start, and kept forever after (both on the live image,
# fresh each boot, and on an installed system, where it should never
# change).
NAME=dbus
CMD=/usr/bin/dbus-daemon
ARGS="--system --fork"
BACKGROUND=no
# dbus-daemon writes its own pidfile here (see /usr/share/dbus-1/system.conf's
# <pidfile>), not the /run/dbus.pid svc.lib would otherwise default to.
PIDFILE=/run/dbus/pid
PRESTART="mkdir -p /run/dbus; [ -s /etc/machine-id ] || { command -v dbus-uuidgen >/dev/null 2>&1 && dbus-uuidgen > /etc/machine-id || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' > /etc/machine-id; }"
. /etc/arctic/svc.lib
svc_main "$@"
