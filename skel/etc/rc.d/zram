#!/bin/sh
# Arctic Linux - compressed swap in RAM, sized and compressed per
# /etc/arctic/zram.conf (ZRAM_SIZE, ZRAM_ALGO - written by hand). Composes
# with disk swap rather than replacing it: this is given the higher
# priority, so disk swap only catches whatever does not fit once zram is
# full.
NAME=zram
CONF=/etc/arctic/zram.conf
[ -f "$CONF" ] && . "$CONF"
ZRAM_SIZE=${ZRAM_SIZE:-50%}
ZRAM_ALGO=${ZRAM_ALGO:-zstd}

zram_bytes() {
	case "$ZRAM_SIZE" in
	*%)
		pct=${ZRAM_SIZE%\%}
		kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
		awk -v kb="${kb:-0}" -v p="$pct" 'BEGIN{printf "%.0f", kb*1024*p/100}'
		;;
	*) printf '%s' "$ZRAM_SIZE" ;;
	esac
}

start() {
	modprobe zram num_devices=1 2>/dev/null || :
	[ -b /dev/zram0 ] || { echo "zram: no /dev/zram0 after modprobe" >&2; return 1; }
	echo "$ZRAM_ALGO" >/sys/block/zram0/comp_algorithm 2>/dev/null || :
	zram_bytes >/sys/block/zram0/disksize
	mkswap /dev/zram0 >/dev/null 2>&1
	# Higher priority than any disk swap, so the kernel prefers it first.
	swapon -p 100 /dev/zram0
}

stop() {
	swapoff /dev/zram0 2>/dev/null || :
	echo 1 >/sys/block/zram0/reset 2>/dev/null || :
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
# A oneshot has no process to report, so it is never "running" in the
# usual sense - report by whether the device is actually swapped on.
status) swapon -s 2>/dev/null | grep -q '/dev/zram0' ;;
*) echo "usage: $0 start|stop|restart|status" >&2; exit 2 ;;
esac
