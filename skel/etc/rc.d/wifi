#!/bin/sh
# Arctic Linux - reconnect wireless from network.conf on boot.
#
# wifi-connect writes a saved SSID/PSK to /etc/arctic/network.conf every
# time it associates. This regenerates a real wpa_supplicant config from
# that and brings the link up the same way wifi-connect's own connect()
# does - the same wpa_supplicant + udhcpc pairing, just driven from a
# saved file instead of a prompt. rc.boot starts this backgrounded and
# does not wait on it: the login prompt is never held up by an
# association or a DHCP lease.
NAME=wifi
CTRL_DIR=/run/wpa_supplicant
CONF_LIB=/etc/arctic/conf.lib
NET_CONF=/etc/arctic/network.conf

conf_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

start() {
	[ -f "$CONF_LIB" ] && [ -f "$NET_CONF" ] || return 0
	# shellcheck disable=SC1090
	. "$CONF_LIB"

	ssid=$(conf_get1 "$NET_CONF" wifi.ssid)
	[ -n "$ssid" ] || return 0
	psk=$(conf_get1 "$NET_CONF" wifi.psk)
	iface=$(conf_get1 "$NET_CONF" wifi.iface)
	[ -n "$iface" ] || iface=$(for i in /sys/class/net/*; do
		[ -d "$i/wireless" ] && { printf '%s\n' "${i##*/}"; break; }
	done)
	[ -n "$iface" ] && [ -d "/sys/class/net/$iface" ] || return 0

	# Same reason as wifi-connect's own unblock_rfkill(): a soft-blocked
	# radio still creates its netdev, so this would otherwise look like a
	# clean boot that just never found the network.
	for k in /sys/class/rfkill/rfkill*; do
		[ -d "$k" ] || continue
		[ "$(cat "$k/type" 2>/dev/null)" = wlan ] || continue
		[ "$(cat "$k/soft" 2>/dev/null)" = 1 ] || continue
		echo 0 >"$k/soft" 2>/dev/null || :
	done

	conf="/etc/wpa_supplicant-$iface.conf"
	: >"$conf"; chmod 600 "$conf"
	mkdir -p "$CTRL_DIR" 2>/dev/null
	{
		printf 'ctrl_interface=%s\n' "$CTRL_DIR"
		printf 'ctrl_interface_group=0\n'
		printf 'update_config=1\n'
		printf 'network={\n'
		printf '\tssid="%s"\n' "$(conf_escape "$ssid")"
		if [ -n "$psk" ]; then
			printf '\tpsk="%s"\n' "$(conf_escape "$psk")"
		else
			printf '\tkey_mgmt=NONE\n'
		fi
		printf '}\n'
	} >"$conf"

	ip link set lo up 2>/dev/null
	ip link set "$iface" up 2>/dev/null

	# Same reason as wifi-connect's own connect(): a leftover process from
	# an earlier boot fighting a fresh one over the same nl80211 device
	# fails both.
	pkill -f "wpa_supplicant.*-i *$iface" 2>/dev/null
	sleep 1

	wpa_supplicant -B -i "$iface" -c "$conf" >/dev/null 2>&1

	# wpa_supplicant -B returns the moment it has forked, well before
	# association - the exact same race wifi-connect's own connect()
	# guards against. Give it a real window rather than assuming.
	_n=0
	while [ "$_n" -lt 15 ]; do
		[ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" = 1 ] && break
		_n=$((_n + 1))
		sleep 1
	done
	[ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" = 1 ] || return 0

	udhcpc -b -i "$iface" -p "/run/udhcpc.$iface.pid" \
		-s /usr/share/udhcpc/default.script >/dev/null 2>&1

	# udhcpc -b forks immediately, so without this the service reports
	# success while the interface is still addressless.
	_n=0
	while [ "$_n" -lt 12 ]; do
		ip -4 addr show dev "$iface" 2>/dev/null | grep -q 'inet ' && return 0
		sleep 1
		_n=$((_n + 1))
	done
	return 0
}

stop() {
	pkill -f 'wpa_supplicant -B -i' 2>/dev/null
	for p in /run/udhcpc.*.pid; do
		[ -f "$p" ] && { kill "$(cat "$p")" 2>/dev/null; rm -f "$p"; }
	done
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
status) ip route 2>/dev/null | grep -q '^default' ;;
*) echo "usage: $0 start|stop|restart|status" >&2; exit 2 ;;
esac
