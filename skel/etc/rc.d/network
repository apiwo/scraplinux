#!/bin/sh
# Arctic Linux - bring up wired DHCP on whatever interface comes up.
#
# Live/installer image only. The installed system's networking (DHCP,
# static, wifi) is NetworkManager's job now (see ports/main/networkmanager
# and arctic-install's configure_network()) - arctic-install never enables
# this service, only iso/mkiso does, for the live session itself. This
# stays deliberately dumb: no wifi branch (that's `wifi-connect` on the live
# image), no static branch (the live session has no config to read one
# from) - just "find a wired interface, DHCP it", enough to have working
# network out of the box before you've even looked at install.conf.
NAME=network

pick_iface() {
	for i in /sys/class/net/*; do
		n=$(basename "$i")
		[ "$n" = lo ] && continue
		[ -d "$i/wireless" ] && continue
		echo "$n"; return
	done
}

start() {
	ip link set lo up 2>/dev/null
	iface=$(pick_iface)
	[ -n "$iface" ] || return 0
	ip link set "$iface" up 2>/dev/null
	udhcpc -b -i "$iface" -p "/run/udhcpc.$iface.pid" \
		-s /usr/share/udhcpc/default.script >/dev/null 2>&1
}

stop() {
	for p in /run/udhcpc.*.pid; do
		[ -f "$p" ] && { kill "$(cat "$p")" 2>/dev/null; rm -f "$p"; }
	done
	for i in /sys/class/net/*; do
		n=$(basename "$i"); [ "$n" = lo ] && continue
		ip addr flush dev "$n" 2>/dev/null
	done
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
status) ip route 2>/dev/null | grep -q '^default' ;;
*) echo "usage: $0 start|stop|restart|status" >&2; exit 2 ;;
esac
