#!/bin/sh
# Arctic Linux - bring up wired DHCP on whatever interface comes up.
#
# Live/installer image only. The installed system's networking (DHCP,
# static, wifi) is NetworkManager's job now (see ports/main/networkmanager
# and arctic-install's configure_network()) - arctic-install never enables
# this service, only iso/mkiso does, for the live session itself. This
# stays deliberately dumb: no wifi branch (that's `wifi-connect` on the live
# image), no static branch (the live session has no config to read one
# from) - just "find a wired interface, DHCP it", enough to have working
# network out of the box before you've even looked at install.conf.
NAME=network

pick_iface() {
	for i in /sys/class/net/*; do
		n=$(basename "$i")
		[ "$n" = lo ] && continue
		[ -d "$i/wireless" ] && continue
		echo "$n"; return
	done
}

start() {
	ip link set lo up 2>/dev/null

	# The network card's driver is loaded by the coldplug pass, which runs in
	# the background - so at the moment this service starts, /sys/class/net
	# can still hold nothing but lo. Deciding on the first look meant the live
	# session sometimes came up with no networking at all and nothing to retry
	# it, and the symptom was not "no network": it was every repository
	# reported unreachable and an install that died at the first fetch, which
	# reads as a broken mirror. Wait for an interface to turn up.
	iface=$(pick_iface)
	_n=0
	while [ -z "$iface" ] && [ "$_n" -lt 15 ]; do
		sleep 1
		_n=$((_n + 1))
		iface=$(pick_iface)
	done
	[ -n "$iface" ] || return 0

	ip link set "$iface" up 2>/dev/null
	udhcpc -b -i "$iface" -p "/run/udhcpc.$iface.pid" \
		-s /usr/share/udhcpc/default.script >/dev/null 2>&1

	# udhcpc -b returns as soon as it has forked, so without this the service
	# reports success while the interface is still addressless and anything
	# run immediately after boot - which on the live image means the
	# installer - finds no network. Wait for the lease to actually land.
	_n=0
	while [ "$_n" -lt 12 ]; do
		ip -4 addr show dev "$iface" 2>/dev/null | grep -q 'inet ' && return 0
		sleep 1
		_n=$((_n + 1))
	done
	return 0
}

stop() {
	for p in /run/udhcpc.*.pid; do
		[ -f "$p" ] && { kill "$(cat "$p")" 2>/dev/null; rm -f "$p"; }
	done
	for i in /sys/class/net/*; do
		n=$(basename "$i"); [ "$n" = lo ] && continue
		ip addr flush dev "$n" 2>/dev/null
	done
}

case "${1:-}" in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
status) ip route 2>/dev/null | grep -q '^default' ;;
*) echo "usage: $0 start|stop|restart|status" >&2; exit 2 ;;
esac
