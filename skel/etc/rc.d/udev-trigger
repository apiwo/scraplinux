#!/bin/sh
# ScrapLinux - coldplug: load drivers for hardware already present at boot.
#
# udevd only reacts to *new* uevents. Everything already plugged in when the
# daemon starts - the wifi card, the GPU, the disks - announced itself before
# there was anything listening, so without replaying those events no driver
# for existing hardware is ever loaded. That replay is the coldplug pass.
#
# /etc/rc.boot has always done this, but rc.boot is the busybox-init boot
# script: under s6/66 it never runs, so an s66 system did the whole boot
# without a single coldplug. The visible symptom was wifi - iwlwifi.ko and
# its firmware both present and correct on disk, but never inserted, so
# /sys/class/net held nothing but lo and wifi-connect reported "no wireless
# interface found - is the driver loaded?" - which was exactly the right
# question.
#
# A oneshot, not a supervised daemon: it replays the events, they get
# handled, it is done. Ordered after udevd because there has to be a daemon
# listening for the replay to reach.
NAME=udev-trigger

start() {
	command -v udevadm >/dev/null 2>&1 || return 0
	# Bounded, every step, not just settle: a from-scratch QEMU NVMe boot
	# hung here indefinitely under s6/66 (well past settle's own declared
	# 30s --timeout, and past a second hard `timeout 30` wrapped around
	# settle alone), so the actual hang is in one of the trigger calls
	# talking to a live udevd, not in settle. This is a oneshot the whole
	# rest of the boot tree waits on - it must always return.
	timeout 10 udevadm trigger --action=add --type=subsystems 2>/dev/null
	timeout 10 udevadm trigger --action=add --type=devices 2>/dev/null
	timeout 15 udevadm settle --timeout=10 2>/dev/null
	return 0
}

stop() {
	return 0
}

. /etc/scraplinux/svc.lib
svc_main "$@"
