#!/bin/sh
# NetworkManager - replaces the old rc.d/network + iwd pairing. Drives DHCP,
# static config (from /etc/NetworkManager/system-connections/*.nmconnection,
# written by arctic-install's configure_network()) and wifi (via
# wpa_supplicant) all itself - nothing else needs to bring an interface up.
NAME=NetworkManager
CMD=/usr/bin/NetworkManager
ARGS=""
BACKGROUND=no
PIDFILE=/run/NetworkManager/NetworkManager.pid
PRESTART="mkdir -p /run/NetworkManager /var/lib/NetworkManager; [ -s /etc/machine-id ] || { command -v dbus-uuidgen >/dev/null 2>&1 && dbus-uuidgen > /etc/machine-id || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' > /etc/machine-id; }"
. /etc/arctic/svc.lib
svc_main "$@"
