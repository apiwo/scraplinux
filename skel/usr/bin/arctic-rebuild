#!/bin/sh
# arctic-rebuild - reconcile the installed system to match /etc/arctic/system.conf
#
#   arctic-rebuild             make the system match the config
#   arctic-rebuild --dry-run   show what would change, do nothing
#
# The declarative core of Arctic: system.conf lists everything the machine
# should be - hostname, timezone, locale, keymap, user accounts, packages
# and services - and this makes the real system match it. This is the same
# relationship NixOS's configuration.nix has to `nixos-rebuild switch`, built
# on top of alpm rather than replacing it: every install/removal here is a
# completely ordinary `alpm add`/`alpm rem -d` call, snapshotted the exact
# same way a plain `alpm add` already snapshots itself, and every reconciled
# setting below is a real, individually testable step, not a single opaque
# "apply everything" operation.
#
# If system.conf is empty or missing, the first run does not change
# anything: it seeds every field from what the machine already is, so
# editing from a known-accurate starting point is always possible. Only
# once it has real content does a rebuild reconcile.
#
# What this does NOT do: user accounts are additive only (a declared user
# that does not exist is created; an existing account not declared is left
# alone rather than deleted - see SYS_USERS in system.conf for why). There
# is also no "outputs" concept the way a Nix flake exposes reusable modules
# and packages to other configurations - system.conf describes one machine,
# not a library other machines import from.
# shellcheck shell=sh disable=SC2039

set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

for d in /usr/lib/alpm /usr/lib/arctic/../../alpm ./alpm; do
	[ -f "$d/libalpm.sh" ] && { . "$d/libalpm.sh"; break; }
done

CONF=/etc/arctic/system.conf
LOCKF=/etc/arctic/system.lock
DRYRUN=0
case "${1:-}" in
--dry-run|-n) DRYRUN=1 ;;
-h|--help|help) sed -n '2,20p' "$0" | sed 's/^# \?//'; exit 0 ;;
esac

need_root 2>/dev/null || { echo "Must be run as root." >&2; exit 1; }

if [ -t 1 ]; then
	R=$(printf '\033[0m'); B=$(printf '\033[1m')
	TEAL=$(printf '\033[38;5;44m'); MINT=$(printf '\033[38;5;79m')
	AMB=$(printf '\033[38;5;215m'); GREY=$(printf '\033[38;5;245m')
else
	R= ; B= ; TEAL= ; MINT= ; AMB= ; GREY=
fi
note() { printf '%s::%s %s\n' "$TEAL" "$R" "$*"; }
change() { printf '  %s%s%s %s\n' "$MINT" "$1" "$R" "$2"; }

# The explicitly-installed set (dependencies are managed automatically by
# alpm itself, and should never be listed in system.conf directly).
explicit_pkgs() {
	for d in /var/lib/alpm/local/*/; do
		[ -d "$d" ] || continue
		[ "$(cat "${d}REASON" 2>/dev/null)" = "explicit" ] || continue
		basename "$d"
	done
}

# name<TAB>version-release for every explicit package, for system.lock.
explicit_pkgs_versioned() {
	for d in /var/lib/alpm/local/*/; do
		[ -d "$d" ] || continue
		[ "$(cat "${d}REASON" 2>/dev/null)" = "explicit" ] || continue
		n=$(basename "$d")
		v=$(awk -F' *= *' '$1=="version"{print $2}' "${d}PKGINFO" 2>/dev/null)
		r=$(awk -F' *= *' '$1=="release"{print $2}' "${d}PKGINFO" 2>/dev/null)
		printf '%s\t%s-%s\n' "$n" "${v:-?}" "${r:-1}"
	done | sort
}

enabled_services() {
	for f in /etc/arctic/services/*; do
		[ -e "$f" ] || continue
		basename "$f"
	done
}

in_list() {
	# $1 = needle, rest = haystack words
	needle=$1; shift
	for w in "$@"; do [ "$w" = "$needle" ] && return 0; done
	return 1
}

current_hostname() { cat /etc/hostname 2>/dev/null || hostname 2>/dev/null; }
current_tz() {
	# /etc/localtime is normally a symlink into /usr/share/zoneinfo; the
	# timezone name is just the tail of that path.
	[ -L /etc/localtime ] && readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||'
}
current_locale() { awk -F= '$1=="LANG"{print $2; exit}' /etc/locale.conf 2>/dev/null; }
current_keymap() { awk -F= '$1=="KEYMAP"{print $2; exit}' /etc/vconsole.conf 2>/dev/null; }

SYS_DESCRIPTION=""
SYS_HOSTNAME=""
SYS_TZ=""
SYS_LOCALE=""
SYS_LANG=""
SYS_KEYMAP=""
SYS_USERS=""
SYS_SERVICES=""
SYS_PACKAGES=""
SYS_ALLOW_NONFREE="no"
if [ -f "$CONF" ]; then
	# shellcheck disable=SC1090
	. "$CONF"
fi

cur_pkgs=$(explicit_pkgs)
cur_svcs=$(enabled_services)

# ------------------------------------------------------------------ bootstrap
# Nothing declared yet anywhere - seed every field from what the machine
# already is, instead of reconciling against a mostly-empty file, which for
# packages/services would mean "remove everything" and for identity would
# mean "wipe the hostname". A machine that already went through
# arctic-install has this seeded from the install itself; this path mainly
# covers a machine from before system.conf existed, or a deleted file.
all_empty=1
for v in "$SYS_DESCRIPTION" "$SYS_HOSTNAME" "$SYS_TZ" "$SYS_LOCALE" "$SYS_LANG" \
         "$SYS_KEYMAP" "$SYS_USERS" "$SYS_SERVICES" "$SYS_PACKAGES"; do
	[ -n "$(printf '%s' "$v" | tr -d '[:space:]')" ] && all_empty=0
done

if [ "$all_empty" = 1 ]; then
	note "system.conf has nothing declared yet - seeding it from what the machine already is"
	mkdir -p /etc/arctic
	h=$(current_hostname); tz=$(current_tz); loc=$(current_locale); km=$(current_keymap)
	{
		printf '# Arctic Linux - declarative system configuration\n'
		printf '# Seeded by arctic-rebuild %s from the system as it stood then.\n' "$(date '+%Y-%m-%d %H:%M:%S')"
		printf '# Edit this, then run arctic-rebuild again to apply changes.\n\n'
		printf 'SYS_DESCRIPTION=""\n\n'
		printf 'SYS_HOSTNAME="%s"\n' "$h"
		printf 'SYS_TZ="%s"\n' "$tz"
		printf 'SYS_LOCALE="%s"\n' "$loc"
		printf 'SYS_LANG="%s"\n' "$loc"
		printf 'SYS_KEYMAP="%s"\n\n' "$km"
		printf 'SYS_USERS=""\n\n'
		printf 'SYS_SERVICES="\n'
		for s in $cur_svcs; do printf '\t%s\n' "$s"; done
		printf '"\n\n'
		printf 'SYS_PACKAGES="\n'
		for p in $cur_pkgs; do printf '\t%s\n' "$p"; done
		printf '"\n\n'
		nf=no
		for r in /etc/alpm/repos.d/nonfree.repo /etc/alpm/repos.d/*nonfree*.repo; do
			[ -f "$r" ] || continue
			grep -q '^enabled = yes' "$r" 2>/dev/null && nf=yes
		done
		printf 'SYS_ALLOW_NONFREE="%s"\n' "$nf"
	} >"$CONF"
	printf '  %sWrote %s. Nothing was changed this run.%s\n' "$GREY" "$CONF" "$R"
	exit 0
fi

[ -n "$SYS_DESCRIPTION" ] && note "$SYS_DESCRIPTION"

# ------------------------------------------------------------------- identity
identity_changes=""
[ -n "$SYS_HOSTNAME" ] && [ "$SYS_HOSTNAME" != "$(current_hostname)" ] && \
	identity_changes="$identity_changes hostname"
[ -n "$SYS_TZ" ] && [ "$SYS_TZ" != "$(current_tz)" ] && \
	identity_changes="$identity_changes timezone"
[ -n "$SYS_LOCALE" ] && [ "$SYS_LOCALE" != "$(current_locale)" ] && \
	identity_changes="$identity_changes locale"
[ -n "$SYS_KEYMAP" ] && [ "$SYS_KEYMAP" != "$(current_keymap)" ] && \
	identity_changes="$identity_changes keymap"

# --------------------------------------------------------------- user accounts
users_to_create=""
for u in $SYS_USERS; do
	name=${u%%:*}
	[ -n "$name" ] || continue
	getent passwd "$name" >/dev/null 2>&1 || users_to_create="$users_to_create $u"
done

# ---------------------------------------------------------------- unfree flag
nonfree_change=""
nf_now=no
for r in /etc/alpm/repos.d/*nonfree*.repo; do
	[ -f "$r" ] || continue
	grep -q '^enabled = yes' "$r" 2>/dev/null && nf_now=yes
done
[ "$SYS_ALLOW_NONFREE" != "$nf_now" ] && nonfree_change="$nf_now -> $SYS_ALLOW_NONFREE"

# --------------------------------------------------------------------- packages
to_install=""
for p in $SYS_PACKAGES; do
	in_list "$p" $cur_pkgs || to_install="$to_install $p"
done
to_remove=""
for p in $cur_pkgs; do
	in_list "$p" $SYS_PACKAGES || to_remove="$to_remove $p"
done
svc_enable=""
for s in $SYS_SERVICES; do
	in_list "$s" $cur_svcs || svc_enable="$svc_enable $s"
done
svc_disable=""
for s in $cur_svcs; do
	in_list "$s" $SYS_SERVICES || svc_disable="$svc_disable $s"
done

if [ -z "$to_install$to_remove$svc_enable$svc_disable$identity_changes$users_to_create$nonfree_change" ]; then
	note "already matches $CONF - nothing to do"
	exit 0
fi

note "reconciling against $CONF"
[ -n "$identity_changes" ]  && change "~" "identity:${identity_changes}"
[ -n "$users_to_create" ]   && change "+" "create users:${users_to_create}"
[ -n "$nonfree_change" ]    && change "~" "nonfree repos: $nonfree_change"
[ -n "$to_install" ]        && change "+" "install:${to_install}"
[ -n "$to_remove" ]         && change "-" "remove: ${to_remove}"
[ -n "$svc_enable" ]        && change "+" "enable services: ${svc_enable}"
[ -n "$svc_disable" ]       && change "-" "disable services:${svc_disable}"

[ "$DRYRUN" = 1 ] && { printf '  %s(dry run - nothing changed)%s\n' "$GREY" "$R"; exit 0; }

command -v arctic-snapshot >/dev/null 2>&1 && arctic-snapshot create "arctic-rebuild" >/dev/null 2>&1

# Record where the system is *before* changing it, so this rebuild is
# escapable. arctic-generation switch puts system.conf back and reconciles;
# the bootloader lists the recent ones so even a rebuild that will not boot
# can be backed out of from the boot menu.
#
# Skipped when we are already inside a switch, or the rollback itself would
# create a generation on every hop.
if [ "${ARCTIC_GEN_SWITCH:-0}" != 1 ] && command -v arctic-generation >/dev/null 2>&1; then
	gen=$(arctic-generation create "before rebuild" 2>/dev/null)
	[ -n "$gen" ] && note "recorded generation $gen"
fi

rc=0

# Identity, first - cheap, local, and nothing else here depends on it
# succeeding or failing.
if [ -n "$SYS_HOSTNAME" ] && [ "$SYS_HOSTNAME" != "$(current_hostname)" ]; then
	printf '%s\n' "$SYS_HOSTNAME" >/etc/hostname
	hostname "$SYS_HOSTNAME" 2>/dev/null || :
fi
if [ -n "$SYS_TZ" ] && [ "$SYS_TZ" != "$(current_tz)" ]; then
	if [ -e "/usr/share/zoneinfo/$SYS_TZ" ]; then
		ln -sf "/usr/share/zoneinfo/$SYS_TZ" /etc/localtime
	else
		printf '  %sSYS_TZ=%s not found under /usr/share/zoneinfo - skipped%s\n' "$AMB" "$SYS_TZ" "$R" >&2
		rc=1
	fi
fi
if [ -n "$SYS_LOCALE" ] && [ "$SYS_LOCALE" != "$(current_locale)" ]; then
	{
		printf 'LANG=%s\n' "$SYS_LOCALE"
		[ -n "$SYS_LANG" ] && [ "$SYS_LANG" != "$SYS_LOCALE" ] && printf 'LC_ALL=%s\n' "$SYS_LANG"
	} >/etc/locale.conf
fi
if [ -n "$SYS_KEYMAP" ] && [ "$SYS_KEYMAP" != "$(current_keymap)" ]; then
	printf 'KEYMAP=%s\n' "$SYS_KEYMAP" >/etc/vconsole.conf
	loadkmap </usr/share/keymaps/"$SYS_KEYMAP".bmap 2>/dev/null || :
fi

# Users - additive only. See system.conf's own comment on SYS_USERS for why
# an account not listed here is never removed automatically.
for u in $users_to_create; do
	name=${u%%:*}
	rest=${u#*:}
	sh_=${rest%%:*}
	grps=${rest#*:}
	[ "$grps" = "$rest" ] && grps=""
	sh_=${sh_:-/bin/sh}
	add_args="-D -s $sh_ -h /home/$name"
	[ -n "$grps" ] && add_args="$add_args -G ${grps%%,*}"
	# shellcheck disable=SC2086
	adduser $add_args "$name" 2>/dev/null || { rc=1; continue; }
	if [ -n "$grps" ]; then
		OIFS=$IFS; IFS=,
		for g in $grps; do addgroup "$name" "$g" 2>/dev/null || :; done
		IFS=$OIFS
	fi
done

# The nonfree/alt-nonfree repos - toggled, not installed or removed from.
# Turning this off does not uninstall anything already pulled from them;
# it only stops new installs from reaching those repos.
if [ -n "$nonfree_change" ]; then
	for r in /etc/alpm/repos.d/*nonfree*.repo; do
		[ -f "$r" ] || continue
		if [ "$SYS_ALLOW_NONFREE" = yes ]; then
			sed -i 's/^enabled = no/enabled = yes/' "$r"
		else
			sed -i 's/^enabled = yes/enabled = no/' "$r"
		fi
	done
fi

if [ -n "$to_install" ]; then
	# shellcheck disable=SC2086
	ALPM_YES=1 alpm add $to_install || rc=1
fi
if [ -n "$to_remove" ]; then
	# del+deps also drops now-orphaned dependencies; alpm's own
	# ALPM_NEVER_REMOVE list still protects the base system regardless of
	# what system.conf says.
	# shellcheck disable=SC2086
	ALPM_YES=1 alpm rem -d $to_remove || rc=1
fi
for s in $svc_enable;  do service enable  "$s" >/dev/null 2>&1 || rc=1; done
for s in $svc_disable; do service disable "$s" >/dev/null 2>&1 || rc=1; done

if [ "$rc" = 0 ]; then
	# The system now matches the config, so record that as the generation
	# the machine is actually on and refresh the boot menu.
	if [ "${ARCTIC_GEN_SWITCH:-0}" != 1 ] && command -v arctic-generation >/dev/null 2>&1; then
		gen=$(arctic-generation create "rebuild" 2>/dev/null)
		[ -n "$gen" ] && note "now on generation $gen"
	fi
	command -v arctic-boot-generations >/dev/null 2>&1 && \
		arctic-boot-generations >/dev/null 2>&1 || :

	# Services are declared once and translated per init, so a rebuild that
	# changed the enabled set has to regenerate them for whatever init this
	# machine actually runs.
	if [ -n "$svc_enable$svc_disable" ] && [ -f /etc/arctic/init ]; then
		myinit=$(cat /etc/arctic/init 2>/dev/null)
		if [ -n "$myinit" ] && [ "$myinit" != busybox ] && \
		   command -v arctic-init-setup >/dev/null 2>&1; then
			arctic-init-setup "$myinit" >/dev/null 2>&1 && \
				note "$myinit service definitions regenerated"
		fi
	fi

	# The lock file: exactly what version of everything explicit is on the
	# machine right now, the same reason a flake.lock exists next to a
	# flake.nix. Nothing reads this back automatically on the next rebuild
	# yet - it is a record of what was actually applied, not (yet) a pin
	# enforced against repository drift.
	{
		printf '# Arctic Linux - package lock\n'
		printf '# Written by arctic-rebuild %s. Not hand-edited; read %s instead.\n\n' \
			"$(date '+%Y-%m-%d %H:%M:%S')" "$CONF"
		explicit_pkgs_versioned
	} >"$LOCKF" 2>/dev/null || :

	note "rebuild complete"
else
	printf '  %ssome changes failed - see above%s\n' "$AMB" "$R" >&2
fi
exit "$rc"
