#!/bin/sh
# wifi-connect - bring up WPA2-Personal wireless on the live/installer image.
#
# NetworkManager + nmtui is the installed system's real wireless story (see
# ports/main/networkmanager), but that is a much bigger dependency tree than
# the live bootstrap stage builds - wpa_supplicant alone is enough to get an
# install-time link up.
#
#   wifi-connect                        pick an interface and a network
#   wifi-connect <ssid> <psk> [iface]   connect without being asked anything
#   wifi-connect scan [iface]           scan and show what is in range
#   wifi-connect list-networks [iface]  the same list, names only
#
# Run with no arguments it asks: which interface, which network, and the
# passphrase - which is echoed as asterisks rather than not at all, so it is
# possible to see that a key press registered. Typing an SSID exactly right
# from memory, on a machine with no other network, was the previous way in.
#
# Enterprise/802.1X networks are not supported here - wpa_supplicant is built
# WPA2-Personal only on the live image, with no TLS backend. Use a wired
# connection or a phone hotspot for those and set 802.1X up properly after
# install, through NetworkManager.
# shellcheck shell=sh disable=SC2039
set -u

TEAL='' MINT='' RED='' GREY='' BOLD='' R=''
if [ -t 1 ]; then
	TEAL=$(printf '\033[38;5;44m'); MINT=$(printf '\033[38;5;49m')
	RED=$(printf '\033[38;5;203m'); GREY=$(printf '\033[38;5;245m')
	BOLD=$(printf '\033[1m');       R=$(printf '\033[0m')
fi
say()  { printf '%s::%s %s\n' "$TEAL$BOLD" "$R" "$*"; }
ok()   { printf '  %s✓%s  %s\n' "$MINT$BOLD" "$R" "$*"; }
oops() { printf '%s!!%s %s\n' "$RED$BOLD" "$R" "$*" >&2; }

wireless_ifaces() {
	for i in /sys/class/net/*; do
		[ -d "$i/wireless" ] || continue
		printf '%s\n' "${i##*/}"
	done
}

check_iface() {
	case "$1" in */*) oops "bad interface name: $1"; exit 1 ;; esac
	[ -d "/sys/class/net/$1" ] || { oops "no such interface: $1"; exit 1; }
	[ -d "/sys/class/net/$1/wireless" ] || { oops "$1 is not a wireless interface"; exit 1; }
}

# A scan takes a few seconds and says nothing while it runs, which reads as a
# hang on a machine that has just booted and has no other sign of life.
scan_with_spinner() {
	_if=$1 _out=$2
	ip link set "$_if" up 2>/dev/null
	iw dev "$_if" scan >"$_out" 2>/dev/null &
	_pid=$!
	printf '%s::%s scanning on %s ' "$TEAL$BOLD" "$R" "$_if"
	while kill -0 "$_pid" 2>/dev/null; do
		printf '.'
		sleep 1
	done
	wait "$_pid" 2>/dev/null
	printf '\n'
}

# SSID<tab>signal<tab>security, strongest first.
parse_scan() {
	awk '
		/^BSS /     { if (ssid != "") print ssid "\t" sig "\t" sec; sig=""; ssid=""; sec="open" }
		/signal:/   { sig=$2 }
		/^[ \t]*SSID: / { sub(/^[ \t]*SSID: /, ""); ssid=$0 }
		/RSN:|WPA:/ { sec="wpa" }
		END         { if (ssid != "") print ssid "\t" sig "\t" sec }
	' "$1" | awk -F'\t' '$1 != "" { print }' | sort -t"$(printf '\t')" -k2 -rn | awk -F'\t' '
		!seen[$1]++ { print }'
}

# Echo asterisks rather than nothing. Read a byte at a time: busybox ash has
# no `read -s`, and turning the echo off entirely leaves no sign that a key
# press registered at all - which on a passphrase people type wrong is the
# difference between retrying and assuming the keyboard is dead.
read_password() {
	_p=''
	stty -echo -icanon min 1 time 0 2>/dev/null || stty -echo 2>/dev/null
	while :; do
		_b=$(dd bs=1 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n')
		[ -n "$_b" ] || break
		case "$_b" in
		10|13) break ;;
		127|8)
			if [ -n "$_p" ]; then
				_p=${_p%?}
				printf '\b \b'
			fi ;;
		3) stty echo icanon 2>/dev/null; printf '\n'; exit 130 ;;
		*)
			_p="$_p$(printf "\\$(printf '%03o' "$_b")")"
			printf '*' ;;
		esac
	done
	stty echo icanon 2>/dev/null || stty echo 2>/dev/null
	printf '\n'
	PASSWORD=$_p
}

connect() {
	_ssid=$1 _psk=$2 _if=$3
	command -v wpa_supplicant >/dev/null 2>&1 || { oops "wpa_supplicant not found"; exit 1; }

	conf="/etc/wpa_supplicant-$_if.conf"
	# World-unreadable *before* the PSK is written to it - a plain ">"
	# creates the file with the umask's mode first, which leaves the
	# passphrase readable for the window before a later chmod.
	: >"$conf"
	chmod 600 "$conf"
	if [ -z "$_psk" ]; then
		{
			printf 'network={\n'
			printf '\tssid="%s"\n' "$_ssid"
			printf '\tkey_mgmt=NONE\n'
			printf '}\n'
		} >"$conf"
	else
		# Over stdin, not argv: wpa_passphrase would otherwise put the
		# passphrase in its own command line, readable from /proc while
		# it runs.
		printf '%s\n' "$_psk" | wpa_passphrase "$_ssid" >"$conf" 2>/dev/null
	fi

	# Replace any previous run for this interface rather than stacking a
	# second wpa_supplicant fighting the first over the same nl80211 device.
	pkill -f "wpa_supplicant .*-i$_if" 2>/dev/null
	sleep 1

	ip link set "$_if" up 2>/dev/null
	say "associating with $_ssid"
	if ! wpa_supplicant -B -i "$_if" -c "$conf" >/dev/null 2>&1; then
		oops "wpa_supplicant could not associate with $_ssid on $_if"
		exit 1
	fi
	# wpa_supplicant -B returns as soon as it has forked, which is before it
	# has associated and long before the four-way handshake has finished. Ask
	# for a lease at that moment and it goes out of an interface still
	# reporting NO-CARRIER, fails, and reads as a network fault - the
	# passphrase was fine and the association did complete, a second later.
	say "waiting for the link"
	_n=0
	while [ "$_n" -lt 30 ]; do
		if [ "$(cat "/sys/class/net/$_if/carrier" 2>/dev/null)" = 1 ]; then
			break
		fi
		# wpa_cli is the authority when it is there: carrier can lag the
		# handshake on some drivers.
		if command -v wpa_cli >/dev/null 2>&1 && \
		   wpa_cli -i "$_if" status 2>/dev/null | grep -q '^wpa_state=COMPLETED'; then
			break
		fi
		sleep 1
		_n=$((_n + 1))
	done
	if [ "$(cat "/sys/class/net/$_if/carrier" 2>/dev/null)" != 1 ] && \
	   ! { command -v wpa_cli >/dev/null 2>&1 && \
	       wpa_cli -i "$_if" status 2>/dev/null | grep -q '^wpa_state=COMPLETED'; }; then
		oops "$_ssid did not come up after ${_n}s - the passphrase is the usual reason"
		printf '     %swpa_cli -i %s status%s says what it is actually doing\n' \
			"$GREY" "$_if" "$R"
		exit 1
	fi
	ok "associated"

	say "requesting an address"
	# One attempt used to be the whole story. A lease can take longer than
	# udhcpc's own default patience on a busy access point.
	_got=0
	for _try in 1 2 3; do
		if udhcpc -i "$_if" -n -q -t 5 -T 3 >/dev/null 2>&1; then _got=1; break; fi
		[ "$_try" = 3 ] || say "no lease yet - asking again"
	done
	if [ "$_got" = 1 ]; then
		addr=$(ip -4 addr show "$_if" 2>/dev/null | \
			awk '/inet /{print $2; exit}')
		gw=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
		ok "address   ${addr:-unknown}"
		[ -n "$gw" ] && ok "gateway   $gw"
		ns=$(awk '/^nameserver/{printf "%s ", $2}' /etc/resolv.conf 2>/dev/null)
		[ -n "$ns" ] && ok "resolver  $ns"
		printf '\n  %sReady. Edit /etc/arctic/install.conf, then run arctic-install.%s\n' \
			"$GREY" "$R"
	else
		oops "associated, but DHCP failed - check 'ip addr' and the network"
		exit 1
	fi
}

interactive() {
	command -v iw >/dev/null 2>&1 || { oops "iw is not installed - cannot scan (alpm add iw)"; exit 1; }

	# 1. the interface
	ifaces=$(wireless_ifaces)
	[ -n "$ifaces" ] || { oops "no wireless interface found - is the driver loaded? (iwlwifi, ath9k, ...)"; exit 1; }
	n=$(printf '%s\n' "$ifaces" | wc -l | tr -d ' ')
	if [ "$n" = 1 ]; then
		iface=$ifaces
		say "interface $iface"
	else
		say "wireless interfaces"
		i=0
		printf '%s\n' "$ifaces" | while read -r w; do
			i=$((i+1)); printf '  %s%s)%s %s\n' "$BOLD" "$i" "$R" "$w"
		done
		printf '\n  choose [1]: '
		read -r pick
		[ -n "$pick" ] || pick=1
		iface=$(printf '%s\n' "$ifaces" | sed -n "${pick}p")
		[ -n "$iface" ] || { oops "no interface number $pick"; exit 1; }
	fi
	check_iface "$iface"

	# 2. what is in range
	tmp=/tmp/.wifi-scan.$$
	scan_with_spinner "$iface" "$tmp"
	nets=$(parse_scan "$tmp")
	rm -f "$tmp"
	[ -n "$nets" ] || { oops "no networks found - move closer, or check the antenna"; exit 1; }

	printf '\n  %s%-32s %-8s %s%s\n' "$GREY" "NETWORK" "SIGNAL" "SECURITY" "$R"
	i=0
	printf '%s\n' "$nets" | while IFS="$(printf '\t')" read -r s sig sec; do
		i=$((i+1))
		printf '  %s%2s)%s %-32s %-8s %s\n' "$BOLD" "$i" "$R" "$s" "${sig:--}" "$sec"
	done
	printf '\n  choose a network: '
	read -r pick
	line=$(printf '%s\n' "$nets" | sed -n "${pick}p")
	[ -n "$line" ] || { oops "no network number $pick"; exit 1; }
	ssid=$(printf '%s' "$line" | cut -f1)
	sec=$(printf '%s' "$line" | cut -f3)

	# 3. the passphrase
	PASSWORD=''
	if [ "$sec" = open ]; then
		say "$ssid is open - no passphrase needed"
	else
		printf '  passphrase for %s%s%s: ' "$BOLD" "$ssid" "$R"
		read_password
	fi

	connect "$ssid" "$PASSWORD" "$iface"
}

mode=connect
case "${1:-}" in
'')            interactive; exit $? ;;
scan)          mode=scan;  iface=${2:-} ;;
list-networks) mode=list;  iface=${2:-} ;;
-h|--help)     sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 0 ;;
*)             ssid=${1:-}; psk=${2:-}; iface=${3:-} ;;
esac

if [ "$mode" = connect ] && { [ -z "${ssid:-}" ] || [ -z "${psk:-}" ]; }; then
	cat >&2 <<'USAGE'
usage: wifi-connect                        pick an interface and a network
       wifi-connect <ssid> <psk> [iface]
       wifi-connect scan [iface]
       wifi-connect list-networks [iface]
USAGE
	exit 1
fi

if [ -z "$iface" ]; then
	iface=$(wireless_ifaces | head -1)
fi
[ -n "$iface" ] || { oops "no wireless interface found - is the driver loaded? (iwlwifi, ath9k, ...)"; exit 1; }
check_iface "$iface"

if [ "$mode" = scan ] || [ "$mode" = list ]; then
	command -v iw >/dev/null 2>&1 || { oops "iw is not installed - cannot scan (alpm add iw)"; exit 1; }
	tmp=/tmp/.wifi-scan.$$
	scan_with_spinner "$iface" "$tmp"
	if [ "$mode" = list ]; then
		parse_scan "$tmp" | cut -f1
	else
		printf '%-32s %-8s %s\n' "NETWORK" "SIGNAL" "SECURITY"
		parse_scan "$tmp" | while IFS="$(printf '\t')" read -r s sig sec; do
			printf '%-32s %-8s %s\n' "$s" "${sig:--}" "$sec"
		done
	fi
	rm -f "$tmp"
	exit 0
fi

connect "$ssid" "$psk" "$iface"
