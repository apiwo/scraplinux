#!/bin/sh
# wifi-connect - bring up WPA2-Personal wireless on the live/installer image.
#
# NetworkManager + nmtui is the installed system's real wireless story (see
# ports/main/networkmanager), but that is a much bigger dependency tree than
# the live bootstrap stage builds - wpa_supplicant alone is enough to get an
# install-time link up.
#
#   wifi-connect                        pick an interface and a network
#   wifi-connect <ssid> <psk> [iface]   connect without being asked anything
#   wifi-connect scan [iface]           scan and show what is in range
#   wifi-connect list-networks [iface]  the same list, names only
#
# Run with no arguments it asks: which interface, which network, and the
# passphrase - which is echoed as asterisks rather than not at all, so it is
# possible to see that a key press registered. Typing an SSID exactly right
# from memory, on a machine with no other network, was the previous way in.
#
# Enterprise/802.1X networks are not supported here - wpa_supplicant is built
# WPA2-Personal only on the live image, with no TLS backend. Use a wired
# connection or a phone hotspot for those and set 802.1X up properly after
# install, through NetworkManager.
# shellcheck shell=sh disable=SC2039
set -u

TEAL='' MINT='' RED='' GREY='' BOLD='' R=''
if [ -t 1 ]; then
	TEAL=$(printf '\033[38;5;44m'); MINT=$(printf '\033[38;5;49m')
	RED=$(printf '\033[38;5;203m'); GREY=$(printf '\033[38;5;245m')
	BOLD=$(printf '\033[1m');       R=$(printf '\033[0m')
fi
say()  { printf '%s::%s %s\n' "$TEAL$BOLD" "$R" "$*"; }
ok()   { printf '  %s✓%s  %s\n' "$MINT$BOLD" "$R" "$*"; }
oops() { printf '%s!!%s %s\n' "$RED$BOLD" "$R" "$*" >&2; }

# Where wpa_supplicant opens its control socket, and where wpa_cli looks for
# it by default. Kept in one place so the two can never disagree.
CTRL_DIR=/run/wpa_supplicant

# A double quote or a backslash in an SSID or a passphrase ends the quoted
# string early in wpa_supplicant's config format, so both are escaped. Neither
# is common and both are legal, and a passphrase silently truncated at a
# backslash fails to associate with nothing to show why.
conf_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# 5 GHz is why a scan can show a network the card then refuses to talk to.
#
# With no regulatory database the kernel falls back to world domain "00", in
# which almost every 5 GHz channel is marked no-IR: the card may listen, so the
# access point turns up in a scan, and it may not transmit, so association
# never starts. It looks exactly like a wrong passphrase from the outside.
#
# The database is a firmware file the kernel loads on its own. If it is not
# installed there is nothing to set, and saying so is more use than a 30-second
# timeout.
check_regdomain() {
	command -v iw >/dev/null 2>&1 || return 0
	_reg=$(iw reg get 2>/dev/null | awk -F': ' '/^country/{print $1; exit}' | awk '{print $2}')
	case "${_reg:-00}" in
	00|'')
		if [ -e /usr/lib/firmware/regulatory.db ] || [ -e /lib/firmware/regulatory.db ]; then
			# There is a database and the domain is still world, which
			# means nothing has selected a country yet.
			if [ -n "${WIFI_COUNTRY:-}" ]; then
				# iw wants the alpha-2 code in capitals and rejects
				# anything else outright with "not a valid ISO/IEC
				# 3166-1 alpha2" - so WIFI_COUNTRY=us failed and,
				# with the error discarded, failed silently.
				_cc=$(printf '%s' "$WIFI_COUNTRY" | tr '[:lower:]' '[:upper:]')
				if iw reg set "$_cc" 2>/dev/null; then
					say "regulatory domain $_cc"
				else
					oops "iw rejected the country code '$WIFI_COUNTRY'"
				fi
				sleep 1
			else
				printf '     %sregulatory domain is 00 (world) - 5 GHz may not associate.\n' "$GREY"
				printf '     set one with: WIFI_COUNTRY=US wifi-connect%s\n' "$R"
			fi
		else
			printf '     %sno regulatory database installed - 5 GHz may not associate.\n' "$GREY"
			printf '     alpm add wireless-regdb, or use the 2.4 GHz network%s\n' "$R"
		fi
		;;
	esac
}

wireless_ifaces() {
	for i in /sys/class/net/*; do
		[ -d "$i/wireless" ] || continue
		printf '%s\n' "${i##*/}"
	done
}

check_iface() {
	case "$1" in */*) oops "bad interface name: $1"; exit 1 ;; esac
	[ -d "/sys/class/net/$1" ] || { oops "no such interface: $1"; exit 1; }
	[ -d "/sys/class/net/$1/wireless" ] || { oops "$1 is not a wireless interface"; exit 1; }
}

# A scan takes a few seconds and says nothing while it runs, which reads as a
# hang on a machine that has just booted and has no other sign of life.
scan_with_spinner() {
	_if=$1 _out=$2
	ip link set "$_if" up 2>/dev/null
	iw dev "$_if" scan >"$_out" 2>/dev/null &
	_pid=$!
	printf '%s::%s scanning on %s ' "$TEAL$BOLD" "$R" "$_if"
	while kill -0 "$_pid" 2>/dev/null; do
		printf '.'
		sleep 1
	done
	wait "$_pid" 2>/dev/null
	printf '\n'
}

# SSID<tab>signal<tab>security, strongest first.
parse_scan() {
	awk '
		/^BSS /     { if (ssid != "") print ssid "\t" sig "\t" sec; sig=""; ssid=""; sec="open" }
		/signal:/   { sig=$2 }
		/^[ \t]*SSID: / { sub(/^[ \t]*SSID: /, ""); ssid=$0 }
		/RSN:|WPA:/ { sec="wpa" }
		END         { if (ssid != "") print ssid "\t" sig "\t" sec }
	' "$1" | awk -F'\t' '$1 != "" { print }' | sort -t"$(printf '\t')" -k2 -rn | awk -F'\t' '
		!seen[$1]++ { print }'
}

# Echo asterisks rather than nothing. Read a byte at a time: busybox ash has
# no `read -s`, and turning the echo off entirely leaves no sign that a key
# press registered at all - which on a passphrase people type wrong is the
# difference between retrying and assuming the keyboard is dead.
read_password() {
	_p=''
	stty -echo -icanon min 1 time 0 2>/dev/null || stty -echo 2>/dev/null
	while :; do
		_b=$(dd bs=1 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n')
		[ -n "$_b" ] || break
		case "$_b" in
		10|13) break ;;
		127|8)
			if [ -n "$_p" ]; then
				_p=${_p%?}
				printf '\b \b'
			fi ;;
		3) stty echo icanon 2>/dev/null; printf '\n'; exit 130 ;;
		*)
			_p="$_p$(printf "\\$(printf '%03o' "$_b")")"
			printf '*' ;;
		esac
	done
	stty echo icanon 2>/dev/null || stty echo 2>/dev/null
	printf '\n'
	PASSWORD=$_p
}

connect() {
	_ssid=$1 _psk=$2 _if=$3
	command -v wpa_supplicant >/dev/null 2>&1 || { oops "wpa_supplicant not found"; exit 1; }

	conf="/etc/wpa_supplicant-$_if.conf"
	# World-unreadable *before* the PSK is written to it - a plain ">"
	# creates the file with the umask's mode first, which leaves the
	# passphrase readable for the window before a later chmod.
	: >"$conf"
	chmod 600 "$conf"
	# wpa_passphrase writes a network block and nothing else - no
	# ctrl_interface line. Without one wpa_supplicant opens no control
	# socket at all, so every wpa_cli in here failed with "Could not connect
	# to wpa_supplicant: wlan0", the status check in the wait loop below
	# silently answered "not connected" on every pass, and the one command
	# the error message tells you to run could not work either. The header
	# goes in first and the network block is appended to it.
	mkdir -p "$CTRL_DIR" 2>/dev/null
	{
		printf 'ctrl_interface=%s\n' "$CTRL_DIR"
		printf 'ctrl_interface_group=0\n'
		printf 'update_config=1\n'
	} >"$conf"
	if [ -z "$_psk" ]; then
		{
			printf 'network={\n'
			printf '\tssid="%s"\n' "$(conf_escape "$_ssid")"
			printf '\tkey_mgmt=NONE\n'
			printf '}\n'
		} >>"$conf"
	else
		# The network block is written here rather than by wpa_passphrase.
		#
		# wpa_passphrase turns the terminal's echo off before it reads, so
		# it calls tcgetattr on its stdin - and when stdin is a pipe, which
		# is the only way to hand it a passphrase without putting it in
		# argv for every process on the machine to read, tcgetattr fails
		# with ENOTTY and it exits 1 having written nothing at all. Its
		# stderr went to /dev/null and its exit status was not checked, so
		# the config ended up with a ctrl_interface header and no network
		# in it. wpa_supplicant then started perfectly, associated with
		# nothing, and the wait loop timed out at 30s blaming the
		# passphrase. That is the whole of "wifi does not work".
		#
		# There is nothing to lose by not using it: wpa_supplicant derives
		# the PSK from a quoted passphrase itself, and wpa_passphrase's own
		# output carries the plaintext in a #psk= comment beside the hash
		# anyway. The file is 0600 either way.
		{
			printf 'network={\n'
			printf '\tssid="%s"\n' "$(conf_escape "$_ssid")"
			printf '\tpsk="%s"\n' "$(conf_escape "$_psk")"
			printf '}\n'
		} >>"$conf"
	fi
	# Nothing below can work if the block above did not land.
	if ! grep -q '^network=' "$conf"; then
		oops "could not write a network block to $conf"
		exit 1
	fi

	# Replace any previous run for this interface rather than stacking a
	# second wpa_supplicant fighting the first over the same nl80211 device.
	# The pattern has to match the command line actually used: "-i wlan0" is
	# written with a space, and "-i$_if" only ever matched the joined spelling
	# this script does not use, so the old process was never killed.
	pkill -f "wpa_supplicant.*-i *$_if" 2>/dev/null
	sleep 1

	ip link set "$_if" up 2>/dev/null
	check_regdomain "$_ssid"
	say "associating with $_ssid"
	# Not /dev/null. When association fails this log is the only account of
	# why - "did not come up after 30s" on its own sends you looking at the
	# passphrase when the driver may have refused the channel outright.
	mkdir -p /run/arctic 2>/dev/null
	_wpalog="/run/arctic/wpa_supplicant-$_if.log"
	# Truncated per attempt, then appended to by both -f and the redirect, so
	# what it holds is this attempt and not the last one as well.
	: >"$_wpalog" 2>/dev/null
	# No -f. It looks like the obvious way to get a log out of a daemon that
	# has already forked, and Arctic's wpa_supplicant does not have it:
	# -f is compiled in by CONFIG_DEBUG_FILE and this build does not set it.
	# An unknown option makes wpa_supplicant print its usage and exit without
	# ever starting, so the "log" this then showed was that usage text and the
	# radio was never touched at all. Redirection does the same job and cannot
	# be refused. Checked against the wpa_supplicant Arctic ships, not the
	# one on the build host - the host's is built with CONFIG_DEBUG_FILE and
	# accepts -f perfectly, which is exactly how this got shipped.
	wpa_supplicant -B -i "$_if" -c "$conf" >>"$_wpalog" 2>&1
	# Not the exit status. -B forks, and a supplicant that dies immediately
	# afterwards still leaves a 0 behind; one that refuses an option prints
	# usage and can exit 0 too. Ask whether the thing is actually running.
	_n=0
	while [ "$_n" -lt 5 ]; do
		[ -e "$CTRL_DIR/$_if" ] && break
		pgrep -f "wpa_supplicant.*$_if" >/dev/null 2>&1 && break
		sleep 1
		_n=$((_n + 1))
	done
	if [ ! -e "$CTRL_DIR/$_if" ] && ! pgrep -f "wpa_supplicant.*$_if" >/dev/null 2>&1; then
		oops "wpa_supplicant did not start on $_if"
		[ -s "$_wpalog" ] && tail -n 12 "$_wpalog" | sed 's/^/     /' >&2
		exit 1
	fi
	# wpa_supplicant -B returns as soon as it has forked, which is before it
	# has associated and long before the four-way handshake has finished. Ask
	# for a lease at that moment and it goes out of an interface still
	# reporting NO-CARRIER, fails, and reads as a network fault - the
	# passphrase was fine and the association did complete, a second later.
	say "waiting for the link"
	_n=0
	while [ "$_n" -lt 30 ]; do
		if [ "$(cat "/sys/class/net/$_if/carrier" 2>/dev/null)" = 1 ]; then
			break
		fi
		# wpa_cli is the authority when it is there: carrier can lag the
		# handshake on some drivers.
		if command -v wpa_cli >/dev/null 2>&1 && \
		   wpa_cli -i "$_if" status 2>/dev/null | grep -q '^wpa_state=COMPLETED'; then
			break
		fi
		sleep 1
		_n=$((_n + 1))
	done
	if [ "$(cat "/sys/class/net/$_if/carrier" 2>/dev/null)" != 1 ] && \
	   ! { command -v wpa_cli >/dev/null 2>&1 && \
	       wpa_cli -i "$_if" status 2>/dev/null | grep -q '^wpa_state=COMPLETED'; }; then
		oops "$_ssid did not come up after ${_n}s"
		# Print the state rather than naming a command to go and run. The
		# suggestion used to be "wpa_cli -i wlan0 status", which could not
		# work at all while no control socket was being opened.
		_st=$(wpa_cli -i "$_if" status 2>/dev/null | \
			awk -F= '/^wpa_state=|^ssid=|^bssid=|^freq=/{print "     " $0}')
		if [ -n "$_st" ]; then
			printf '%s%s%s\n' "$GREY" "$_st" "$R"
		else
			printf '     %sno control socket - wpa_supplicant is not running%s\n' "$GREY" "$R"
		fi
		if [ -s "$_wpalog" ]; then
			printf '     %slast lines of %s:%s\n' "$GREY" "$_wpalog" "$R"
			tail -n 8 "$_wpalog" 2>/dev/null | sed "s/^/       $GREY/;s/\$/$R/"
		fi
		printf '     %sa wrong passphrase, or a 5 GHz channel the regulatory\n' "$GREY"
		printf '     domain forbids, are the two usual causes.%s\n' "$R"
		exit 1
	fi
	ok "associated"

	say "requesting an address"
	# One attempt used to be the whole story. A lease can take longer than
	# udhcpc's own default patience on a busy access point.
	# -s explicitly. busybox's compiled-in default is this same path and it is
	# on the image, so leaving it off worked - but a lease that is obtained
	# and never applied looks exactly like no lease at all, and that is not a
	# thing worth leaving to a compiled-in default. rc.d/network already names
	# it; these two now agree.
	_dhcpscript=/usr/share/udhcpc/default.script
	_dhcplog=/run/arctic/udhcpc-$_if.log
	: >"$_dhcplog" 2>/dev/null
	_got=0
	for _try in 1 2 3; do
		if udhcpc -i "$_if" -n -q -t 5 -T 3 \
			${_dhcpscript:+-s "$_dhcpscript"} >>"$_dhcplog" 2>&1; then
			_got=1; break
		fi
		[ "$_try" = 3 ] || say "no lease yet - asking again"
	done
	if [ "$_got" = 1 ]; then
		addr=$(ip -4 addr show "$_if" 2>/dev/null | \
			awk '/inet /{print $2; exit}')
		gw=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
		ok "address   ${addr:-unknown}"
		[ -n "$gw" ] && ok "gateway   $gw"
		ns=$(awk '/^nameserver/{printf "%s ", $2}' /etc/resolv.conf 2>/dev/null)
		[ -n "$ns" ] && ok "resolver  $ns"
		printf '\n  %sReady. Edit /etc/arctic/install.conf, then run arctic-install.%s\n' \
			"$GREY" "$R"
	else
		oops "associated, but DHCP failed"
		[ -s "$_dhcplog" ] && tail -n 8 "$_dhcplog" | sed 's/^/     /' >&2
		printf '     %sthe link is up - this is the address, not the wireless.%s\n' "$GREY" "$R"
		exit 1
	fi
}

interactive() {
	command -v iw >/dev/null 2>&1 || { oops "iw is not installed - cannot scan (alpm add iw)"; exit 1; }

	# 1. the interface
	ifaces=$(wireless_ifaces)
	[ -n "$ifaces" ] || { oops "no wireless interface found - is the driver loaded? (iwlwifi, ath9k, ...)"; exit 1; }
	n=$(printf '%s\n' "$ifaces" | wc -l | tr -d ' ')
	if [ "$n" = 1 ]; then
		iface=$ifaces
		say "interface $iface"
	else
		say "wireless interfaces"
		i=0
		printf '%s\n' "$ifaces" | while read -r w; do
			i=$((i+1)); printf '  %s%s)%s %s\n' "$BOLD" "$i" "$R" "$w"
		done
		printf '\n  choose [1]: '
		read -r pick
		[ -n "$pick" ] || pick=1
		iface=$(printf '%s\n' "$ifaces" | sed -n "${pick}p")
		[ -n "$iface" ] || { oops "no interface number $pick"; exit 1; }
	fi
	check_iface "$iface"

	# 2. what is in range
	tmp=/tmp/.wifi-scan.$$
	scan_with_spinner "$iface" "$tmp"
	nets=$(parse_scan "$tmp")
	rm -f "$tmp"
	[ -n "$nets" ] || { oops "no networks found - move closer, or check the antenna"; exit 1; }

	printf '\n  %s%-32s %-8s %s%s\n' "$GREY" "NETWORK" "SIGNAL" "SECURITY" "$R"
	i=0
	printf '%s\n' "$nets" | while IFS="$(printf '\t')" read -r s sig sec; do
		i=$((i+1))
		printf '  %s%2s)%s %-32s %-8s %s\n' "$BOLD" "$i" "$R" "$s" "${sig:--}" "$sec"
	done
	printf '\n  choose a network: '
	read -r pick
	line=$(printf '%s\n' "$nets" | sed -n "${pick}p")
	[ -n "$line" ] || { oops "no network number $pick"; exit 1; }
	ssid=$(printf '%s' "$line" | cut -f1)
	sec=$(printf '%s' "$line" | cut -f3)

	# 3. the passphrase
	PASSWORD=''
	if [ "$sec" = open ]; then
		say "$ssid is open - no passphrase needed"
	else
		printf '  passphrase for %s%s%s: ' "$BOLD" "$ssid" "$R"
		read_password
	fi

	connect "$ssid" "$PASSWORD" "$iface"
}

mode=connect
case "${1:-}" in
'')            interactive; exit $? ;;
scan)          mode=scan;  iface=${2:-} ;;
list-networks) mode=list;  iface=${2:-} ;;
-h|--help)     sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 0 ;;
*)             ssid=${1:-}; psk=${2:-}; iface=${3:-} ;;
esac

if [ "$mode" = connect ] && { [ -z "${ssid:-}" ] || [ -z "${psk:-}" ]; }; then
	cat >&2 <<'USAGE'
usage: wifi-connect                        pick an interface and a network
       wifi-connect <ssid> <psk> [iface]
       wifi-connect scan [iface]
       wifi-connect list-networks [iface]
USAGE
	exit 1
fi

if [ -z "$iface" ]; then
	iface=$(wireless_ifaces | head -1)
fi
[ -n "$iface" ] || { oops "no wireless interface found - is the driver loaded? (iwlwifi, ath9k, ...)"; exit 1; }
check_iface "$iface"

if [ "$mode" = scan ] || [ "$mode" = list ]; then
	command -v iw >/dev/null 2>&1 || { oops "iw is not installed - cannot scan (alpm add iw)"; exit 1; }
	tmp=/tmp/.wifi-scan.$$
	scan_with_spinner "$iface" "$tmp"
	if [ "$mode" = list ]; then
		parse_scan "$tmp" | cut -f1
	else
		printf '%-32s %-8s %s\n' "NETWORK" "SIGNAL" "SECURITY"
		parse_scan "$tmp" | while IFS="$(printf '\t')" read -r s sig sec; do
			printf '%-32s %-8s %s\n' "$s" "${sig:--}" "$sec"
		done
	fi
	rm -f "$tmp"
	exit 0
fi

connect "$ssid" "$psk" "$iface"
