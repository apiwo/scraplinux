#!/bin/sh
# wifi-connect - bring up WPA2-Personal wireless on the live/installer image.
# This is the live medium's iwctl replacement: NetworkManager+nmtui is the
# installed system's real wireless story (see ports/main/networkmanager),
# but that's a much bigger dependency tree than the live bootstrap stage
# builds - wpa_supplicant alone is enough to get an install-time link up.
#
#   wifi-connect <ssid> <psk> [iface]   connect
#   wifi-connect scan [iface]           scan and show what is in range
#   wifi-connect list-networks [iface]  the same list, names only
#
# Enterprise/802.1X networks aren't supported here - wpa_supplicant was
# built WPA2-Personal only on the live image, no TLS backend. Use a wired
# connection or a phone hotspot for those, then set up 802.1X properly
# after install through NetworkManager.
set -u

# Scanning comes first: connecting to a network requires knowing its name,
# and there was no way to find one out from here at all - the only tool that
# could list them was the iwctl this replaced.
mode=connect
case "${1:-}" in
scan)          mode=scan;  iface=${2:-} ;;
list-networks) mode=list;  iface=${2:-} ;;
*)             ssid=${1:-}; psk=${2:-}; iface=${3:-} ;;
esac

if [ "$mode" = connect ] && { [ -z "${ssid:-}" ] || [ -z "${psk:-}" ]; }; then
	cat >&2 <<'USAGE'
usage: wifi-connect <ssid> <psk> [iface]
       wifi-connect scan [iface]
       wifi-connect list-networks [iface]
USAGE
	exit 1
fi

if [ -z "$iface" ]; then
	for i in /sys/class/net/*; do
		n=$(basename "$i")
		[ -d "$i/wireless" ] && { iface=$n; break; }
	done
fi
if [ -z "$iface" ]; then
	echo "wifi-connect: no wireless interface found - is the driver loaded? (iwlwifi, ath9k, ...)" >&2
	exit 1
fi

# iface either came from the sysfs scan above or was typed in as $3 - either
# way, reject anything with a "/" before it becomes part of a path below, and
# require it to actually be a real interface.
case "$iface" in */*) echo "wifi-connect: bad interface name: $iface" >&2; exit 1 ;; esac
[ -d "/sys/class/net/$iface" ] || { echo "wifi-connect: no such interface: $iface" >&2; exit 1; }

# Scanning needs the interface up and nothing else. iw is the tool for it
# when it is installed; the kernel's own scan results through wpa_supplicant
# work otherwise, and both beat having no way to see what is in range.
if [ "$mode" = scan ] || [ "$mode" = list ]; then
	ip link set "$iface" up 2>/dev/null
	if command -v iw >/dev/null 2>&1; then
		if [ "$mode" = list ]; then
			iw dev "$iface" scan 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p' | \
				grep -v '^$' | sort -u
		else
			printf '%-34s %-7s %s\n' "SSID" "SIGNAL" "SECURITY"
			iw dev "$iface" scan 2>/dev/null | awk '
				/^BSS /            { sig=""; ssid=""; sec="open" }
				/signal:/          { sig=$2 }
				/SSID: /           { sub(/^[ \t]*SSID: /, ""); ssid=$0 }
				/RSN:|WPA:/        { sec="wpa" }
				/^[ \t]*$/         { if (ssid != "") printf "%-34s %-7s %s\n", ssid, sig, sec; ssid="" }
				END                { if (ssid != "") printf "%-34s %-7s %s\n", ssid, sig, sec }'
		fi
		exit 0
	fi
	echo "wifi-connect: iw is not installed - cannot scan (alpm ins iw)" >&2
	exit 1
fi

command -v wpa_supplicant >/dev/null 2>&1 || { echo "wifi-connect: wpa_supplicant not found" >&2; exit 1; }

conf="/etc/wpa_supplicant-$iface.conf"
# Create the file world-unreadable *before* the PSK is ever written to it -
# a plain ">" redirect creates it with the umask's default mode first, which
# would leave the passphrase readable by anyone for the (short) window before
# a chmod that comes after the write.
: >"$conf"
chmod 600 "$conf"
# Passphrase goes in over stdin, not argv - wpa_passphrase would otherwise put
# it in its own command line, readable by any local user via ps/proc while it
# runs.
printf '%s\n' "$psk" | wpa_passphrase "$ssid" >"$conf" 2>/dev/null

# Replace any previous run for this interface rather than stacking a
# second wpa_supplicant instance fighting the first one over the same nl80211
# interface.
pkill -f "wpa_supplicant .*-i$iface" 2>/dev/null
sleep 1

ip link set "$iface" up 2>/dev/null
if ! wpa_supplicant -B -i "$iface" -c "$conf" >/dev/null 2>&1; then
	echo "wifi-connect: wpa_supplicant failed to associate with $ssid on $iface" >&2
	exit 1
fi

echo "wifi-connect: associated with $ssid on $iface, requesting an address..."
if udhcpc -i "$iface" -n -q >/dev/null 2>&1; then
	echo "wifi-connect: connected. Run 'arctic-install' when you're ready."
else
	echo "wifi-connect: associated, but DHCP failed - check 'ip addr' and the network." >&2
	exit 1
fi
