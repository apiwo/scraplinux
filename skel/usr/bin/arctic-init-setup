#!/bin/sh
# arctic-init-setup - set up an init system and translate Arctic's services to it
#
#   arctic-init-setup <init> [--root DIR]
#
#   busybox openrc sysvinit runit dinit nitro systemd-libre
#
# Arctic declares services once, in /etc/rc.d - NAME/CMD/ARGS/BACKGROUND and
# a call to svc_main. This generates the equivalent for whichever init is
# actually running, so a service stays a one-file change instead of five
# hand-maintained copies drifting apart.
# shellcheck shell=sh disable=SC2039

set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

INIT=${1:?usage: arctic-init-setup <init> [--root DIR]}
ROOT=/
case "${2:-}" in --root) ROOT=${3:?--root needs a directory} ;; esac
ROOT=${ROOT%/}

RCD="$ROOT/etc/rc.d"
SVCDIR="$ROOT/etc/arctic/services"

msg() { printf '  %s\n' "$*"; }

# Pull NAME/CMD/ARGS/BACKGROUND back out of an rc.d script without running it.
# Sourcing would execute svc_main and actually try to start the service.
svc_field() {
	awk -v k="$2" -F= '
		$0 ~ "^"k"=" {
			sub("^"k"=", "")
			gsub(/^"|"$/, "")
			print
			exit
		}' "$1"
}

each_service() {
	for f in "$RCD"/*; do
		[ -f "$f" ] || continue
		printf '%s\n' "$(basename "$f")"
	done
}

is_enabled() { [ -e "$SVCDIR/$1" ]; }

# nftables, fstrim, zram and pipewire's bring-up have no CMD - they
# define start()/stop() in the rc.d script itself, and become a one-shot
# that calls it directly instead of a supervised process.
is_scripted() { [ -z "$(svc_field "$RCD/$1" CMD)" ]; }

# ------------------------------------------------------------------- busybox
# Nothing to translate: /etc/rc.boot reads /etc/arctic/services directly and
# runs the /etc/rc.d scripts as they are.
setup_busybox() {
	msg "busybox init - /etc/rc.d used directly, nothing to translate"
}

# -------------------------------------------------------------------- openrc
setup_openrc() {
	mkdir -p "$ROOT/etc/init.d" "$ROOT/etc/runlevels/default" "$ROOT/etc/runlevels/boot"
	for s in $(each_service); do
		cmd=$(svc_field "$RCD/$s" CMD)
		args=$(svc_field "$RCD/$s" ARGS)
		bg=$(svc_field "$RCD/$s" BACKGROUND)
		{
			printf '#!/sbin/openrc-run\n'
			printf '# Generated by arctic-init-setup from /etc/rc.d/%s\n\n' "$s"
			printf 'name="%s"\n' "$s"
			if [ -z "$cmd" ]; then
				# No daemon to supervise - hand start/stop straight back to
				# the rc.d script, which defines them itself.
				printf 'start() { /etc/rc.d/%s start; }\n' "$s"
				printf 'stop()  { /etc/rc.d/%s stop; }\n' "$s"
			else
				printf 'command="%s"\n' "$cmd"
				[ -n "$args" ] && printf 'command_args="%s"\n' "$args"
				if [ "$bg" = no ]; then
					printf 'command_background=false\n'
				else
					printf 'command_background=true\n'
					printf 'pidfile="/run/%s.pid"\n' "$s"
				fi
			fi
			printf '\ndepend() {\n'
			case "$s" in
			sshd|ntpd|nftables)              printf '\tneed net\n' ;;
			pipewire|bluetoothd) printf '\tneed dbus\n' ;;
			esac
			printf '\tafter bootmisc\n}\n'
		} >"$ROOT/etc/init.d/$s"
		chmod 755 "$ROOT/etc/init.d/$s"
		is_enabled "$s" && ln -sf "/etc/init.d/$s" "$ROOT/etc/runlevels/default/$s"
	done
	msg "openrc: $(ls "$ROOT/etc/init.d" | wc -l) services in /etc/init.d"
}

# ------------------------------------------------------------------ sysvinit
setup_sysvinit() {
	mkdir -p "$ROOT/etc/init.d" "$ROOT/etc/rc3.d" "$ROOT/etc/rc5.d"
	n=10
	for s in $(each_service); do
		# Works for daemons and script-style services alike: both are just
		# start/stop verbs on the rc.d script.
		# An LSB-style wrapper around the rc.d script Arctic already has -
		# svc.lib's start/stop/status verbs are the same ones sysvinit wants.
		{
			printf '#!/bin/sh\n'
			printf '### BEGIN INIT INFO\n'
			printf '# Provides:          %s\n' "$s"
			printf '# Required-Start:    $local_fs $remote_fs\n'
			printf '# Required-Stop:     $local_fs $remote_fs\n'
			printf '# Default-Start:     3 5\n'
			printf '# Default-Stop:      0 1 6\n'
			printf '### END INIT INFO\n\n'
			printf 'exec /etc/rc.d/%s "$@"\n' "$s"
		} >"$ROOT/etc/init.d/$s"
		chmod 755 "$ROOT/etc/init.d/$s"
		if is_enabled "$s"; then
			ln -sf "/etc/init.d/$s" "$(printf '%s/etc/rc3.d/S%02d%s' "$ROOT" "$n" "$s")"
			ln -sf "/etc/init.d/$s" "$(printf '%s/etc/rc5.d/S%02d%s' "$ROOT" "$n" "$s")"
			n=$((n + 1))
		fi
	done
	msg "sysvinit: /etc/init.d populated, enabled services linked into rc3.d and rc5.d"
}

# --------------------------------------------------------------------- runit
setup_runit() {
	mkdir -p "$ROOT/etc/sv" "$ROOT/etc/runit/runsvdir/default"
	for s in $(each_service); do
		cmd=$(svc_field "$RCD/$s" CMD)
		args=$(svc_field "$RCD/$s" ARGS)
		bg=$(svc_field "$RCD/$s" BACKGROUND)
		# runit supervises long-running processes; a one-shot has nothing to
		# supervise and would be restarted forever. Those belong in stage 1,
		# which is written below.
		[ -n "$cmd" ] || continue
		mkdir -p "$ROOT/etc/sv/$s"
		{
			printf '#!/bin/sh\n'
			printf '# Generated by arctic-init-setup from /etc/rc.d/%s\n' "$s"
			printf 'exec 2>&1\n'
			# runit supervises, so anything that would daemonise has to be
			# told to stay in the foreground instead.
			case "$s" in
			dbus)     printf 'exec %s --system --nofork --nopidfile\n' "$cmd" ;;
			sshd)     printf 'exec %s -D\n' "$cmd" ;;
			crond)    printf 'exec %s -f\n' "$cmd" ;;
			syslogd)  printf 'exec %s -n\n' "$cmd" ;;
			ntpd)     printf 'exec %s -n\n' "$cmd" ;;
			udevd)    printf 'exec %s\n' "$cmd" ;;
			*)        printf 'exec %s %s\n' "$cmd" "$args" ;;
			esac
		} >"$ROOT/etc/sv/$s/run"
		chmod 755 "$ROOT/etc/sv/$s/run"
		is_enabled "$s" && \
			ln -sf "/etc/sv/$s" "$ROOT/etc/runit/runsvdir/default/$s"
	done

	# Stage 1: the one-time setup runit does before supervision starts.
	# nftables and the rest live here rather than under /etc/sv,
	# because a one-shot that exits immediately would just be respawned.
	mkdir -p "$ROOT/etc/runit"
	{
		printf '#!/bin/sh\n'
		printf '# Generated by arctic-init-setup - runit stage 1.\n'
		printf 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n\n'
		printf 'mount -t proc proc /proc 2>/dev/null\n'
		printf 'mount -t sysfs sys /sys 2>/dev/null\n'
		printf 'mount -t devtmpfs dev /dev 2>/dev/null\n'
		printf 'mount -o remount,rw / 2>/dev/null\n\n'
		for s in $(each_service); do
			is_scripted "$s" || continue
			is_enabled "$s" || continue
			printf '/etc/rc.d/%s start\n' "$s"
		done
		printf '\ntouch /etc/runit/stopit\nchmod 0 /etc/runit/stopit\n'
	} >"$ROOT/etc/runit/1"
	chmod 755 "$ROOT/etc/runit/1"

	{
		printf '#!/bin/sh\n'
		printf 'exec runsvdir -P /etc/runit/runsvdir/default\n'
	} >"$ROOT/etc/runit/2"
	chmod 755 "$ROOT/etc/runit/2"

	{
		printf '#!/bin/sh\n'
		printf '# Generated by arctic-init-setup - runit stage 3 (shutdown).\n'
		for s in $(each_service); do
			is_scripted "$s" || continue
			is_enabled "$s" || continue
			printf '/etc/rc.d/%s stop\n' "$s"
		done
		printf 'sync\numount -a -r 2>/dev/null\n'
	} >"$ROOT/etc/runit/3"
	chmod 755 "$ROOT/etc/runit/3"

	msg "runit: $(ls "$ROOT/etc/sv" | wc -l) supervised services, one-shots in stage 1"
}

# --------------------------------------------------------------------- nitro
# Services are directories under /etc/nitro. A service with a `run` script is
# supervised and its run must not exit; one with only a `setup` script is a
# one-shot that stays up once setup succeeds - which is exactly the shape of
# Arctic's scripted services, so they need no respawn guard the way runit's
# stage 1 does. A `down` file means "do not start this at boot", so disabled
# services get one instead of being left out of the directory.
setup_nitro() {
	_nd=${1:-nitro}
	mkdir -p "$ROOT/etc/$_nd"
	for s in $(each_service); do
		cmd=$(svc_field "$RCD/$s" CMD)
		args=$(svc_field "$RCD/$s" ARGS)
		mkdir -p "$ROOT/etc/$_nd/$s"
		if [ -z "$cmd" ]; then
			# No daemon: a one-shot. setup runs once and the service stays
			# ONESHOT afterwards; stopping is handled from SYS/finish.
			{
				printf '#!/bin/sh\n'
				printf '# Generated by arctic-init-setup from /etc/rc.d/%s\n' "$s"
				printf 'exec /etc/rc.d/%s start\n' "$s"
			} >"$ROOT/etc/$_nd/$s/setup"
			chmod 755 "$ROOT/etc/$_nd/$s/setup"
			rm -f "$ROOT/etc/$_nd/$s/run"
		else
			{
				printf '#!/bin/sh\n'
				printf '# Generated by arctic-init-setup from /etc/rc.d/%s\n' "$s"
				printf 'exec 2>&1\n'
				# Supervised, so anything that would daemonise has to be told
				# to stay in the foreground.
				case "$s" in
				dbus)     printf 'exec %s --system --nofork --nopidfile\n' "$cmd" ;;
				sshd)     printf 'exec %s -D\n' "$cmd" ;;
				crond)    printf 'exec %s -f\n' "$cmd" ;;
				syslogd)  printf 'exec %s -n\n' "$cmd" ;;
				ntpd)     printf 'exec %s -n\n' "$cmd" ;;
				*)        printf 'exec %s %s\n' "$cmd" "$args" ;;
				esac
			} >"$ROOT/etc/$_nd/$s/run"
			chmod 755 "$ROOT/etc/$_nd/$s/run"
			rm -f "$ROOT/etc/$_nd/$s/setup"
		fi
		if is_enabled "$s"; then
			rm -f "$ROOT/etc/$_nd/$s/down"
		else
			: >"$ROOT/etc/$_nd/$s/down"
		fi
	done

	# SYS runs around everything else: setup before any service starts,
	# finish before they are killed, final once nothing is left running.
	mkdir -p "$ROOT/etc/$_nd/SYS"
	{
		printf '#!/bin/sh\n'
		printf '# Generated by arctic-init-setup - nitro early boot.\n'
		printf 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n\n'
		printf 'mount -t proc     -o nosuid,noexec,nodev proc /proc 2>/dev/null\n'
		printf 'mount -t sysfs    -o nosuid,noexec,nodev sys /sys 2>/dev/null\n'
		printf 'mount -t devtmpfs -o nosuid,mode=755 dev /dev 2>/dev/null\n'
		printf 'mount -t tmpfs    -o nosuid,nodev,mode=755 run /run 2>/dev/null\n'
		printf 'mkdir -p /dev/pts /dev/shm /run/lock /run/arctic\n'
		printf 'mount -t devpts -o nosuid,noexec,gid=5,mode=620 devpts /dev/pts 2>/dev/null\n'
		printf 'mount -t tmpfs  -o nosuid,nodev,mode=1777 shm /dev/shm 2>/dev/null\n'
		printf 'mount -o remount,rw / 2>/dev/null\n'
		printf 'mount -a 2>/dev/null\n'
		printf 'swapon -a 2>/dev/null\n'
		printf 'hostname -F /etc/hostname 2>/dev/null\n'
		printf 'ip link set lo up 2>/dev/null\n'
	} >"$ROOT/etc/$_nd/SYS/setup"
	chmod 755 "$ROOT/etc/$_nd/SYS/setup"
	{
		printf '#!/bin/sh\n'
		printf '# Generated by arctic-init-setup - nitro shutdown.\n'
		for s in $(each_service); do
			is_scripted "$s" || continue
			is_enabled "$s" || continue
			printf '/etc/rc.d/%s stop\n' "$s"
		done
	} >"$ROOT/etc/$_nd/SYS/finish"
	chmod 755 "$ROOT/etc/$_nd/SYS/finish"
	{
		printf '#!/bin/sh\n'
		printf 'sync\n'
		printf 'umount -a -r 2>/dev/null\n'
	} >"$ROOT/etc/$_nd/SYS/final"
	chmod 755 "$ROOT/etc/$_nd/SYS/final"

	# nitroctl acts as halt/poweroff/reboot/shutdown when called under those
	# names, but busybox owns all four in /usr/bin and is the package that
	# installed them. /usr/local/bin comes first in PATH, so put them there
	# rather than overwriting files another package owns - typing "reboot"
	# then brings the system down through nitro instead of going straight to
	# the syscall with every service still running.
	mkdir -p "$ROOT/usr/local/bin"
	for l in halt poweroff reboot shutdown; do
		ln -sf /usr/bin/nitroctl "$ROOT/usr/local/bin/$l"
	done

	msg "$_nd: $(ls "$ROOT/etc/$_nd" | wc -l) service dirs in /etc/$_nd, SYS wraps the boot"
}

# --------------------------------------------------------------------- dinit
setup_dinit() {
	mkdir -p "$ROOT/etc/dinit.d/boot.d"
	for s in $(each_service); do
		cmd=$(svc_field "$RCD/$s" CMD)
		args=$(svc_field "$RCD/$s" ARGS)
		bg=$(svc_field "$RCD/$s" BACKGROUND)
		# No daemon means nothing to supervise - dinit's scripted type runs
		# the rc.d script's own start/stop instead.
		[ -n "$cmd" ] || bg=no
		{
			printf '# Generated by arctic-init-setup from /etc/rc.d/%s\n' "$s"
			if [ "$bg" = no ]; then
				printf 'type = scripted\n'
				printf 'command = /etc/rc.d/%s start\n' "$s"
				printf 'stop-command = /etc/rc.d/%s stop\n' "$s"
			else
				printf 'type = process\n'
				case "$s" in
				dbus)    printf 'command = %s --system --nofork --nopidfile\n' "$cmd" ;;
				sshd)    printf 'command = %s -D\n' "$cmd" ;;
				crond)   printf 'command = %s -f\n' "$cmd" ;;
				syslogd) printf 'command = %s -n\n' "$cmd" ;;
				ntpd)    printf 'command = %s -n\n' "$cmd" ;;
				*)       printf 'command = %s %s\n' "$cmd" "$args" ;;
				esac
				printf 'smooth-recovery = true\n'
			fi
			case "$s" in
			pipewire|bluetoothd) printf 'depends-on = dbus\n' ;;
			esac
			printf 'logfile = /var/log/dinit-%s.log\n' "$s"
		} >"$ROOT/etc/dinit.d/$s"
		is_enabled "$s" && ln -sf "../$s" "$ROOT/etc/dinit.d/boot.d/$s"
	done
	# dinit needs a boot service that depends on everything enabled.
	{
		printf '# Generated by arctic-init-setup\n'
		printf 'type = internal\n'
		printf 'waits-for.d = boot.d\n'
	} >"$ROOT/etc/dinit.d/boot"
	msg "dinit: services in /etc/dinit.d, enabled ones linked into boot.d"
}

# --------------------------------------------------------------------- s6-66
setup_s6() {
	mkdir -p "$ROOT/etc/s6/sv" "$ROOT/etc/s6/rc/compiled" "$ROOT/etc/66/service"
	for s in $(each_service); do
		cmd=$(svc_field "$RCD/$s" CMD)
		args=$(svc_field "$RCD/$s" ARGS)
		[ -n "$cmd" ] || continue

		# s6-rc longrun: a service directory with a run script.
		mkdir -p "$ROOT/etc/s6/sv/$s"
		printf 'longrun\n' >"$ROOT/etc/s6/sv/$s/type"
		{
			printf '#!/bin/execlineb -P\n'
			printf 'fdmove -c 2 1\n'
			case "$s" in
			dbus)    printf '%s --system --nofork --nopidfile\n' "$cmd" ;;
			sshd)    printf '%s -D\n' "$cmd" ;;
			crond)   printf '%s -f\n' "$cmd" ;;
			syslogd) printf '%s -n\n' "$cmd" ;;
			ntpd)    printf '%s -n\n' "$cmd" ;;
			*)       printf '%s %s\n' "$cmd" "$args" ;;
			esac
		} >"$ROOT/etc/s6/sv/$s/run"
		chmod 755 "$ROOT/etc/s6/sv/$s/run"
		case "$s" in
		pipewire|bluetoothd) printf 'dbus\n' >"$ROOT/etc/s6/sv/$s/dependencies" ;;
		esac

		# The 66 frontend description for the same service.
		{
			printf '[main]\n'
			printf '@type = classic\n'
			printf '@version = 0.0.1\n'
			printf '@description = "%s"\n' "$s"
			printf '@user = ( root )\n\n'
			printf '[start]\n'
			printf '@execute = ( %s %s )\n' "$cmd" "$args"
		} >"$ROOT/etc/66/service/$s"
	done

	# The bundle s6-rc brings up at boot.
	mkdir -p "$ROOT/etc/s6/sv/arctic-default"
	printf 'bundle\n' >"$ROOT/etc/s6/sv/arctic-default/type"
	: >"$ROOT/etc/s6/sv/arctic-default/contents"
	for s in $(each_service); do
		is_enabled "$s" && printf '%s\n' "$s" >>"$ROOT/etc/s6/sv/arctic-default/contents"
	done
	msg "s6-66: service dirs in /etc/s6/sv, 66 frontends in /etc/66/service"
	msg "s6-66: compile the database on the target with: s6-rc-compile /etc/s6/rc/compiled /etc/s6/sv"
}

# ------------------------------------------------------------------- systemd
setup_systemd() {
	mkdir -p "$ROOT/etc/systemd/system/multi-user.target.wants"
	for s in $(each_service); do
		cmd=$(svc_field "$RCD/$s" CMD)
		args=$(svc_field "$RCD/$s" ARGS)
		bg=$(svc_field "$RCD/$s" BACKGROUND)
		# No daemon means Type=oneshot delegating to the rc.d script.
		[ -n "$cmd" ] || bg=no
		{
			printf '# Generated by arctic-init-setup from /etc/rc.d/%s\n' "$s"
			printf '[Unit]\n'
			printf 'Description=%s\n' "$s"
			case "$s" in
			pipewire|bluetoothd) printf 'After=dbus.service\nRequires=dbus.service\n' ;;
			sshd|ntpd)                          printf 'After=network.target\n' ;;
			esac
			printf '\n[Service]\n'
			if [ "$bg" = no ]; then
				printf 'Type=oneshot\nRemainAfterExit=yes\n'
				printf 'ExecStart=/etc/rc.d/%s start\n' "$s"
				printf 'ExecStop=/etc/rc.d/%s stop\n' "$s"
			else
				printf 'Type=simple\n'
				case "$s" in
				dbus)    printf 'ExecStart=%s --system --nofork --nopidfile\n' "$cmd" ;;
				sshd)    printf 'ExecStart=%s -D\n' "$cmd" ;;
				crond)   printf 'ExecStart=%s -f\n' "$cmd" ;;
				syslogd) printf 'ExecStart=%s -n\n' "$cmd" ;;
				ntpd)    printf 'ExecStart=%s -n\n' "$cmd" ;;
				*)       printf 'ExecStart=%s %s\n' "$cmd" "$args" ;;
				esac
				printf 'Restart=on-failure\n'
			fi
			printf '\n[Install]\nWantedBy=multi-user.target\n'
		} >"$ROOT/etc/systemd/system/$s.service"
		is_enabled "$s" && ln -sf "/etc/systemd/system/$s.service" \
			"$ROOT/etc/systemd/system/multi-user.target.wants/$s.service"
	done
	msg "systemd: units in /etc/systemd/system"
}

case "$INIT" in
busybox)                setup_busybox ;;
openrc)                 setup_openrc ;;
sysvinit)               setup_sysvinit ;;
runit)                  setup_runit ;;
dinit)                  setup_dinit ;;
nitro)                  setup_nitro nitro ;;
# initialization is the nitro fork Arctic ships, and it reads the same shape
# of service directory - the only difference is where it looks for it.
initialization)         setup_nitro initialization ;;
systemd-libre)          setup_systemd ;;
*) echo "arctic-init-setup: unknown init '$INIT'" >&2; exit 1 ;;
esac
