#!/bin/sh
# scraplinux-power - bring the system down through whichever init is running.
#
# Installed as poweroff, reboot, halt and shutdown; it decides what to do
# from the name it was called by.
#
# toybox and busybox both ship a poweroff/reboot that calls the reboot(2)
# syscall directly. That stops the machine, but nothing else: services are
# never told to stop, /etc/rc.shutdown never runs, the clock is never saved
# and filesystems go down without being unmounted. What should happen is a
# request to pid 1, which then runs the shutdown path it knows about - and
# which pid 1 that is depends on A_INIT.
#
# These live in /usr/local/bin, which comes first in PATH, because busybox
# owns /usr/bin/poweroff and friends and two packages cannot own one path.
# shellcheck shell=sh disable=SC2039

set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

case "$(basename "$0")" in
reboot)             action=reboot ;;
halt)               action=halt ;;
poweroff|shutdown)  action=poweroff ;;
*)                  action=${1:-poweroff} ;;
esac

# "shutdown -r now" and "shutdown -h now" are muscle memory for a lot of
# people; honour the two flags that actually mean something here.
for a in "$@"; do
	case "$a" in
	-r|--reboot)   action=reboot ;;
	-h|-H|--halt)  action=halt ;;
	-P|--poweroff) action=poweroff ;;
	-f|--force)    force=1 ;;
	esac
done

[ "$(id -u)" = "0" ] || { echo "scraplinux-power: must be run as root." >&2; exit 1; }

init_kind() {
	if [ -n "${SCRAPLINUX_INIT:-}" ]; then printf '%s\n' "$SCRAPLINUX_INIT"; return; fi
	if [ -s /etc/scraplinux/init ]; then head -1 /etc/scraplinux/init; return; fi
	_k=$(readlink /proc/1/exe 2>/dev/null)
	case "${_k##*/}" in
	dinit)            echo dinit ;;
	openrc-init|rc)   echo openrc ;;
	runit|runit-init) echo runit ;;
	nitro)            echo nitro ;;
	# /sbin/init execs "66 boot", but 66 boot does not stay as pid 1 - it
	# execs into the scandir supervisor, so /proc/1/exe reads
	# /usr/bin/66-scandir on a running system and never /usr/bin/66.
	# Matching only "66" here meant every s66 machine fell through to the
	# busybox branch below and got SIGUSR2 sent to a process that treats it
	# as something else entirely. Both names, because which one is pid 1
	# depends on how far through boot the system got.
	66|66-scandir)    echo s66 ;;
	*)                echo busybox ;;
	esac
}

sync

case "$(init_kind)" in
busybox)
	# busybox init listens for these: SIGUSR1 halt, SIGUSR2 poweroff,
	# SIGTERM reboot. It runs the inittab's ::shutdown entry - rc.shutdown -
	# before acting on any of them.
	case "$action" in
	halt)     kill -USR1 1 ;;
	poweroff) kill -USR2 1 ;;
	reboot)   kill -TERM 1 ;;
	esac ;;
dinit)
	case "$action" in
	halt)     dinitctl shutdown --halt ;;
	poweroff) dinitctl shutdown --poweroff ;;
	reboot)   dinitctl shutdown --reboot ;;
	esac ;;
openrc)
	case "$action" in
	halt)     openrc-shutdown --halt now ;;
	poweroff) openrc-shutdown --poweroff now ;;
	reboot)   openrc-shutdown --reboot now ;;
	esac ;;
runit)
	case "$action" in
	halt|poweroff) runit-init 0 ;;
	reboot)        runit-init 6 ;;
	esac ;;
nitro)
	case "$action" in
	halt|poweroff) nitroctl Shutdown ;;
	reboot)        nitroctl Reboot ;;
	esac ;;
s66)
	# -f, every time. Without it 66-hpr only *requests* the transition: it
	# writes to 66-shutdownd's fifo, prints "The system is going down NOW!"
	# and exits, and on this system nothing ever finishes the job. Measured,
	# booting the real image under qemu: `66-hpr -p` printed the warning and
	# returned to a shell prompt with the machine still up; `66 poweroff -a
	# -- now` exited 0 and did nothing at all; `66-hpr -p -f` powered the
	# machine off immediately. The delegated path expects a real init to run
	# a final stage, and pid 1 here is the scandir supervisor, which has
	# none - so the request is accepted and then nobody acts on it.
	#
	# Going through the scandir's own signal handlers is the same trap from
	# the other side: SIGUSR2 runs `66 halt -a -- now`, which does get as far
	# as stopping services, so the console fills with "Successfully stopped
	# service: ..." and then hangs forever with everything down. Worse, one
	# of the services it stops is the getty this script is running under, so
	# the fallback further down never gets to run either.
	#
	# -f is not a hard reset: 66-hpr syncs before acting unless -n says
	# otherwise, which is the same guarantee busybox's own poweroff gives.
	# It is also what 66 itself falls back to - see the scandir's finish and
	# crash scripts, both of which run `66-hpr -r -f`.
	case "$action" in
	halt)     66-hpr -h -f -l /run/66/ ;;
	poweroff) 66-hpr -p -f -l /run/66/ ;;
	reboot)   66-hpr -r -f -l /run/66/ ;;
	esac ;;
esac

# If pid 1 did not act - no such init, or one that ignores the request -
# fall back to the syscall rather than leaving someone at a prompt that will
# not shut down. Only after the request above had its chance.
sleep 5
echo "scraplinux-power: init did not respond; going down the hard way" >&2
sync
case "$action" in
reboot) exec /usr/bin/reboot ;;
halt)   exec /usr/bin/halt ;;
*)      exec /usr/bin/poweroff ;;
esac
