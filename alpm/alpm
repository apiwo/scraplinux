#!/bin/sh
# alpm - Arctic Linux Package Manager
#
# Binary packages are .alpmz - Arctic Linux Package Management Zip - which is a
# tar.xz holding .PKGINFO, .FILES, an optional .INSTALL, and the payload rooted
# at /. No GNU utilities are required at runtime.
# shellcheck shell=sh disable=SC2039,SC2044,SC2086

set -u

# Where this copy of alpm lives, so its companions can be run without
# depending on PATH. `alpm ins -s` used to run "alpm build ..." by name: fine
# for an installed system, and a flat "alpm: command not found" for anyone
# running it out of a checkout or from an absolute path - which is every
# source build during development, and the installer's own target_alpm.
ALPM_SELFDIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || ALPM_SELFDIR=/usr/bin
for p in /usr/lib/alpm/libalpm.sh ./libalpm.sh "$ALPM_SELFDIR/libalpm.sh"; do
	[ -f "$p" ] && { . "$p"; break; }
done
[ -n "${ALPM_VERSION:-}" ] || { echo "alpm: cannot locate libalpm.sh" >&2; exit 1; }

alpm_load_conf

# Anything half-built when alpm stops - a resolver scratch directory, a
# database entry an interrupted install_one was still assembling - is removed
# on the way out. A leftover .incoming-<pkg> is harmless (nothing reads it,
# and is_installed only counts a directory with a PKGINFO in it), but there
# is no reason to leave it lying in the database either.
alpm_cleanup() {
	[ -n "${RES_DIR:-}" ] && rm -rf "$RES_DIR" 2>/dev/null
	[ -n "${ALPM_DB:-}" ] && rm -rf "$ALPM_DB"/local/.incoming-* 2>/dev/null
	return 0
}
trap 'alpm_cleanup' EXIT
trap 'alpm_cleanup; exit 130' INT
trap 'alpm_cleanup; exit 143' TERM

ARCH=${ALPM_ARCH:-x86_64}
NOMOD=0
SOURCE=0
# run_hooks reads this, and every command that reaches it has to have set it
# first. "alpm commit" did not, so with set -u it died on "HOOK_KERNEL:
# unbound variable" *after* activating the package - the work was done and the
# command still reported failure. Declared once here so no path can miss it.
HOOK_KERNEL=""
REASON=explicit

# ------------------------------------------------------------------------ usage

usage() {
	cat <<EOF
${A_TEAL}${C_B}alpm${C_R} ${A_GREY}${ALPM_VERSION} - Arctic Linux Package Manager${C_R}

${C_B}OPTIONS${C_R}
  -y, --yes, --noconfirm     answer every prompt and warning with yes
  -s, --source               build from source instead of installing a binary
  -nomod                     install without putting the package into place
  --root=<dir>               operate on another root instead of /

${C_B}INSTALLING${C_R}
  alpm ins <pkg>...          install binary packages
  alpm ins -s <pkg>...       build and install from source
  alpm ins -nomod <pkg>...   install without putting it into place (no hooks,
                             no bootloader/initramfs wiring) - for kernels and
                             other system pieces you want to stage first
  alpm commit <pkg>...       activate a package that was installed with -nomod
  alpm update [pkg]...       upgrade everything, or just the named packages
  alpm reins <pkg>...        reinstall, repairing any modified files

${C_B}REMOVING${C_R}
  alpm del <pkg>...          remove packages
  alpm del+deps <pkg>...     remove packages and any dependencies left orphaned
  alpm del+junk <pkg>...     remove packages and their config/cache leftovers
  alpm del+deps+junk <pkg>   both of the above
  alpm autoremove            remove every orphan on the system

${C_B}FETCHING${C_R}
  alpm get <pkg>...          unpack package contents here without installing
  alpm get -s <pkg>...       fetch upstream source here
  alpm fetch all             sync every enabled repo
  alpm fetch <repo>...       sync main | extra | base | kernels |
                             nonfree | alt-nonfree | multilib | profile
  alpm fetch ports           refresh the source recipe list only

${C_B}REPOSITORIES${C_R}
  alpm add repo <url>        add a repository
  alpm del repo <name>       remove a repository
  alpm list repos            show configured repositories
  alpm mirror <repo>         show/pick the fastest mirror for a repo

${C_B}QUERYING${C_R}
  alpm list                  list installed packages
  alpm list -e               list explicitly installed packages only
  alpm index [repo]          list everything available
  alpm search <pattern>      search names and descriptions
  alpm info <pkg>            show package details
  alpm files <pkg>           list files a package owns
  alpm owns <path>           find which package owns a file
  alpm deps <pkg>            show the dependency tree
  alpm rdeps <pkg>           show what depends on a package
  alpm why <pkg>             explain why a package is on the system
  alpm orphans               list packages nothing needs
  alpm stats                 installed size, counts, repo breakdown

${C_B}MAINTENANCE${C_R}
  alpm verify [pkg]          checksum every installed file against the database
  alpm doctor                check the system for problems and offer fixes
  alpm clean                 clear the download cache
  alpm hold <pkg> / unhold   pin a package against upgrades
  alpm mark <pkg> explicit|dep
  alpm snapshot [name]       save the current package state
  alpm rollback [id]         undo a transaction, restoring replaced files
  alpm log                   show the transaction log
  alpm build <recipe>        build an .alpmz from an Arctic port recipe
  alpm version               print version

Run as root for anything that changes the system.
EOF
}

# alpm-build, found the same way libalpm.sh is: beside this script first,
# then the installed location, then PATH.
alpm_build_path() {
	if [ -x "$ALPM_SELFDIR/alpm-build" ]; then printf '%s\n' "$ALPM_SELFDIR/alpm-build"
	elif [ -x /usr/bin/alpm-build ]; then printf '%s\n' /usr/bin/alpm-build
	else printf 'alpm-build\n'; fi
}

alpm_build_tool() { sh "$(alpm_build_path)" "$@"; }

# ------------------------------------------------------------- dependency logic

# Resolution happens in two passes, and neither of them runs in a command
# substitution: a die() inside a subshell only kills the subshell, so the old
# single-pass version could fail to resolve a dependency and still hand back
# an empty-but-successful list for alpm to carry on with.
#
# Pass one walks the graph breadth-first and is where every bit of the work
# is - one index lookup per package. It writes the graph, the closure and
# anything unresolvable into $RES_DIR, and drives the "Calculating
# dependencies..." bar from packages-read over packages-discovered: two real
# counts, so the bar can sit still while a big subtree opens up and never
# moves without something having actually happened.
#
# Pass two orders that closure deps-first. It reads nothing new - just the
# graph pass one already wrote - so it is instant and needs no progress of
# its own.
RES_DIR=""

resolve_targets() {
	RES_DIR="$ALPM_CACHE/build/.resolve.$$"
	rm -rf "$RES_DIR"; mkdir -p "$RES_DIR"
	: >"$RES_DIR/graph"; : >"$RES_DIR/missing"; : >"$RES_DIR/order"

	_rt_frontier="$*"
	_rt_seen=""
	_rt_read=0
	_rt_found=0
	for _rt_p in $_rt_frontier; do _rt_found=$((_rt_found+1)); done

	calc_begin
	while [ -n "$_rt_frontier" ]; do
		_rt_next=""
		for _rt_p in $_rt_frontier; do
			case " $_rt_seen " in *" $_rt_p "*) continue ;; esac
			_rt_seen="$_rt_seen $_rt_p"
			_rt_deps=""
			if _rt_e=$(idx_lookup "$_rt_p"); then
				_rt_deps=$(printf '%s' "$_rt_e" | cut -f9)
			elif is_installed "$_rt_p"; then
				# Already on the system and no longer in any index (a repo
				# it came from is gone, or it was built from source). Its own
				# recorded dependencies are still the truth for it.
				# Braces around the redirect: a failed input redirection is
				# reported by the shell itself, so "2>/dev/null" on tr alone
				# still printed "can't open .../DEPS: no such file" across the
				# resolver's progress bar. An entry with no DEPS at all is a
				# package installed by something that did not write one (the
				# live image used to do exactly that) - no dependencies
				# recorded is not an error.
				_rt_deps=$({ tr '\n' ' ' <"$ALPM_DB/local/$_rt_p/DEPS"; } 2>/dev/null || :)
			else
				printf '%s\n' "$_rt_p" >>"$RES_DIR/missing"
			fi
			printf '%s\t%s\n' "$_rt_p" "$_rt_deps" >>"$RES_DIR/graph"
			_rt_read=$((_rt_read+1))
			for _rt_d in $_rt_deps; do
				[ "$_rt_d" = "-" ] && continue
				case " $_rt_seen $_rt_next " in *" $_rt_d "*) continue ;; esac
				_rt_next="$_rt_next $_rt_d"
				_rt_found=$((_rt_found+1))
			done
			calc_step "$_rt_read" "$_rt_found"
		done
		_rt_frontier=$_rt_next
	done
	calc_done

	_topo_seen=""
	for _rt_p in $*; do _topo "$_rt_p"; done
	return 0
}

_g_deps() { awk -F'\t' -v p="$1" '$1==p{print $2; exit}' "$RES_DIR/graph"; }

_topo() {
	# local, because this recurses: without it the inner call overwrites the
	# caller's package name and the wrong entry lands in the install order.
	local p deps d
	p=$1
	case " $_topo_seen " in *" $p "*) return 0 ;; esac
	_topo_seen="$_topo_seen $p"
	deps=$(_g_deps "$p")
	for d in $deps; do
		[ "$d" = "-" ] && continue
		_topo "$d"
	done
	printf '%s\n' "$p" >>"$RES_DIR/order"
}

# Who pulled a package in - used to explain a dependency that cannot be
# resolved instead of just naming it.
_needed_by() {
	awk -F'\t' -v d="$1" '{n=split($2,a," "); for(i=1;i<=n;i++) if(a[i]==d){print $1; exit}}' \
		"$RES_DIR/graph"
}

# ------------------------------------------------------------------ transactions

txid() { date '+%Y%m%d-%H%M%S'; }

TX=""
TX_DIR=""

# A btrfs snapshot before the transaction, if the system is set up for it.
# This is separate from alpm's own rollback: that restores the files alpm
# replaced, whereas this catches anything a package's install script did too.
tx_snapshot() {
	[ "${ALPM_SNAPSHOT:-auto}" = "off" ] && return 0
	[ "$ALPM_ROOT" = "/" ] || return 0          # never for --root installs
	have arctic-snapshot || return 0
	[ "$(stat -f -c %T / 2>/dev/null)" = "btrfs" ] || return 0
	arctic-snapshot create "$1" >/dev/null 2>&1 || :
}

tx_begin() {
	TX=$(txid)
	TX_DIR="$ALPM_DB/snapshots/$TX"
	mkdir -p "$TX_DIR/replaced"
	: >"$TX_DIR/added"
	: >"$TX_DIR/packages"
	printf 'id = %s\nstarted = %s\ncommand = %s\n' \
		"$TX" "$(date '+%Y-%m-%d %H:%M:%S')" "$ALPM_CMDLINE" >"$TX_DIR/TXINFO"
}

# Preserve a file we are about to clobber so rollback can put it back.
tx_save() {
	f=$1
	[ -n "$TX_DIR" ] || return 0
	[ -e "$ALPM_ROOT$f" ] || return 0
	d=$(dirname "$TX_DIR/replaced$f")
	mkdir -p "$d"
	cp -a "$ALPM_ROOT$f" "$TX_DIR/replaced$f" 2>/dev/null || :
}

tx_added() { [ -n "$TX_DIR" ] && printf '%s\n' "$1" >>"$TX_DIR/added" || :; }

# The package database is not part of the filesystem snapshot above: tx_save
# only covers files a package payload replaces, and $ALPM_DB/local is written
# by alpm itself. Without these two, rollback put every *file* back and left
# the database describing the state it had just undone - a rolled-back
# install stayed "installed" with no files, and a rolled-back upgrade kept the
# new version's entry.
#
# tx_db_save records what the entry looked like before this transaction
# touched it; tx_db_new records that there was no entry at all, so rollback
# knows to delete rather than restore.
tx_db_save() {
	[ -n "$TX_DIR" ] || return 0
	if [ -f "$ALPM_DB/local/$1/PKGINFO" ]; then
		mkdir -p "$TX_DIR/db"
		rm -rf "$TX_DIR/db/$1"
		cp -a "$ALPM_DB/local/$1" "$TX_DIR/db/$1"
	else
		printf '%s\n' "$1" >>"$TX_DIR/db-new"
	fi
}

tx_end() {
	[ -n "$TX_DIR" ] || return 0
	printf 'finished = %s\nstatus = %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${1:-ok}" \
		>>"$TX_DIR/TXINFO"
	# Keep the last 20 transactions; older ones are pruned.
	#
	# "head -n -20" is a GNU extension. toybox - which is what an Arctic
	# system actually runs - rejects it outright with "head: -n < 0", and
	# since this runs at the end of every single transaction, every install
	# ended with that error printed after its own success line. Count first,
	# then ask for a positive number of lines.
	_tx_keep=20
	_tx_n=$(ls -1d "$ALPM_DB"/snapshots/*/ 2>/dev/null | wc -l | tr -d ' ')
	if [ "${_tx_n:-0}" -gt "$_tx_keep" ]; then
		ls -1d "$ALPM_DB"/snapshots/*/ 2>/dev/null | sort | \
			head -n "$(( _tx_n - _tx_keep ))" | \
			while read -r old; do rm -rf "$old"; done
	fi
}

# ----------------------------------------------------------------------- hooks

run_hooks() {
	[ "$NOMOD" = "1" ] && { info "skipping system hooks (-nomod)"; return 0; }
	msg2 "running system hooks"
	if have ldconfig; then ldconfig 2>/dev/null || :; fi
	for k in "$ALPM_ROOT"/lib/modules/*; do
		[ -d "$k" ] || continue
		have depmod && depmod -a "$(basename "$k")" 2>/dev/null || :
	done
	if [ -n "$HOOK_KERNEL" ]; then
		if have arctic-mkinitramfs; then
			msg2 "regenerating initramfs"
			arctic-mkinitramfs || warn "initramfs generation failed"
		fi
		if have arctic-bootctl; then
			msg2 "updating bootloader entries"
			arctic-bootctl update || warn "bootloader update failed"
		fi
	fi
	have update-desktop-database && update-desktop-database -q 2>/dev/null || :
	have gtk-update-icon-cache && \
		gtk-update-icon-cache -qtf "$ALPM_ROOT/usr/share/icons/hicolor" 2>/dev/null || :
	have makewhatis && makewhatis "$ALPM_ROOT/usr/share/man" 2>/dev/null || :
	:
}

pkg_script() {
	pkgdir=$1 phase=$2 name=$3
	[ -f "$pkgdir/.INSTALL" ] || return 0
	[ "$NOMOD" = "1" ] && return 0
	# The script is sourced in a subshell so a bad hook cannot poison alpm.
	( . "$pkgdir/.INSTALL"
	  if command -v "$phase" >/dev/null 2>&1; then
		msg2 "$name: $phase"
		"$phase" || warn "$name: $phase failed"
	  fi ) || :
}

# ---------------------------------------------------------------------- install

# Fetches one package and leaves the result in FETCH_FILE. Deliberately not
# a function that prints the path for a caller's $(...) to capture: it draws
# a progress bar on stdout, and the two cannot share a channel.
#
# $2 is "package" for something the user actually asked for and "dependency"
# for anything dragged in behind it - the only difference is how the line
# above the bar reads.
FETCH_FILE=""
FETCH_INDEX=1

fetch_pkg() {
	pkg=$1 role=${2:-package}
	entry=$(idx_lookup "$pkg") || die "package not found: $pkg"
	repo=$(printf '%s' "$entry" | cut -f1)
	ver=$(printf '%s' "$entry" | cut -f3)
	rel=$(printf '%s' "$entry" | cut -f4)
	arch=$(printf '%s' "$entry" | cut -f5)
	dlsize=$(printf '%s' "$entry" | cut -f6)
	want=$(printf '%s' "$entry" | cut -f8)
	# name/version/release/arch all end up as path components below (and in
	# the URL fetched from). A repo index is remote input - refuse to build a
	# path out of a field that could walk it somewhere other than
	# ALPM_CACHE/pkg.
	for _c in "$pkg" "$ver" "$rel" "$arch"; do
		safe_component "$_c" || die "package index entry for $pkg has an unsafe field ('$_c') - refusing to fetch"
	done
	file="$pkg-$ver-$rel.$arch.alpmz"
	dest="$ALPM_CACHE/pkg/$file"
	url=$(alpm_repo_url "$repo")
	FETCH_FILE=$dest

	if [ -s "$dest" ]; then
		if [ "$want" = "-" ] || [ "$(sha256 "$dest")" = "$want" ]; then
			ui_cached "$role" "$pkg" "${FETCH_INDEX:-1}"
			return 0
		fi
		warn "cached $file failed checksum, refetching"
		rm -f "$dest"
	fi

	ui_fetch "$role" "$pkg" "$url/$arch/$file" "${dlsize:-0}" "${FETCH_INDEX:-1}"
	dl_bar "$url/$arch/$file" "$dest" "${dlsize:-0}" "$pkg" || die "download failed: $file"
	if [ "$want" != "-" ] && [ "$(sha256 "$dest")" != "$want" ]; then
		rm -f "$dest"
		die "checksum mismatch on $file - refusing to install"
	fi
}

install_one() {
	archive=$1
	tmp="$ALPM_CACHE/build/.unpack.$$"
	rm -rf "$tmp"; mkdir -p "$tmp"
	untar "$archive" "$tmp" || die "cannot unpack $archive"
	[ -f "$tmp/.PKGINFO" ] || die "$archive is not a valid .alpmz (no .PKGINFO)"

	name=$(meta "$tmp/.PKGINFO" name)
	ver=$(meta "$tmp/.PKGINFO" version)
	rel=$(meta "$tmp/.PKGINFO" release)
	deps=$(metaall "$tmp/.PKGINFO" depend | tr '\n' ' ')
	desc=$(meta "$tmp/.PKGINFO" desc)

	# name becomes $ALPM_DB/local/$name below - a .PKGINFO is part of the
	# package payload itself, not something alpm generated, so a hostile
	# .alpmz could otherwise put "../" in its own name and write its database
	# entry (and everything install_one files under $db) outside ALPM_DB.
	safe_component "$name" || die "$archive has an unsafe package name in .PKGINFO ('$name')"

	# File-conflict check against other packages' manifests.
	( cd "$tmp" && find . -type f -o -type l ) | sed 's|^\.||' | \
		grep -v '^/\.\(PKGINFO\|INSTALL\|FILES\)$' >"$tmp.files"
	: >"$tmp.takeover"
	while read -r f; do
		[ -n "$f" ] || continue
		[ -e "$ALPM_ROOT$f" ] || continue
		owner=$(grep -rlx "$f" "$ALPM_DB"/local/*/FILES 2>/dev/null | head -1) || :
		if [ -n "$owner" ]; then
			o=$(basename "$(dirname "$owner")")
			[ "$o" = "$name" ] && continue
			# Identical content is not a conflict worth refusing over. Two
			# packages shipping the same file byte-for-byte - libressl and
			# ca-certificates both installing /etc/ssl/cert.pem, which
			# stopped any transaction containing ca-certificates - leaves
			# nothing to disagree about: hand the path to the incoming
			# package and take it off the old owner's manifest, so exactly
			# one package still owns it and removing the other does not take
			# the file with it.
			if same_file "$tmp$f" "$ALPM_ROOT$f"; then
				printf '%s\t%s\n' "$o" "$f" >>"$tmp.takeover"
				continue
			fi
			die "file conflict: $f is owned by $o
  both would install a different $f - remove $o first, or report it if
  they are meant to coexist"
		fi
	done <"$tmp.files"

	old=""
	if is_installed "$name"; then
		old=$(installed_version "$name")
		# Kept aside because the database entry is replaced below, and the
		# old manifest is what says which files this upgrade drops.
		cp -f "$ALPM_DB/local/$name/FILES" "$tmp.oldfiles" 2>/dev/null || :
	fi

	kind=$(meta "$tmp/.PKGINFO" kind)
	if [ "$kind" = "profile" ]; then
		printf '%sWARNING: This is a profile package it installs more than one package and configures it rather than being a basic installation.%s\n' \
			"$A_AMB$C_B" "$C_R"
	fi

	# The version detail line belongs to the default style only - apt says
	# "Setting up <pkg> (<version>) ..." and aeryn prints the version in its
	# own status line, so printing it here as well just doubles it.
	if [ -n "$old" ]; then
		[ "$ALPM_STYLE" = arctic ] && \
			printf '    %s%s %s -> %s-%s%s\n' "$A_GREY" "$name" "$old" "$ver" "$rel" "$C_R"
		pkg_script "$tmp" pre_upgrade "$name"
	else
		[ "$ALPM_STYLE" = arctic ] && \
			printf '    %s%s %s-%s%s\n' "$A_GREY" "$name" "$ver" "$rel" "$C_R"
		pkg_script "$tmp" pre_install "$name"
	fi

	# Snapshot anything we are about to replace, then lay the payload down.
	while read -r f; do
		[ -n "$f" ] || continue
		if [ -e "$ALPM_ROOT$f" ]; then tx_save "$f"; else tx_added "$f"; fi
	done <"$tmp.files"

	rm -f "$tmp/.PKGINFO.keep"
	cp -a "$tmp/.PKGINFO" "$tmp.PKGINFO"
	[ -f "$tmp/.INSTALL" ] && cp -a "$tmp/.INSTALL" "$tmp.INSTALL"
	rm -f "$tmp/.PKGINFO" "$tmp/.INSTALL" "$tmp/.FILES"

	if have bsdtar; then
		( cd "$tmp" && bsdtar -cf - . ) | ( cd "$ALPM_ROOT" && bsdtar -xpf - )
	else
		( cd "$tmp" && tar -cf - . ) | ( cd "$ALPM_ROOT" && tar -xpf - )
	fi
	fix_usrmerge "$ALPM_ROOT"

	# Record it.
	#
	# The whole entry is assembled beside the real one and moved into place at
	# the end, with PKGINFO - the file is_installed() keys off - written last
	# of all. Written straight into $ALPM_DB/local/$name, an install that died
	# or was interrupted anywhere in here left a half-built directory behind
	# that every later command counted as an installed package: `alpm ins vim`
	# would say vim was already there, `alpm deps vim` died on the DEPS file
	# that never got written, and the resolver marked it satisfied for
	# everything that needed it. Assembling to the side also means a failed
	# upgrade leaves the *old* entry intact instead of a broken one.
	db="$ALPM_DB/local/$name"
	dbnew="$ALPM_DB/local/.incoming-$name"
	rm -rf "$dbnew"; mkdir -p "$dbnew"
	[ -f "$tmp.INSTALL" ] && cp -a "$tmp.INSTALL" "$dbnew/INSTALL"
	cp -a "$tmp.files" "$dbnew/FILES"
	# "-" is the index's placeholder for "no dependencies", not a package.
	# Written through to DEPS verbatim, it made every dependency-free package
	# permanently unsatisfied: `alpm doctor` reported "1 unsatisfied" on a
	# perfectly healthy system and pointed at a package named "-".
	: >"$dbnew/DEPS"
	for _d in $deps; do
		[ "$_d" = "-" ] && continue
		printf '%s\n' "$_d" >>"$dbnew/DEPS"
	done
	printf 'installed = %s\nsize = %s\ntx = %s\n' \
		"$(date '+%Y-%m-%d %H:%M:%S')" "$(wc -c <"$archive")" "$TX" >"$dbnew/STATE"
	[ "$NOMOD" = "1" ] && printf 'activated = no\n' >>"$dbnew/STATE"
	if [ -f "$db/REASON" ]; then cp -a "$db/REASON" "$dbnew/REASON"
	else printf '%s\n' "${REASON:-explicit}" >"$dbnew/REASON"; fi

	# Per-file checksums, so 'alpm verify' can detect tampering or bit rot.
	: >"$dbnew/HASHES"
	while read -r f; do
		[ -f "$ALPM_ROOT$f" ] || continue
		printf '%s  %s\n' "$(sha256 "$ALPM_ROOT$f")" "$f" >>"$dbnew/HASHES"
	done <"$tmp.files"

	cp -a "$tmp.PKGINFO" "$dbnew/PKGINFO"
	tx_db_save "$name"
	rm -rf "$db"
	mv "$dbnew" "$db"

	# On an upgrade, remove what the old version owned and the new one does
	# not. Nothing did this before, so a package that stopped shipping a file
	# left it on disk owned by nobody - libressl dropping /etc/ssl/cert.pem
	# would otherwise leave the stale bundle sitting there, still shadowing
	# the one ca-certificates installs. Saved to the transaction first, so
	# rollback puts them back.
	if [ -n "$old" ] && [ -s "$tmp.oldfiles" ]; then
		while read -r _st_f; do
			[ -n "$_st_f" ] || continue
			grep -qxF "$_st_f" "$db/FILES" 2>/dev/null && continue
			[ -e "$ALPM_ROOT$_st_f" ] || [ -L "$ALPM_ROOT$_st_f" ] || continue
			tx_save "$_st_f"
			rm -f "$ALPM_ROOT$_st_f"
			info "removed $_st_f (no longer in $name $ver-$rel)"
		done <"$tmp.oldfiles"
	fi
	rm -f "$tmp.oldfiles"

	# Ownership of any identical file handed over above.
	if [ -s "$tmp.takeover" ]; then
		while IFS='	' read -r _to_o _to_f; do
			[ -n "$_to_o" ] || continue
			_to_m="$ALPM_DB/local/$_to_o/FILES"
			[ -f "$_to_m" ] || continue
			grep -vxF "$_to_f" "$_to_m" >"$_to_m.new" 2>/dev/null && \
				mv -f "$_to_m.new" "$_to_m"
			info "$_to_f: now owned by $name, was $_to_o"
		done <"$tmp.takeover"
	fi

	if [ -n "$old" ]; then pkg_script "$db" post_upgrade "$name"
	else pkg_script "$db" post_install "$name"; fi

	case "$name" in *kernel*|linux-*) HOOK_KERNEL=1 ;; esac
	printf '%s %s-%s\n' "$name" "$ver" "$rel" >>"$TX_DIR/packages"
	alpm_log "install $name $ver-$rel nomod=$NOMOD"

	rm -rf "$tmp" "$tmp.files" "$tmp.PKGINFO" "$tmp.INSTALL" "$tmp.takeover" "$tmp.oldfiles"
}

cmd_ins() {
	need_root; alpm_init_db
	[ $# -gt 0 ] || die "no packages named. See 'alpm' for usage."

	if [ "$SOURCE" = "1" ]; then cmd_ins_source "$@"; return; fi

	# Nothing below can tell "there is no binary for this" from "no index has
	# been read yet" once it is past this point, and the difference decides
	# whether a package gets offered for compilation. Stop here instead: an
	# unsynced system offering to compile something the repo has a binary for
	# is the whole bug.
	ls "$ALPM_DB"/sync/*.idx >/dev/null 2>&1 || 		die "no repository index on this system - run 'alpm fetch all' first"

	requested="$*"
	ui_reading

	# Sort the requested names into three groups before anything else: ones a
	# synced repo has a binary for, ones only the ports tree has a recipe for,
	# and ones nothing has ever heard of. A package with a binary is never
	# offered for compilation, whatever the ports tree says about it.
	need_build=""; keep=""
	for p in "$@"; do
		if idx_lookup "$p" >/dev/null 2>&1 || is_installed "$p"; then
			keep="$keep $p"; continue
		fi
		if ports_have "$p"; then
			printf "\n  %sno binary for '%s' in any synced repository - only a source recipe.%s\n" \
				"$A_AMB$C_B" "$p" "$C_R"
			printf '  %scompiling it here can take anywhere from seconds to hours.%s\n\n' \
				"$A_GREY" "$C_R"
			printf '  %sCompile it now? [Y/n]%s ' "$C_B" "$C_R"
			if [ "${ALPM_YES:-0}" = "1" ]; then
				printf 'y\n'
				ans=y
			# Read from the terminal so the prompt still works when stdin is a
			# pipe. The braces matter: a failed redirect is reported by the
			# shell itself, so redirecting only read's stderr would not
			# suppress it on a machine with no controlling terminal.
			elif { read -r ans </dev/tty; } 2>/dev/null; then
				:
			else
				read -r ans 2>/dev/null || ans=n
			fi
			case "$ans" in
			n|N|no|NO|No) printf '\n'; msg "skipping $p" ;;
			*)            need_build="$need_build $p" ;;
			esac
			continue
		fi
		die "package not found: $p$(not_found_hint)"
	done

	# Anything with only a recipe goes through the source path.
	if [ -n "$need_build" ]; then
		# shellcheck disable=SC2086
		cmd_ins_source $need_build
	fi

	# Only the packages we actually have binaries for continue from here.
	# shellcheck disable=SC2086
	set -- $keep
	[ $# -gt 0 ] || { [ -n "$need_build" ] || msg "nothing to do"; return 0; }

	# shellcheck disable=SC2086
	resolve_targets $keep
	if [ -s "$RES_DIR/missing" ]; then
		# Name what wanted it. "package not found: wayland" on its own, in the
		# middle of installing something else entirely, tells you nothing
		# about which package needs wayland or what to do next.
		while read -r m; do
			[ -n "$m" ] || continue
			by=$(_needed_by "$m")
			if [ -n "$by" ] && [ "$by" != "$m" ]; then
				err "$by needs $m, and no synced repository has it"
			else
				err "package not found: $m$(not_found_hint)"
			fi
			if ports_have "$m"; then
				printf "  %sthere is a recipe for it: alpm ins -s %s%s\n" "$A_GREY" "$m" "$C_R" >&2
			fi
		done <"$RES_DIR/missing"
		die "unresolved dependencies - nothing was installed"
	fi

	# Split the resolved set into what is already satisfied and what actually
	# has to be fetched. An installed package at the version the index offers
	# is a met dependency, not a reinstall - re-fetching glibc every time
	# something depends on it is exactly what this avoids.
	todo=""; met=""
	while read -r p; do
		[ -n "$p" ] || continue
		if is_installed "$p"; then
			cur=$(installed_version "$p")
			e=$(idx_lookup "$p") || { met="$met $p"; continue; }
			nv="$(printf '%s' "$e" | cut -f3)-$(printf '%s' "$e" | cut -f4)"
			[ "$cur" = "$nv" ] && { met="$met $p"; continue; }
		fi
		todo="$todo $p"
	done <"$RES_DIR/order"

	if [ -z "$todo" ]; then
		for p in $met; do
			case " $requested " in
			*" $p "*) info "$p $(installed_version "$p") is already installed" ;;
			esac
		done
		msg "nothing to do"
		return 0
	fi

	n=0; total=0; isize=0
	for p in $todo; do
		e=$(idx_lookup "$p") || continue
		total=$(( total + $(printf '%s' "$e" | cut -f6) ))
		isize=$(( isize + $(printf '%s' "$e" | cut -f7) ))
		n=$((n+1))
	done
	ui_summary "$todo" "$met" "$total" "$n" "$isize"
	[ "$NOMOD" = "1" ] && printf '  %sMode:%s           staged (-nomod, not put into place)\n' "$A_AMB" "$C_R"

	# Profile packages are not ordinary packages: they pull in a whole set and
	# then write configuration on top. Say so before anything is downloaded.
	profiles=""
	for p in $todo; do
		e=$(idx_lookup "$p") || continue
		[ "$(printf '%s' "$e" | cut -f1)" = "profile" ] && profiles="$profiles $p"
	done
	if [ -n "$profiles" ]; then
		printf '\n%sWARNING: This is a profile package it installs more than one package and configures it rather than being a basic installation.%s\n' \
			"$A_AMB$C_B" "$C_R"
		printf '\n  %sprofile package(s):%s%s\n' "$A_GREY" "$C_R" "$profiles"
		printf '  %sconfiguration under /etc and in the user home directory will be\n' "$A_GREY"
		printf '  written. Whatever is replaced is saved by the transaction, so\n'
		printf "  'alpm rollback' puts it back.%s\n" "$C_R"
	fi

	printf '\n'
	confirm "$(ui_confirm_text)" || { msg "aborted"; return 1; }
	printf '\n'

	tx_snapshot "before installing:$(printf '%s' "$todo" | cut -c1-60)"
	tx_begin
	HOOK_KERNEL=""
	ndeps=0

	for p in $met; do ui_met "$p"; done

	# Everything is downloaded before anything is installed.
	#
	# Interleaving the two means a transaction that upgrades a library the
	# downloader itself links against strands halfway: upgrade libressl and
	# the curl still on disk is the old one, now missing the soname it was
	# built against, so every remaining package in the same transaction
	# fails to download and the system is left with some of an upgrade
	# applied. Fetching first also means a mirror going away mid-transaction
	# costs nothing - nothing has been touched yet.
	getn=0
	for p in $todo; do
		case " $requested " in
		*" $p "*) role=package ;;
		*)        role=dependency; ndeps=$((ndeps+1)) ;;
		esac
		getn=$((getn+1))
		FETCH_INDEX=$getn
		fetch_pkg "$p" "$role"
		eval "_file_$(printf '%s' "$p" | tr -c 'a-zA-Z0-9' '_')=\$FETCH_FILE"
	done

	ui_phase_install
	insn=0
	for p in $todo; do
		case " $requested " in
		*" $p "*) role=package; REASON=explicit ;;
		*)        role=dependency; REASON=dep ;;
		esac
		eval "_f=\$_file_$(printf '%s' "$p" | tr -c 'a-zA-Z0-9' '_')"
		e=$(idx_lookup "$p") || e=""
		insn=$((insn+1))
		ui_install "$role" "$p" \
			"$(printf '%s' "$e" | cut -f3)-$(printf '%s' "$e" | cut -f4)" \
			"$insn" "$n"
		install_one "$_f"
	done

	run_hooks
	tx_end ok
	printf '\n'
	for p in $requested; do
		is_installed "$p" || continue
		ui_done "$p" "$ndeps" "$TX"
	done
	[ "$ALPM_STYLE" = arctic ] && \
		printf '  %stransaction %s - undo it with: alpm rollback%s\n' "$A_GREY" "$TX" "$C_R"
	:
}

cmd_ins_source() {
	need_root; alpm_init_db
	msg "Source build requested"
	for p in "$@"; do
		recipe=""
		for d in /var/lib/alpm/ports/*/"$p"/recipe "$ALPM_CACHE/src/$p/recipe"; do
			[ -f "$d" ] && { recipe=$d; break; }
		done
		if [ -z "$recipe" ]; then
			# Recipes come from the ports tree, which is not one of the
			# repositories in repos.d and does not share their layout: it is
			# ALL/<ports-repo>/<name>/recipe, so the ports repo the package
			# lives under has to be looked up before the URL can be built.
			# The old code asked repos.d for a "source" repo and fetched
			# <url>/recipes/<name>/recipe, a path that does not exist on that
			# host - and since a static host answers a missing file with its
			# own index page rather than a 404, the download "succeeded" and
			# left an HTML document sitting where the recipe should be.
			safe_component "$p" || die "invalid package name: $p"
			msg2 "fetching the recipe for $p from the ports tree"
			pr=$(ports_repo_of "$p") || die "no source recipe for $p"
			mkdir -p "$ALPM_CACHE/src/$p"
			dlq "$ALPM_PORTS/$pr/$p/recipe" "$ALPM_CACHE/src/$p/recipe" || \
				die "no source recipe for $p"
			looks_like_recipe "$ALPM_CACHE/src/$p/recipe" || {
				rm -f "$ALPM_CACHE/src/$p/recipe"
				die "what the ports tree returned for $p is not a recipe"; }
			recipe="$ALPM_CACHE/src/$p/recipe"
		fi
		msg2 "building $p from $recipe"
		alpm_build_tool "$recipe" || die "build of $p failed"
		# The same directory alpm-build writes to. Hardcoding
		# $ALPM_CACHE/build/out meant that whenever ALPM_BUILDROOT pointed
		# anywhere else - which is exactly what the batch builds and any
		# scratch root do - the build succeeded, wrote its .alpmz, and then
		# `alpm ins -s` said "build produced no package" and threw it away.
		out=$(ls -t "${ALPM_BUILDROOT:-$ALPM_CACHE/build}/out/$p"-*.alpmz 2>/dev/null | head -1)
		[ -n "$out" ] || die "build produced no package for $p"
		tx_begin; HOOK_KERNEL=""; REASON=explicit
		install_one "$out"
		run_hooks; tx_end ok
		ok "$p built from source and installed"
	done
}

cmd_reins() {
	need_root; alpm_init_db
	tx_begin; HOOK_KERNEL=""
	for p in "$@"; do
		is_installed "$p" || die "$p is not installed"
		fetch_pkg "$p" package
		REASON=$(cat "$ALPM_DB/local/$p/REASON" 2>/dev/null || echo explicit)
		install_one "$FETCH_FILE"
	done
	run_hooks; tx_end ok
	ok "reinstalled: $*"
}

cmd_commit() {
	need_root
	for p in "$@"; do
		is_installed "$p" || die "$p is not installed"
		grep -q 'activated = no' "$ALPM_DB/local/$p/STATE" 2>/dev/null || {
			info "$p is already in place"; continue; }
		msg2 "activating $p"
		sed -i '/activated = no/d' "$ALPM_DB/local/$p/STATE"
		NOMOD=0
		pkg_script "$ALPM_DB/local/$p" post_install "$p"
		case "$p" in *kernel*|linux-*) HOOK_KERNEL=1 ;; esac
	done
	run_hooks
	ok "activated: $*"
}

# ----------------------------------------------------------------------- remove

remove_files() {
	name=$1
	db="$ALPM_DB/local/$name"
	[ -f "$db/FILES" ] || return 0
	# Files first, then directories deepest-first so empties disappear.
	while read -r f; do
		[ -n "$f" ] || continue
		[ -L "$ALPM_ROOT$f" ] || [ -f "$ALPM_ROOT$f" ] || continue
		tx_save "$f"
		rm -f "$ALPM_ROOT$f"
	done <"$db/FILES"
	sed 's|/[^/]*$||' "$db/FILES" | sort -ru | while read -r d; do
		[ -n "$d" ] || continue
		rmdir "$ALPM_ROOT$d" 2>/dev/null || :
	done
}

purge_junk() {
	# Every local here is prefixed _pj_: called directly (not in a subshell)
	# from do_remove()'s own "for p in ..." package loop, and a plain "p" used
	# to double as this function's own leftover-path loop variable too -
	# do_remove would come back from purge_junk with its "p" overwritten to
	# the last leftover path checked instead of the package name, so the
	# "rm -rf $ALPM_DB/local/$p" and log line right after it ran against that
	# path instead. The package's own database entry never actually got
	# removed by 'alpm del+junk' - it stayed "installed" with its files gone.
	name=$1
	msg2 "$name: purging leftovers"
	for _pj_p in \
		"$ALPM_ROOT/etc/$name" "$ALPM_ROOT/var/cache/$name" \
		"$ALPM_ROOT/var/lib/$name" "$ALPM_ROOT/var/log/$name" \
		"$ALPM_ROOT/usr/share/$name"
	do
		[ -e "$_pj_p" ] && { info "removing $_pj_p"; rm -rf "$_pj_p"; }
	done
	# .alpmnew / .alpmsave files left by config merges.
	find "$ALPM_ROOT/etc" -name "*.alpmnew" -o -name "*.alpmsave" 2>/dev/null | \
		while read -r _pj_f; do rm -f "$_pj_f"; done
	rm -f "$ALPM_CACHE/pkg/$name"-*.alpmz
}

find_orphans() {
	for d in "$ALPM_DB"/local/*/; do
		[ -d "$d" ] || continue
		p=$(basename "$d")
		is_installed "$p" || continue
		[ "$(cat "$d/REASON" 2>/dev/null)" = "dep" ] || continue
		needed=0
		for o in "$ALPM_DB"/local/*/DEPS; do
			[ -f "$o" ] || continue
			[ "$(basename "$(dirname "$o")")" = "$p" ] && continue
			if grep -qx "$p" "$o" 2>/dev/null; then needed=1; break; fi
		done
		[ "$needed" = "0" ] && printf '%s\n' "$p"
	done
}

do_remove() {
	withdeps=$1; withjunk=$2; shift 2
	need_root; alpm_init_db
	[ $# -gt 0 ] || die "no packages named."

	for p in "$@"; do
		is_installed "$p" || die "$p is not installed"
	done

	# Refuse to break the system: nothing installed may still depend on a target.
	for p in "$@"; do
		for o in "$ALPM_DB"/local/*/DEPS; do
			[ -f "$o" ] || continue
			on=$(basename "$(dirname "$o")")
			case " $* " in *" $on "*) continue ;; esac
			if grep -qx "$p" "$o" 2>/dev/null; then
				warn "$on depends on $p"
				[ "${ALPM_FORCE:-0}" = "1" ] || \
					die "refusing to break dependencies (use ALPM_FORCE=1 to override)"
			fi
		done
	done

	printf '\n  %sRemoving (%s)%s\n  ' "$C_B" "$#" "$C_R"
	tot=0
	for p in "$@"; do
		printf '%s-%s ' "$p" "$(installed_version "$p")"
		s=$(meta "$ALPM_DB/local/$p/STATE" size 2>/dev/null || echo 0)
		tot=$(( tot + ${s:-0} ))
	done
	printf '\n\n  %sFreed:%s %s\n\n' "$A_GREY" "$C_R" "$(human $tot)"
	confirm "Remove these packages?" || { msg "aborted"; return 1; }

	tx_snapshot "before removing: $*"
	tx_begin
	for p in "$@"; do
		msg2 "removing $p"
		pkg_script "$ALPM_DB/local/$p" pre_remove "$p"
		remove_files "$p"
		pkg_script "$ALPM_DB/local/$p" post_remove "$p"
		[ "$withjunk" = "1" ] && purge_junk "$p"
		tx_db_save "$p"
		rm -rf "$ALPM_DB/local/$p"
		alpm_log "remove $p junk=$withjunk"
	done

	if [ "$withdeps" = "1" ]; then
		orph=$(find_orphans)
		if [ -n "$orph" ]; then
			msg "Orphaned dependencies"
			printf '  %s\n\n' "$(printf '%s' "$orph" | tr '\n' ' ')"
			if confirm "Remove orphaned dependencies too?"; then
				for p in $orph; do
					msg2 "removing orphan $p"
					pkg_script "$ALPM_DB/local/$p" pre_remove "$p"
					remove_files "$p"
					[ "$withjunk" = "1" ] && purge_junk "$p"
					rm -rf "$ALPM_DB/local/$p"
					alpm_log "remove-orphan $p"
				done
			fi
		else
			info "no orphans left behind"
		fi
	fi
	HOOK_KERNEL=""
	run_hooks
	tx_end ok
	ok "done. Transaction ${A_TEAL}$TX${C_R}"
}

cmd_autoremove() {
	need_root
	orph=$(find_orphans)
	[ -n "$orph" ] || { ok "no orphans on this system"; return 0; }
	# shellcheck disable=SC2086
	do_remove 0 1 $orph
}

# -------------------------------------------------------------------------- get

cmd_get() {
	alpm_init_db
	[ $# -gt 0 ] || die "no packages named."
	if [ "$SOURCE" = "1" ]; then
		for p in "$@"; do
			msg "Fetching source for $p"
			safe_component "$p" || die "invalid package name: $p"
			pr=$(ports_repo_of "$p") || die "no recipe for $p in the ports tree"
			e=$(idx_lookup "$p") || die "package not found: $p"
			v=$(printf '%s' "$e" | cut -f3)
			mkdir -p "$p-$v"
			for f in recipe sources.list patches.tar install; do
				dlq "$ALPM_PORTS/$pr/$p/$f" "$p-$v/$f" 2>/dev/null && info "got $f" || :
			done
			# A static host serves its own index page for a file that is not
			# there, so an unchecked "success" leaves HTML in the recipe's
			# place. Nothing below should read that as a recipe.
			looks_like_recipe "$p-$v/recipe" || {
				rm -f "$p-$v/recipe"
				die "what the ports tree returned for $p is not a recipe"; }
			# Pull the upstream tarballs the recipe names.
			if [ -f "$p-$v/sources.list" ]; then
				while read -r nm url; do
					[ -n "$nm" ] || continue
					msg2 "fetching $nm"
					dl "$url" "$p-$v/$nm" || warn "failed: $nm"
				done <"$p-$v/sources.list"
			fi
			ok "source for $p in ./$p-$v"
		done
		return 0
	fi
	for p in "$@"; do
		msg "Fetching $p"
		fetch_pkg "$p" package
		e=$(idx_lookup "$p"); v=$(printf '%s' "$e" | cut -f3)
		d="$p-$v"
		rm -rf "$d"; mkdir -p "$d"
		untar "$FETCH_FILE" "$d"
		ok "contents of $p unpacked into ./$d (nothing was installed)"
		printf '  %s%s files, %s%s\n' "$A_GREY" \
			"$(find "$d" -type f | wc -l)" "$(du -sh "$d" | cut -f1)" "$C_R"
	done
}

# ------------------------------------------------------------------------ fetch

sync_repo() {
	name=$1 url=$2
	idx="$ALPM_DB/sync/$name.idx"
	tmp="$ALPM_DB/sync/.$name.new"
	old="$ALPM_DB/sync/.$name.old"

	# The line is written before the transfer starts and rewritten when it
	# finishes, so a slow or dead mirror is visibly *being waited on* rather
	# than the whole command sitting silent and then printing a verdict.
	printf '  %s->%s %-14s %sfetching...%s' "$A_ICE$C_B" "$C_R" "$name" "$A_GREY" "$C_R"

	if ! dlq "$url/$ARCH/INDEX" "$tmp" 2>/dev/null; then
		rm -f "$tmp"
		printf '\r  %s->%s %-14s %sunreachable%s   \n' \
			"$A_ICE$C_B" "$C_R" "$name" "$A_RED" "$C_R"
		# The one failure worth naming: an https repo on a system with no
		# TLS-capable downloader fails identically to a mirror being down,
		# and the fix is completely different.
		case "$url" in
		https://*) have curl || printf '     %sno https support here - curl is not installed%s\n' \
			"$A_GREY" "$C_R" ;;
		esac
		return 1
	fi

	[ -f "$idx" ] && cp -f "$idx" "$old" 2>/dev/null || : >"$old"
	# Strip comments and blank lines; keep it a clean TSV.
	grep -v '^#' "$tmp" | grep -v '^[[:space:]]*$' >"$idx" || :
	bytes=$(wc -c <"$tmp" | tr -d ' ')
	rm -f "$tmp"
	printf '%s\n' "$url" >"$ALPM_DB/sync/$name.url"

	c=$(wc -l <"$idx" | tr -d ' ')
	# What actually changed, rather than just how many lines came back. An
	# index that is byte-for-byte what it was last time is worth saying so.
	# Plain temp files, not "comm -13 <(...) <(...)": process substitution is
	# a bashism and this has to run under busybox ash.
	cut -f1 "$old" | sort -u >"$old.n"
	cut -f1 "$idx" | sort -u >"$idx.n"
	cut -f1,2,3 "$old" | sort -u >"$old.v"
	cut -f1,2,3 "$idx" | sort -u >"$idx.v"
	added=$(comm -13 "$old.n" "$idx.n" 2>/dev/null | wc -l | tr -d ' ')
	gone=$(comm -23 "$old.n" "$idx.n" 2>/dev/null | wc -l | tr -d ' ')
	upd=$(comm -13 "$old.v" "$idx.v" 2>/dev/null | wc -l | tr -d ' ')
	upd=$(( ${upd:-0} - ${added:-0} )); [ "$upd" -lt 0 ] && upd=0
	rm -f "$old" "$old.n" "$old.v" "$idx.n" "$idx.v"

	detail=""
	[ "${added:-0}" -gt 0 ] && detail="$detail +$added new"
	[ "${upd:-0}" -gt 0 ]   && detail="$detail $upd updated"
	[ "${gone:-0}" -gt 0 ]  && detail="$detail $gone removed"
	[ -n "$detail" ] || detail=" unchanged"

	printf '\r  %s->%s %-14s %sok%s  %s packages, %s  %s%s%s\n' \
		"$A_ICE$C_B" "$C_R" "$name" "$A_MINT" "$C_R" "$c" "$(human "$bytes")" \
		"$A_GREY" "$detail" "$C_R"
	# cmd_fetch runs this inside a pipeline for "fetch all", which is a
	# subshell - totals go to a file it reads afterwards rather than to
	# variables that would not survive.
	[ -n "${SYNC_TALLY:-}" ] && \
		printf '%s %s %s %s\n' "${added:-0}" "${upd:-0}" "${gone:-0}" "${bytes:-0}" \
			>>"$SYNC_TALLY"
	:
}

cmd_fetch() {
	need_root; alpm_init_db
	which=${1:-all}
	msg "${T_SYNCING:-Synchronizing repositories}"

	# Count what actually succeeded. Reporting "554 packages available" after
	# every repository failed is worse than useless - it reads as success when
	# nothing was reached and the numbers came from a stale cached index.
	okc=0; failc=0
	tmpres=$ALPM_DB/.fetch.$$
	: >"$tmpres"
	SYNC_TALLY=$ALPM_DB/.fetchtally.$$
	: >"$SYNC_TALLY"
	export SYNC_TALLY

	if [ "$which" = "all" ]; then
		alpm_repos | while IFS='	' read -r n u; do
			if sync_repo "$n" "$u"; then echo ok >>"$tmpres"; else echo fail >>"$tmpres"; fi
		done
	else
		for w in "$@"; do
			u=$(alpm_repo_url "$w")
			if [ -z "$u" ]; then
				err "no such repo: $w"; echo fail >>"$tmpres"; continue
			fi
			if sync_repo "$w" "$u"; then echo ok >>"$tmpres"; else echo fail >>"$tmpres"; fi
		done
	fi
	okc=$(grep -c '^ok$'   "$tmpres" 2>/dev/null); okc=${okc:-0}
	failc=$(grep -c '^fail$' "$tmpres" 2>/dev/null); failc=${failc:-0}
	rm -f "$tmpres"
	tadd=0; tupd=0; tgone=0; tbytes=0
	while read -r a u g b; do
		tadd=$(( tadd + ${a:-0} )); tupd=$(( tupd + ${u:-0} ))
		tgone=$(( tgone + ${g:-0} )); tbytes=$(( tbytes + ${b:-0} ))
	done <"$SYNC_TALLY"
	rm -f "$SYNC_TALLY"

	# The ports tree is not a repository - it holds recipes, on its own host,
	# and `alpm ins -s` is the only thing that reads it. It is still worth
	# refreshing and reporting here: "fetch all" that silently ignored it
	# meant `ins -s` was the first thing to discover the ports manifest was
	# missing or stale, in the middle of a build.
	if [ "$which" = "all" ] || [ "$which" = "ports" ]; then
		printf '  %s->%s %-14s %sfetching...%s' "$A_ICE$C_B" "$C_R" "ports" "$A_GREY" "$C_R"
		rm -f "$ALPM_CACHE/ports/manifest.tsv"
		if pm=$(ports_manifest); then
			pc=$(grep -vc '^#' "$pm" 2>/dev/null | tr -d ' ')
			printf '\r  %s->%s %-14s %sok%s  %s recipes  %ssource builds: alpm ins -s <pkg>%s\n' \
				"$A_ICE$C_B" "$C_R" "ports" "$A_MINT" "$C_R" "${pc:-0}" "$A_GREY" "$C_R"
		else
			printf '\r  %s->%s %-14s %sunreachable%s   %s(%s)%s\n' \
				"$A_ICE$C_B" "$C_R" "ports" "$A_RED" "$C_R" "$A_GREY" "$ALPM_PORTS" "$C_R"
		fi
	fi

	tot=$(cat "$ALPM_DB"/sync/*.idx 2>/dev/null | wc -l | tr -d ' ')
	printf '\n'

	if [ "$okc" = "0" ] && [ "$failc" -gt 0 ]; then
		warn "no repository could be reached"
		if [ "${tot:-0}" -gt 0 ]; then
			printf '  %s%s package(s) are known from the last sync, which may be out\n' \
				"$A_GREY" "$tot"
			printf '  of date. Anything already on this medium can still be installed.%s\n' "$C_R"
		fi
		printf '  %scheck the network:  ip addr   ping 1.1.1.1   nmtui%s\n' "$A_GREY" "$C_R"
		alpm_log "fetch failed: no repository reachable"
		return 1
	fi

	if [ "$failc" -gt 0 ]; then
		warn "$failc of $((okc + failc)) repositories could not be reached"
	fi
	if [ "$okc" = "1" ]; then
		ok "$tot packages available from 1 repository"
	else
		ok "$tot packages available from $okc repositories"
	fi
	# What the sync actually changed, not just how many packages exist.
	if [ $(( tadd + tupd + tgone )) -gt 0 ]; then
		printf '  %s%s new, %s updated, %s withdrawn - %s of index downloaded%s\n' \
			"$A_GREY" "$tadd" "$tupd" "$tgone" "$(human "$tbytes")" "$C_R"
	else
		printf '  %severy index was already up to date (%s downloaded)%s\n' \
			"$A_GREY" "$(human "$tbytes")" "$C_R"
	fi
	alpm_log "fetch $* ok=$okc fail=$failc"

	# Tell the user if upgrades are waiting, but do not act on it.
	up=0
	for d in "$ALPM_DB"/local/*/; do
		[ -d "$d" ] || continue
		p=$(basename "$d"); is_held "$p" && continue
		e=$(idx_lookup "$p") || continue
		nv="$(printf '%s' "$e" | cut -f3)-$(printf '%s' "$e" | cut -f4)"
		[ "$(installed_version "$p")" != "$nv" ] && up=$((up+1))
	done
	[ "$up" -gt 0 ] && msg "$up package(s) can be upgraded - run 'alpm update'"
	return 0
}

# ----------------------------------------------------------------------- update

cmd_update() {
	need_root; alpm_init_db
	if [ $# -gt 0 ]; then cmd_ins "$@"; return; fi
	msg "Checking for upgrades"
	todo=""
	for d in "$ALPM_DB"/local/*/; do
		[ -d "$d" ] || continue
		p=$(basename "$d")
		if is_held "$p"; then info "$p is held back"; continue; fi
		e=$(idx_lookup "$p") || continue
		cur=$(installed_version "$p")
		nv="$(printf '%s' "$e" | cut -f3)-$(printf '%s' "$e" | cut -f4)"
		[ "$cur" = "$nv" ] && continue
		printf '  %s%-24s%s %s -> %s%s%s\n' "$C_B" "$p" "$C_R" "$cur" "$A_MINT" "$nv" "$C_R"
		todo="$todo $p"
	done
	[ -n "$todo" ] || { ok "system is up to date"; return 0; }
	printf '\n'
	# shellcheck disable=SC2086
	cmd_ins $todo
}

# ------------------------------------------------------------------------ repos

cmd_addrepo() {
	need_root; alpm_init_db
	url=${1:-}
	[ -n "$url" ] || die "usage: alpm add repo <url>"
	case "$url" in http://*|https://*|ftp://*|file://*) ;; *) url="https://$url" ;; esac
	name=$(basename "$url" | sed 's/^arctic-//; s/-repo$//; s/\..*$//')
	[ -n "$name" ] || name=custom
	f="$ALPM_REPOD/$name.repo"
	mkdir -p "$ALPM_REPOD"
	[ -f "$f" ] && die "repo '$name' already exists ($f)"
	cat >"$f" <<EOF
# added by alpm on $(date '+%Y-%m-%d')
name = $name
url = $url
enabled = yes
priority = 50
EOF
	ok "added repo '$name' -> $url"
	msg2 "syncing it now"
	sync_repo "$name" "$url" || warn "could not reach $url yet"
}

cmd_delrepo() {
	need_root
	n=${1:-}; [ -n "$n" ] || die "usage: alpm del repo <name>"
	f="$ALPM_REPOD/$n.repo"
	[ -f "$f" ] || die "no such repo: $n"
	rm -f "$f" "$ALPM_DB/sync/$n.idx" "$ALPM_DB/sync/$n.url"
	ok "removed repo '$n'"
}

cmd_listrepos() {
	printf '\n  %s%-14s %-9s %-8s %s%s\n' "$C_B" "REPO" "PACKAGES" "PRIORITY" "URL" "$C_R"
	for f in "$ALPM_REPOD"/*.repo; do
		[ -f "$f" ] || continue
		n=$(meta "$f" name); u=$(meta "$f" url)
		pr=$(meta "$f" priority); en=$(meta "$f" enabled)
		[ -n "$n" ] || n=$(basename "$f" .repo)
		c=0; [ -f "$ALPM_DB/sync/$n.idx" ] && c=$(wc -l <"$ALPM_DB/sync/$n.idx" | tr -d ' ')
		col=$A_MINT; [ "$en" = "no" ] && col=$A_GREY
		printf '  %s%-14s%s %-9s %-8s %s%s%s\n' \
			"$col" "$n" "$C_R" "$c" "${pr:-50}" "$A_GREY" "$u" "$C_R"
	done
	printf '\n'
}

cmd_mirror() {
	repo=${1:-main}
	f="$ALPM_REPOD/$repo.repo"
	[ -f "$f" ] || die "no such repo: $repo"
	msg "Timing mirrors for $repo"
	metaall "$f" mirror | while read -r m; do
		[ -n "$m" ] || continue
		s=$(date '+%s%N' 2>/dev/null || echo 0)
		if dlq "$m/$ARCH/INDEX" /dev/null 2>/dev/null; then
			e=$(date '+%s%N' 2>/dev/null || echo 0)
			ms=$(( (e - s) / 1000000 ))
			printf '  %s%6s ms%s  %s\n' "$A_MINT" "$ms" "$C_R" "$m"
		else
			printf '  %s   down%s   %s\n' "$A_RED" "$C_R" "$m"
		fi
	done
}

# ---------------------------------------------------------------------- queries

cmd_list() {
	only_explicit=0
	[ "${1:-}" = "-e" ] && only_explicit=1
	n=0; tot=0
	printf '\n'
	for d in "$ALPM_DB"/local/*/; do
		[ -d "$d" ] || continue
		p=$(basename "$d")
		# A directory with no PKGINFO is a half-written entry, not a package
		# (see is_installed) - listing it prints a name with no version and
		# counts it in the totals. 'alpm doctor' is where those get cleaned up.
		is_installed "$p" || continue
		r=$(cat "$d/REASON" 2>/dev/null || echo explicit)
		[ "$only_explicit" = "1" ] && [ "$r" != "explicit" ] && continue
		v=$(installed_version "$p")
		s=$(meta "$d/STATE" size 2>/dev/null || echo 0); tot=$(( tot + ${s:-0} ))
		mark=" "; [ "$r" = "dep" ] && mark="${A_GREY}d${C_R}"
		is_held "$p" && mark="${A_AMB}h${C_R}"
		grep -q 'activated = no' "$d/STATE" 2>/dev/null && mark="${A_VIO}s${C_R}"
		printf '  %s %s%-28s%s %s\n' "$mark" "$A_SNOW" "$p" "$C_R" "$v"
		n=$((n+1))
	done
	printf '\n  %s%s packages, %s%s\n' "$A_GREY" "$n" "$(human $tot)" "$C_R"
	printf '  %sd = dependency  h = held  s = staged (-nomod)%s\n\n' "$A_GREY" "$C_R"
}

cmd_index() {
	r=${1:-}
	printf '\n  %s%-24s %-14s %-11s %s%s\n' "$C_B" "PACKAGE" "VERSION" "REPO" "DESCRIPTION" "$C_R"
	for f in "$ALPM_DB"/sync/*.idx; do
		[ -f "$f" ] || continue
		rn=$(basename "$f" .idx)
		[ -n "$r" ] && [ "$r" != "$rn" ] && continue
		awk -F'\t' -v rn="$rn" -v c1="$A_SNOW" -v c0="$C_R" -v cg="$A_GREY" \
			'{printf "  %s%-24s%s %-14s %-11s %s%.40s%s\n", c1,$1,c0,$2"-"$3,rn,cg,$9,c0}' "$f"
	done
	printf '\n'
}

cmd_search() {
	pat=${1:-}
	[ -n "$pat" ] || die "usage: alpm search <pattern>"
	found=0
	printf '\n'
	for f in "$ALPM_DB"/sync/*.idx; do
		[ -f "$f" ] || continue
		rn=$(basename "$f" .idx)
		while IFS='	' read -r nm ver rel arch sz isz sha deps desc; do
			case "$nm$desc" in
			*"$pat"*)
				st=""
				is_installed "$nm" && st=" ${A_MINT}[installed]${C_R}"
				printf '  %s%s/%s%s%s %s%s%s\n' "$A_VIO" "$rn" "$A_SNOW$C_B" "$nm" "$C_R" \
					"$A_TEAL" "$ver-$rel" "$C_R$st"
				printf '      %s%s%s\n' "$A_GREY" "$desc" "$C_R"
				found=$((found+1)) ;;
			esac
		done <"$f"
	done
	[ "$found" = "0" ] && { printf '  no match for %s\n\n' "$pat"; return 1; }
	printf '\n  %s%s result(s)%s\n\n' "$A_GREY" "$found" "$C_R"
}

cmd_info() {
	p=${1:-}; [ -n "$p" ] || die "usage: alpm info <pkg>"
	printf '\n'
	if is_installed "$p"; then
		d="$ALPM_DB/local/$p"
		row() { printf '  %s%-16s%s %s\n' "$C_B" "$1" "$C_R" "$2"; }
		row Name "$p"
		row Version "$(installed_version "$p")"
		row Description "$(meta "$d/PKGINFO" desc)"
		row URL "$(meta "$d/PKGINFO" url)"
		row License "$(meta "$d/PKGINFO" license)"
		row Architecture "$(meta "$d/PKGINFO" arch)"
		row Depends "$(tr '\n' ' ' <"$d/DEPS" 2>/dev/null)"
		row "Installed" "$(meta "$d/STATE" installed)"
		row "Install size" "$(human "$(meta "$d/STATE" size 2>/dev/null || echo 0)")"
		row Files "$(wc -l <"$d/FILES" | tr -d ' ')"
		row Reason "$(cat "$d/REASON" 2>/dev/null)"
		is_held "$p" && row Held yes
		grep -q 'activated = no' "$d/STATE" 2>/dev/null && \
			row Staged "yes - not in place, run 'alpm commit $p'"
		rd=$(cmd_rdeps "$p" 2>/dev/null | tr '\n' ' ')
		row "Required by" "${rd:-nothing}"
	else
		e=$(idx_lookup "$p") || die "package not found: $p"
		row() { printf '  %s%-16s%s %s\n' "$C_B" "$1" "$C_R" "$2"; }
		row Repository "$(printf '%s' "$e" | cut -f1)"
		row Name "$p"
		row Version "$(printf '%s' "$e" | cut -f3)-$(printf '%s' "$e" | cut -f4)"
		row Architecture "$(printf '%s' "$e" | cut -f5)"
		row "Download size" "$(human "$(printf '%s' "$e" | cut -f6)")"
		row "Install size" "$(human "$(printf '%s' "$e" | cut -f7)")"
		row Depends "$(printf '%s' "$e" | cut -f9)"
		row Description "$(printf '%s' "$e" | cut -f10)"
		row Status "not installed"
	fi
	printf '\n'
}

cmd_files() {
	p=${1:-}; [ -n "$p" ] || die "usage: alpm files <pkg>"
	is_installed "$p" || die "$p is not installed"
	cat "$ALPM_DB/local/$p/FILES"
}

cmd_owns() {
	path=${1:-}; [ -n "$path" ] || die "usage: alpm owns <path>"
	# Resolve to an absolute path the way the database stores it.
	case "$path" in
	/*) ;;
	*) w=$(command -v "$path" 2>/dev/null) && path=$w || path="$(pwd)/$path" ;;
	esac
	hit=0
	for f in "$ALPM_DB"/local/*/FILES; do
		[ -f "$f" ] || continue
		if grep -qx "$path" "$f" 2>/dev/null; then
			p=$(basename "$(dirname "$f")")
			printf '  %s is owned by %s%s %s%s\n' "$path" "$A_SNOW$C_B" "$p" \
				"$(installed_version "$p")" "$C_R"
			hit=1
		fi
	done
	# Not a bare "[ ... ] && { ... }" as the last command: when the file *was*
	# found the test is false, so the function returned 1 and `alpm owns`
	# exited non-zero having just printed the right answer.
	if [ "$hit" = "0" ]; then
		err "no package owns $path"
		return 1
	fi
	return 0
}

_dt_seen=""
_deptree() {
	local p ind st deps d
	p=$1 ind=$2
	case " $_dt_seen " in *" $p "*)
		printf '%s%s%s %s(already shown)%s\n' "$ind" "$A_GREY" "$p" "$A_GREY" "$C_R"
		return 0 ;;
	esac
	_dt_seen="$_dt_seen $p"
	st=""
	is_installed "$p" && st=" ${A_MINT}*${C_R}"
	printf '%s%s%s%s\n' "$ind" "$A_SNOW" "$p" "$C_R$st"
	deps=""
	if is_installed "$p"; then deps=$({ tr '\n' ' ' <"$ALPM_DB/local/$p/DEPS"; } 2>/dev/null || :)
	else e=$(idx_lookup "$p") 2>/dev/null && deps=$(printf '%s' "$e" | cut -f9); fi
	for d in $deps; do
		[ "$d" = "-" ] && continue
		_deptree "$d" "$ind  "
	done
}

cmd_deps() {
	p=${1:-}; [ -n "$p" ] || die "usage: alpm deps <pkg>"
	printf '\n'; _dt_seen=""; _deptree "$p" "  "
	printf '\n  %s* = installed%s\n\n' "$A_GREY" "$C_R"
}

cmd_rdeps() {
	p=${1:-}; [ -n "$p" ] || die "usage: alpm rdeps <pkg>"
	for f in "$ALPM_DB"/local/*/DEPS; do
		[ -f "$f" ] || continue
		grep -qx "$p" "$f" 2>/dev/null && basename "$(dirname "$f")"
	done
}

cmd_why() {
	p=${1:-}; [ -n "$p" ] || die "usage: alpm why <pkg>"
	is_installed "$p" || die "$p is not installed"
	r=$(cat "$ALPM_DB/local/$p/REASON" 2>/dev/null)
	printf '\n'
	if [ "$r" = "explicit" ]; then
		printf '  %s%s%s was installed explicitly - you asked for it.\n\n' \
			"$A_SNOW$C_B" "$p" "$C_R"
		return 0
	fi
	printf '  %s%s%s is here as a dependency. Chains that need it:\n\n' \
		"$A_SNOW$C_B" "$p" "$C_R"
	# Walk upward from p to explicitly-installed roots.
	depth=0
	cur="$p"
	while [ "$depth" -lt 12 ]; do
		parents=$(cmd_rdeps "$cur" | tr '\n' ' ')
		[ -n "$parents" ] || break
		printf '    %s%s%s <- %s\n' "$A_TEAL" "$cur" "$C_R" "$parents"
		nxt=""
		for q in $parents; do
			[ "$(cat "$ALPM_DB/local/$q/REASON" 2>/dev/null)" = "explicit" ] && {
				printf '      %sroot: %s (explicit)%s\n' "$A_MINT" "$q" "$C_R"; continue; }
			nxt="$q"
		done
		[ -n "$nxt" ] || break
		cur=$nxt; depth=$((depth+1))
	done
	printf '\n'
}

cmd_orphans() {
	o=$(find_orphans)
	[ -n "$o" ] || { ok "no orphans"; return 0; }
	printf '\n  %sOrphans (nothing depends on these):%s\n\n' "$C_B" "$C_R"
	for p in $o; do printf '    %s %s\n' "$p" "$(installed_version "$p")"; done
	printf '\n  %sremove them with: alpm autoremove%s\n\n' "$A_GREY" "$C_R"
}

cmd_stats() {
	n=0; tot=0; expl=0; dep=0
	for d in "$ALPM_DB"/local/*/; do
		[ -d "$d" ] || continue
		is_installed "$(basename "$d")" || continue
		n=$((n+1))
		s=$(meta "$d/STATE" size 2>/dev/null || echo 0); tot=$(( tot + ${s:-0} ))
		if [ "$(cat "$d/REASON" 2>/dev/null)" = "dep" ]; then dep=$((dep+1)); else expl=$((expl+1)); fi
	done
	printf '\n  %sArctic Linux - package statistics%s\n\n' "$A_TEAL$C_B" "$C_R"
	printf '  %-22s %s\n' "Installed packages" "$n"
	printf '  %-22s %s\n' "  explicit" "$expl"
	printf '  %-22s %s\n' "  dependencies" "$dep"
	printf '  %-22s %s\n' "Total size" "$(human $tot)"
	printf '  %-22s %s\n' "Cache size" "$(du -sh "$ALPM_CACHE" 2>/dev/null | cut -f1)"
	printf '  %-22s %s\n' "Transactions kept" "$(ls -1d "$ALPM_DB"/snapshots/*/ 2>/dev/null | wc -l | tr -d ' ')"
	printf '\n  %sAvailable by repo%s\n' "$C_B" "$C_R"
	for f in "$ALPM_DB"/sync/*.idx; do
		[ -f "$f" ] || continue
		printf '  %-22s %s\n' "  $(basename "$f" .idx)" "$(wc -l <"$f" | tr -d ' ')"
	done
	printf '\n'
}

# ------------------------------------------------------------------ maintenance

cmd_verify() {
	targets=""
	if [ $# -gt 0 ]; then targets="$*"
	else
		for d in "$ALPM_DB"/local/*/; do
			[ -d "$d" ] && targets="$targets $(basename "$d")"
		done
	fi
	bad=0; miss=0; checked=0
	msg "Verifying installed files"
	for p in $targets; do
		h="$ALPM_DB/local/$p/HASHES"
		[ -f "$h" ] || continue
		while read -r want f; do
			[ -n "$f" ] || continue
			checked=$((checked+1))
			if [ ! -e "$ALPM_ROOT$f" ]; then
				printf '  %smissing%s  %s (%s)\n' "$A_RED" "$C_R" "$f" "$p"; miss=$((miss+1))
			elif [ -f "$ALPM_ROOT$f" ] && [ "$(sha256 "$ALPM_ROOT$f")" != "$want" ]; then
				printf '  %saltered%s  %s (%s)\n' "$A_AMB" "$C_R" "$f" "$p"; bad=$((bad+1))
			fi
		done <"$h"
	done
	printf '\n'
	if [ "$bad" = "0" ] && [ "$miss" = "0" ]; then
		ok "$checked files verified, all intact"
	else
		warn "$checked checked: $bad altered, $miss missing"
		printf '  %srepair with: alpm reins <pkg>%s\n' "$A_GREY" "$C_R"
		return 1
	fi
}

cmd_doctor() {
	msg "Arctic system check"
	probs=0
	chk() { printf '  %s%-40s%s ' "$A_SNOW" "$1" "$C_R"; }
	pass() { printf '%sok%s\n' "$A_MINT" "$C_R"; }
	fail() { printf '%s%s%s\n' "$A_RED" "$1" "$C_R"; probs=$((probs+1)); }
	nag()  { printf '%s%s%s\n' "$A_AMB" "$1" "$C_R"; }

	chk "package database readable"
	[ -d "$ALPM_DB/local" ] && pass || fail "missing $ALPM_DB/local"

	chk "repositories configured"
	c=$(alpm_repos | wc -l | tr -d ' ')
	[ "$c" -gt 0 ] && pass || fail "none - use 'alpm add repo'"

	chk "repository indexes present"
	c=$(ls -1 "$ALPM_DB"/sync/*.idx 2>/dev/null | wc -l | tr -d ' ')
	[ "$c" -gt 0 ] && pass || nag "none - run 'alpm fetch all'"

	chk "no half-finished transactions"
	inc=$(grep -L 'finished' "$ALPM_DB"/snapshots/*/TXINFO 2>/dev/null | wc -l | tr -d ' ')
	[ "$inc" = "0" ] && pass || fail "$inc incomplete - consider 'alpm rollback'"

	chk "no half-written database entries"
	part=$(alpm_partials | wc -l | tr -d ' ')
	if [ "$part" = "0" ]; then pass
	else
		fail "$part"
		alpm_partials | while read -r d; do
			printf '    %s%s%s\n' "$A_GREY" "$d" "$C_R"
		done
		if [ "$(id -u)" = "0" ] && confirm "Remove them?"; then
			alpm_partials | while read -r d; do rm -rf "$d"; done
			probs=$((probs-1))
		fi
	fi

	chk "no staged (-nomod) packages pending"
	st=$(grep -l 'activated = no' "$ALPM_DB"/local/*/STATE 2>/dev/null | wc -l | tr -d ' ')
	[ "$st" = "0" ] && pass || nag "$st waiting for 'alpm commit'"

	chk "no broken dependencies"
	broke=0
	for f in "$ALPM_DB"/local/*/DEPS; do
		[ -f "$f" ] || continue
		while read -r d; do
			[ -n "$d" ] || continue
			[ "$d" = "-" ] && continue      # placeholder, see install_one
			is_installed "$d" || { broke=$((broke+1)); }
		done <"$f"
	done
	[ "$broke" = "0" ] && pass || fail "$broke unsatisfied"

	chk "no orphaned packages"
	o=$(find_orphans | wc -l | tr -d ' ')
	[ "$o" = "0" ] && pass || nag "$o - see 'alpm orphans'"

	chk "a kernel is installed and in place"
	k=$(ls -1 "$ALPM_ROOT"/boot/vmlinuz-* 2>/dev/null | wc -l | tr -d ' ')
	[ "$k" -gt 0 ] && pass || fail "no kernel in /boot"

	chk "bootloader present"
	if [ -d "$ALPM_ROOT/boot/EFI" ] || [ -f "$ALPM_ROOT/boot/limine.conf" ]; then pass
	else nag "no limine config found"; fi

	chk "no GNU userland crept in"
	gnu=""
	for b in "$ALPM_ROOT"/bin/ls "$ALPM_ROOT"/bin/cat; do
		[ -e "$b" ] || continue
		"$b" --version 2>/dev/null | grep -qi 'GNU coreutils' && gnu="yes"
	done
	[ -z "$gnu" ] && pass || nag "GNU coreutils detected in /bin"

	chk "free space on /"
	av=$(df -k "$ALPM_ROOT" 2>/dev/null | awk 'NR==2{print $4}')
	if [ "${av:-0}" -gt 524288 ]; then pass; else nag "$(human $((av*1024))) left"; fi

	printf '\n'
	if [ "$probs" = "0" ]; then ok "no problems found"
	else warn "$probs problem(s) need attention"; return 1; fi
}

cmd_clean() {
	need_root
	sz=$(du -sk "$ALPM_CACHE/pkg" 2>/dev/null | cut -f1)
	msg "Cache holds $(human $(( ${sz:-0} * 1024 )))"
	confirm "Delete cached packages?" || return 1
	rm -f "$ALPM_CACHE"/pkg/*.alpmz
	rm -rf "$ALPM_CACHE"/build/*
	ok "cache cleared"
}

cmd_hold() {
	need_root; alpm_init_db
	for p in "$@"; do
		is_installed "$p" || die "$p is not installed"
		: >"$ALPM_DB/hold/$p"; ok "$p held back from upgrades"
	done
}

cmd_unhold() {
	need_root
	for p in "$@"; do rm -f "$ALPM_DB/hold/$p"; ok "$p no longer held"; done
}

cmd_mark() {
	need_root
	p=${1:-}; r=${2:-}
	case "$r" in explicit|dep) ;; *) die "usage: alpm mark <pkg> explicit|dep" ;; esac
	is_installed "$p" || die "$p is not installed"
	printf '%s\n' "$r" >"$ALPM_DB/local/$p/REASON"
	ok "$p marked as $r"
}

# -------------------------------------------------------- snapshots / rollback

cmd_snapshot() {
	need_root; alpm_init_db
	nm=${1:-manual-$(txid)}
	d="$ALPM_DB/snapshots/$nm"
	mkdir -p "$d"
	: >"$d/packages"
	for p in "$ALPM_DB"/local/*/; do
		[ -d "$p" ] || continue
		n=$(basename "$p")
		printf '%s %s %s\n' "$n" "$(installed_version "$n")" \
			"$(cat "$p/REASON" 2>/dev/null)" >>"$d/packages"
	done
	printf 'id = %s\nkind = manual\ncreated = %s\n' "$nm" "$(date '+%Y-%m-%d %H:%M:%S')" \
		>"$d/TXINFO"
	ok "snapshot '$nm' saved ($(wc -l <"$d/packages" | tr -d ' ') packages)"
}

cmd_rollback() {
	need_root
	id=${1:-}
	if [ -z "$id" ]; then
		id=$(ls -1d "$ALPM_DB"/snapshots/*/ 2>/dev/null | sort | tail -1)
		[ -n "$id" ] || die "no transactions to roll back"
		id=$(basename "$id")
	fi
	d="$ALPM_DB/snapshots/$id"
	[ -d "$d" ] || die "no such transaction: $id"

	printf '\n  %sTransaction %s%s\n' "$C_B" "$id" "$C_R"
	[ -f "$d/TXINFO" ] && sed 's/^/    /' "$d/TXINFO"
	if [ -f "$d/packages" ]; then
		printf '\n  %sPackages it touched:%s\n' "$C_B" "$C_R"
		sed 's/^/    /' "$d/packages"
	fi
	na=$(wc -l <"$d/added" 2>/dev/null | tr -d ' ' || echo 0)
	nr=$(find "$d/replaced" -type f 2>/dev/null | wc -l | tr -d ' ')
	ndb=0
	[ -f "$d/db-new" ] && ndb=$(wc -l <"$d/db-new" | tr -d ' ')
	nre=0
	[ -d "$d/db" ] && nre=$(ls -1 "$d/db" 2>/dev/null | wc -l | tr -d ' ')
	printf '\n  rolling back will delete %s new file(s) and restore %s replaced file(s)\n' \
		"$na" "$nr"
	printf '  %s database entry(s) will be removed, %s restored to their previous version\n\n' \
		"$ndb" "$nre"
	confirm "Roll back transaction $id?" || { msg "aborted"; return 1; }

	if [ -f "$d/added" ]; then
		while read -r f; do
			[ -n "$f" ] || continue
			rm -f "$ALPM_ROOT$f" 2>/dev/null || :
		done <"$d/added"
	fi
	if [ -d "$d/replaced" ]; then
		( cd "$d/replaced" && find . -type f -o -type l ) | while read -r rf; do
			t=$(printf '%s' "$rf" | sed 's|^\.||')
			mkdir -p "$(dirname "$ALPM_ROOT$t")"
			cp -a "$d/replaced/$rf" "$ALPM_ROOT$t"
		done
	fi
	# Put the database back to what it described before the transaction.
	#
	# This is what "rollback restores files but not the database" used to
	# mean: every file went back, and then local/ still said the new version
	# was installed - so `alpm list` showed a package whose files had just
	# been deleted, `verify` reported every one of them missing, and the
	# resolver counted it as satisfying dependencies it no longer could.
	# db-new lists packages this transaction created an entry for (delete
	# them); db/ holds the entry each replaced package had before it (put
	# those back verbatim).
	if [ -f "$d/db-new" ]; then
		while read -r n; do
			[ -n "$n" ] || continue
			safe_component "$n" || continue
			rm -rf "$ALPM_DB/local/$n"
			info "database entry for $n removed"
		done <"$d/db-new"
	fi
	if [ -d "$d/db" ]; then
		for e in "$d/db"/*; do
			[ -d "$e" ] || continue
			n=$(basename "$e")
			safe_component "$n" || continue
			rm -rf "$ALPM_DB/local/$n"
			cp -a "$e" "$ALPM_DB/local/$n"
			info "database entry for $n restored to $(installed_version "$n")"
		done
	fi
	# Anything left half-written by the transaction that died is not an
	# install, whatever its directory looks like.
	alpm_partials | while read -r stale; do rm -rf "$stale"; done
	alpm_log "rollback $id"
	HOOK_KERNEL=1; NOMOD=0; run_hooks
	ok "rolled back $id"
}

cmd_log() {
	[ -f "$ALPM_LOG" ] || { info "no log yet"; return 0; }
	printf '\n'
	tail -n "${1:-40}" "$ALPM_LOG" | sed 's/^/  /'
	printf '\n'
	printf '  %stransactions on disk:%s\n' "$C_B" "$C_R"
	for d in "$ALPM_DB"/snapshots/*/; do
		[ -d "$d" ] || continue
		printf '    %s %s\n' "$(basename "$d")" \
			"$(meta "$d/TXINFO" command 2>/dev/null || echo '-')"
	done
	printf '\n'
}

# -------------------------------------------------------------------- dispatch

ALPM_CMDLINE="alpm $*"

# Global flags (-y, -s, -nomod, --root=...) may come before the subcommand,
# after it, or mixed into its own arguments - "alpm -y ins vim" and
# "doas alpm --noconfirm ins vim" are both a completely ordinary way to type
# this, the same as every other package manager. Only requiring them after
# the subcommand meant a flag typed first was read as the subcommand itself
# ("unknown command: -y") and fell through to the help screen instead of
# actually running anything. The first token that is not one of these flags
# becomes the subcommand; everything else is passed through unchanged.
cmd=""
args=""
for a in "$@"; do
	case "$a" in
	-s|--source)  SOURCE=1 ;;
	-nomod|--nomod|--no-modify) NOMOD=1 ;;
	-y|--yes|--noconfirm)
		# Answer every prompt with yes: the install confirmation, the removal
		# confirmation, and the "no binary, compile?" warning. Exported so the
		# source-build path, which re-enters alpm and alpm-build, inherits it.
		ALPM_YES=1; export ALPM_YES ;;
	--force)      ALPM_FORCE=1 ;;
	--root=*)     ALPM_ROOT=${a#--root=} ;;
	*)
		if [ -z "$cmd" ]; then cmd=$a; else args="$args $a"; fi
		;;
	esac
done
# shellcheck disable=SC2086
set -- $args

case "$cmd" in
ins|install|i)      cmd_ins "$@" ;;
reins|reinstall)    cmd_reins "$@" ;;
commit)             cmd_commit "$@" ;;
del|remove|rm)
	case "${1:-}" in
	repo) shift; cmd_delrepo "$@" ;;
	*)    do_remove 0 0 "$@" ;;
	esac ;;
del+deps)           do_remove 1 0 "$@" ;;
del+junk)           do_remove 0 1 "$@" ;;
del+deps+junk|del+junk+deps) do_remove 1 1 "$@" ;;
autoremove)         cmd_autoremove ;;
get)                cmd_get "$@" ;;
fetch|sync)         cmd_fetch "$@" ;;
update|upgrade|up)  cmd_update "$@" ;;
add)
	case "${1:-}" in
	repo) shift; cmd_addrepo "$@" ;;
	*)    die "usage: alpm add repo <url>" ;;
	esac ;;
mirror)             cmd_mirror "$@" ;;
list|ls)
	case "${1:-}" in
	repos|repo) cmd_listrepos ;;
	*)          cmd_list "$@" ;;
	esac ;;
index|avail)        cmd_index "$@" ;;
search|find|s)      cmd_search "$@" ;;
info|show)          cmd_info "$@" ;;
files)              cmd_files "$@" ;;
owns|owner)         cmd_owns "$@" ;;
deps)               cmd_deps "$@" ;;
rdeps)              cmd_rdeps "$@" ;;
why)                cmd_why "$@" ;;
orphans)            cmd_orphans ;;
stats)              cmd_stats ;;
verify|check)       cmd_verify "$@" ;;
doctor)             cmd_doctor ;;
clean)              cmd_clean ;;
hold)               cmd_hold "$@" ;;
unhold)             cmd_unhold "$@" ;;
mark)               cmd_mark "$@" ;;
snapshot|snap)      cmd_snapshot "$@" ;;
rollback|undo)      cmd_rollback "$@" ;;
log|history)        cmd_log "$@" ;;
build|mkpkg)        exec $(alpm_build_path) "$@" ;;
version|--version|-V) printf 'alpm %s (format %s) - Arctic Linux\n' "$ALPM_VERSION" "$ALPM_FORMAT" ;;
help|--help|-h|"")  usage ;;
*)                  err "unknown command: $cmd"; printf '\n'; usage; exit 1 ;;
esac
