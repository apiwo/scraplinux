#!/bin/sh
# arctic-install - install Arctic Linux from a declarative config file
#
#   arctic-install                   edit /etc/arctic/install.conf, then just this
#   arctic-install -n                check the config and stop, install nothing
#   arctic-install -c file           install from a specific config file instead
#   arctic-install -f                skip the "make these changes?" prompt
#
# There are no menus, no questions and no arguments - edit the config, then
# run it:
#
#   vi /etc/arctic/install.conf
#   arctic-install
#
# The config says which disk (A_DISK, wiped and partitioned automatically)
# or which existing partitions (A_ROOT_PART / A_BOOT_PART, used as they are)
# to install onto. Where those get mounted during the install is internal -
# there is no target directory to pass in and keep in sync.
#
# The config is checked before anything is touched. If it does not parse
# cleanly, everything it found wrong is listed and nothing is installed.
# If it does, it prints a summary of what it is about to do - which disk
# or partitions, which filesystem, encryption, kernel, hostname - and asks
# for confirmation before touching anything. The bootloader is configured
# automatically at the end, from the same config, since A_BOOTLOADER and
# friends already say everything it needs to know.
#
# shellcheck shell=sh disable=SC2039,SC2059,SC2086

set -u

LIB=/usr/lib/arctic
for d in "$LIB" "$(dirname "$0")/lib" ./lib; do
	[ -f "$d/tui.sh" ] && { . "$d/tui.sh"; TUILIB=$d; break; }
done
[ -n "${c_teal:-}" ] || { echo "arctic-install: cannot find tui.sh" >&2; exit 1; }

for d in /usr/lib/alpm "$(dirname "$0")/../alpm" ./alpm; do
	[ -f "$d/libalpm.sh" ] && { . "$d/libalpm.sh"; break; }
done

# One label for the whole distribution, spelled the same way in the ISO's
# filename and volume id, /etc/arctic-release, arcticfetch's "os" line and
# here. VERSION_TAG is the same thing where a filename needs it.
# Read from the running system, not spelled out here. This was a literal
# "Arctic Linux - Alpha 1.1" and write_release() copies it into the installed
# system's /etc/arctic-release - so every machine installed from every image
# since a1.1 has called itself Alpha 1.1, and the boot banner that reads that
# file said so on every boot. The live image the installer is running from
# already knows what it is.
VERSION=$(sed -n 's/^VERSION=//p' /etc/arctic-release 2>/dev/null | tr -d '"' | head -1)
VERSION_TAG=$(sed -n 's/^VERSION_ID=//p' /etc/arctic-release 2>/dev/null | tr -d '"' | head -1)
[ -n "$VERSION" ] || VERSION="Arctic Linux"
[ -n "$VERSION_TAG" ] || VERSION_TAG="unknown"
CONF=/etc/arctic/install.conf
# The install log. /run is a root-owned tmpfs; /tmp is world-writable, and
# this runs as root - a non-root user on the live session could leave a
# symlink named arctic-install.log in /tmp and have every line the installer
# writes land wherever it pointed. rm -f first either way: it removes a
# symlink rather than following it.
if mkdir -p /run/arctic 2>/dev/null && [ -w /run/arctic ]; then
	LOGF=/run/arctic/install.log
else
	LOGF=/tmp/arctic-install.log
fi
rm -f "$LOGF" 2>/dev/null || :

# ------------------------------------------------------------------- defaults
# Used as-is for anything the config file leaves unset - either because there
# is no config file at all, or because it only bothered to uncomment a few
# lines.
