#!/bin/sh
# arctic-install - install Arctic Linux from a declarative config file
#
#   arctic-install                   edit /etc/arctic/install.conf, then just this
#   arctic-install -n                check the config and stop, install nothing
#   arctic-install -c file           install from a specific config file instead
#   arctic-install -f                skip the "make these changes?" prompt
#
# There are no menus, no questions and no arguments - edit the config, then
# run it:
#
#   vi /etc/arctic/install.conf
#   arctic-install
#
# The config says which disk (A_DISK, wiped and partitioned automatically)
# or which existing partitions (A_ROOT_PART / A_BOOT_PART, used as they are)
# to install onto. Where those get mounted during the install is internal -
# there is no target directory to pass in and keep in sync.
#
# The config is checked before anything is touched. If it does not parse
# cleanly, everything it found wrong is listed and nothing is installed.
# If it does, it prints a summary of what it is about to do - which disk
# or partitions, which filesystem, encryption, kernel, hostname - and asks
# for confirmation before touching anything. The bootloader is configured
# automatically at the end, from the same config, since A_BOOTLOADER and
# friends already say everything it needs to know.
#
# shellcheck shell=sh disable=SC2039,SC2059,SC2086

set -u

LIB=/usr/lib/arctic
for d in "$LIB" "$(dirname "$0")/lib" ./lib; do
	[ -f "$d/tui.sh" ] && { . "$d/tui.sh"; TUILIB=$d; break; }
done
[ -n "${c_teal:-}" ] || { echo "arctic-install: cannot find tui.sh" >&2; exit 1; }

for d in /usr/lib/alpm "$(dirname "$0")/../alpm" ./alpm; do
	[ -f "$d/libalpm.sh" ] && { . "$d/libalpm.sh"; break; }
done

VERSION="1.0.0"
CONF=/etc/arctic/install.conf
LOGF=/tmp/arctic-install.log

# ------------------------------------------------------------------- defaults
# Used as-is for anything the config file leaves unset - either because there
# is no config file at all, or because it only bothered to uncomment a few
# lines.
TARGET=""
A_DISK=""
A_EASY_DISK="n"
A_EASY_DISK_FS="ext4"
A_EASY_DISK_IGNORE=""
A_ROOT_PART=""
A_BOOT_PART=""
A_HOME_PART=""
A_FORMAT="n"
A_ROOTDEV=""
A_ESP=""
A_BIOS_BOOTPART=""
A_BOOT_FW=""
A_BOOTLOADER="limine"
A_BOOT_MOUNT="/boot/efi"
A_BIOS_BOOT_MOUNT="/boot/limine"
A_BOOT_FS="vfat"
A_BOOT_TIMEOUT="3"
A_KERNEL_ARGS=""
A_GENERATIONS="5"
A_INIT="busybox"
A_PKGIT="n"
A_KERNEL="Arctic-base-kernel"
A_MICROCODE="auto"
A_DESKTOP="none"
A_DM=""
A_HOSTNAME="arctic"
A_USER=""
A_USERPASS=""
A_ROOTPASS=""
A_SHELL="/bin/zsh"
A_USER_GROUPS="wheel users audio video input"
A_DOAS_NOPASS="n"
A_LOCALE="en_US.UTF-8"
A_LANG="en_US.UTF-8"
A_KEYMAP="us"
A_CONSOLE_FONT=""
A_TZ="UTC"
A_NTP="y"
A_NET="offline"
A_WIFI_SSID=""
A_WIFI_PSK=""
A_WIFI_IFACE=""
A_IP=""
A_GATEWAY=""
A_DNS=""
A_ROOT_FS="ext4"
A_BTRFS_SUBVOLS="@ @home @snapshots @log"
A_SNAPSHOT="none"
A_BTRFS_OPTS=""
A_ENCRYPT="n"
A_ENCRYPT_PASS=""
A_SWAP="none"
A_SWAPSIZE="4G"
A_SWAPDEV=""
A_GPU="auto"
A_AUDIO="n"
A_BLUETOOTH="n"
A_SSH="n"
A_FIREWALL="y"
A_TRIM="auto"
A_EXTRA=""
A_FONTS=""
A_PKGS=""
A_SERVICES=""
A_SETS=""
A_LOCK_ROOT="n"
A_SSH_PASSWORD_AUTH="y"
A_SSH_KEYS=""
A_HARDEN_TMP="n"
A_MAC_RANDOMIZE="n"
A_MOUNTS=""
A_BTRFS_NO_SNAPSHOT_CACHE="n"
A_DISK_RESERVE=""
A_ZRAM="n"
A_ZRAM_SIZE="50%"
A_ZRAM_ALGO="zstd"
A_POST=""
A_CHROOT_SHELL="n"
A_REBOOT="n"

# A_FS was the old name for A_ROOT_FS. Keep reading it so configs written
# against the previous release still install instead of silently falling
# back to ext4.
A_FS=""

bail() {
	tui_done 2>/dev/null
	{
		printf 'error: %s\n' "$*"
		cat <<'EOF'
   \
    \
        .--.
       |o_o |
       |:_/ |
      //   \ \
     (|     | )
    /'\_   _/`\
    \___)=(___/
EOF
	} >&2
	exit 1
}
logit() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >>"$LOGF"; }

detect_gpu() {
	if [ -d /sys/bus/pci/devices ]; then
		v=$(lspci 2>/dev/null | grep -iE 'vga|3d|display')
		case "$v" in
		*NVIDIA*|*nVidia*) echo nvidia ;;
		*AMD*|*ATI*|*"Advanced Micro"*) echo amd ;;
		*Intel*) echo intel ;;
		*) echo generic ;;
		esac
	else
		echo generic
	fi
}

detect_microcode() {
	case "$(grep -m1 '^vendor_id' /proc/cpuinfo 2>/dev/null)" in
	*GenuineIntel*) echo intel-ucode ;;
	*AuthenticAMD*) echo amd-ucode ;;
	*) echo none ;;
	esac
}

detect_firmware() { [ -d /sys/firmware/efi ] && echo efi || echo bios; }

# Partition names differ between /dev/sda1 and /dev/nvme0n1p1.
part_name() {
	case "$1" in
	*[0-9]) printf '%sp%s' "$1" "$2" ;;
	*)      printf '%s%s' "$1" "$2" ;;
	esac
}

detect_rotational() {
	# Returns "ssd" when the target device does not spin.
	d=$(df "$TARGET" 2>/dev/null | awk 'NR==2{print $1}' | sed 's|/dev/||; s|p\?[0-9]*$||')
	[ -n "$d" ] || { echo unknown; return; }
	r=$(cat "/sys/block/$d/queue/rotational" 2>/dev/null)
	[ "$r" = "0" ] && echo ssd || echo hdd
}

detect_existing_install() { [ -f "$1/etc/arctic-release" ]; }

# "20G", "512M", "1T" -> bytes. Used for A_DISK_RESERVE, which needs to do
# arithmetic on a size sfdisk would otherwise just accept as text.
size_to_bytes() {
	case "$1" in
	*T|*t) awk -v n="${1%[Tt]}" 'BEGIN{printf "%.0f", n*1024*1024*1024*1024}' ;;
	*G|*g) awk -v n="${1%[Gg]}" 'BEGIN{printf "%.0f", n*1024*1024*1024}' ;;
	*M|*m) awk -v n="${1%[Mm]}" 'BEGIN{printf "%.0f", n*1024*1024}' ;;
	*K|*k) awk -v n="${1%[Kk]}" 'BEGIN{printf "%.0f", n*1024}' ;;
	*)     printf '%s' "$1" ;;
	esac
}

# ------------------------------------------------------------ config checking
#
# Everything the config says is checked before a single byte is written. A
# typo in a device name or a filesystem that does not exist should stop the
# install here, with the whole list of what is wrong, rather than half way
# through with a disk already wiped.

CFG_ERRORS=""
CFG_WARNINGS=""
cfg_err()  { CFG_ERRORS="$CFG_ERRORS
  $*"; }
cfg_warn() { CFG_WARNINGS="$CFG_WARNINGS
  $*"; }

# Is $2 one of the space-separated words in $3? $1 names the setting.
cfg_enum() {
	_n=$1 _v=$2 _ok=$3
	[ -n "$_v" ] || return 0
	case " $_ok " in
	*" $_v "*) return 0 ;;
	esac
	cfg_err "$_n=$_v is not valid (try: $_ok)"
}

cfg_blockdev() {
	_n=$1 _v=$2
	[ -n "$_v" ] || return 0
	[ -b "$_v" ] || cfg_err "$_n=$_v is not a block device on this machine"
}

check_config() {
	# A_FS is the old name; fold it in before anything looks at A_ROOT_FS.
	if [ -n "$A_FS" ]; then
		A_ROOT_FS=$A_FS
		cfg_warn "A_FS is the old name for A_ROOT_FS - still honoured, but rename it"
	fi
	[ -n "$A_ROOT_FS" ] || A_ROOT_FS=ext4

	# Same for A_EXTRA, the old name for A_PKGS.
	if [ -n "$A_EXTRA" ]; then
		A_PKGS="${A_PKGS:+$A_PKGS }$A_EXTRA"
		cfg_warn "A_EXTRA is the old name for A_PKGS - still honoured, but rename it"
	fi

	# --- disk -------------------------------------------------------
	cfg_enum A_EASY_DISK "$A_EASY_DISK" "y n"
	if [ "$A_EASY_DISK" = y ]; then
		[ -n "$A_DISK" ] || \
			cfg_err "A_EASY_DISK=y needs A_DISK=/dev/sdX set too - it still needs to know which disk"
		[ -n "$A_ROOT_PART" ] && \
			cfg_err "A_EASY_DISK=y and A_ROOT_PART are both set - easy-disk mode is whole-disk only"
		# Everything below this is what "easy" means: one filesystem choice,
		# every other knob in FILESYSTEMS/ENCRYPTION reset to a plain default
		# rather than left at whatever the file happened to also set.
		A_ROOT_FS=$A_EASY_DISK_FS
		A_ENCRYPT=n
		A_DISK_RESERVE=""
		A_BTRFS_SUBVOLS="@ @home @snapshots @log"
		A_BTRFS_OPTS=""
		A_BTRFS_NO_SNAPSHOT_CACHE=n
		# A safety check, not a partial-preserve feature: refuse the whole
		# disk rather than attempt to partition around a partition someone
		# meant to keep. "Easy" should never be the risky option.
		for _ig in $A_EASY_DISK_IGNORE; do
			case "$_ig" in
			/dev/*) ;;
			*) cfg_err "A_EASY_DISK_IGNORE entries must be device paths (got '$_ig')"; continue ;;
			esac
			[ -b "$_ig" ] && cfg_err "A_EASY_DISK_IGNORE lists $_ig, and it exists - refusing to touch $A_DISK at all rather than partition around it"
		done
	fi

	if [ -n "$A_DISK" ] && [ -n "$A_ROOT_PART" ]; then
		cfg_err "A_DISK and A_ROOT_PART are both set - pick one (whole disk, or existing partitions)"
	elif [ -z "$A_DISK" ] && [ -z "$A_ROOT_PART" ]; then
		cfg_err "no disk chosen - set A_DISK=/dev/sda to use a whole disk, or A_ROOT_PART=/dev/sda2 to use a partition you made yourself"
	fi
	cfg_blockdev A_DISK      "$A_DISK"
	cfg_blockdev A_ROOT_PART "$A_ROOT_PART"
	cfg_blockdev A_BOOT_PART "$A_BOOT_PART"
	cfg_blockdev A_HOME_PART "$A_HOME_PART"
	cfg_blockdev A_SWAPDEV   "$A_SWAPDEV"

	# Refusing to install onto a partition of a disk that is also about to
	# be wiped catches the "I set both, differently" case that the check
	# above cannot see.
	if [ -n "$A_ROOT_PART" ] && [ "$A_ROOT_PART" = "$A_BOOT_PART" ]; then
		cfg_err "A_ROOT_PART and A_BOOT_PART are the same partition ($A_ROOT_PART)"
	fi

	cfg_enum A_FORMAT "$A_FORMAT" "y n"
	cfg_enum A_ROOT_FS "$A_ROOT_FS" "ext4 ext3 ext2 btrfs xfs f2fs zfs"
	cfg_enum A_BOOT_FS "$A_BOOT_FS" "vfat ext4 ext3 ext2"
	cfg_enum A_SNAPSHOT "$A_SNAPSHOT" "none btrfs"
	cfg_enum A_ENCRYPT "$A_ENCRYPT" "y n"
	cfg_enum A_SWAP "$A_SWAP" "none file partition"
	cfg_enum A_BOOT_FW "$A_BOOT_FW" "efi bios"
	cfg_enum A_BOOTLOADER "$A_BOOTLOADER" "limine grub"
	cfg_enum A_MICROCODE "$A_MICROCODE" "auto intel amd none"
	cfg_enum A_INIT "$A_INIT" "busybox openrc sysvinit runit dinit systemd-libre"
	cfg_enum A_PKGIT "$A_PKGIT" "y n"
	cfg_enum A_NET "$A_NET" "offline dhcp wifi static"
	cfg_enum A_DESKTOP "$A_DESKTOP" "none xfce kde niri dwm"
	cfg_enum A_DM "$A_DM" "none lightdm sddm greetd"
	cfg_enum A_GPU "$A_GPU" "auto nvidia nouveau amd intel generic"
	cfg_enum A_AUDIO "$A_AUDIO" "y n"
	cfg_enum A_BLUETOOTH "$A_BLUETOOTH" "y n"
	cfg_enum A_SSH "$A_SSH" "y n"
	cfg_enum A_FIREWALL "$A_FIREWALL" "y n"
	cfg_enum A_NTP "$A_NTP" "y n"
	cfg_enum A_TRIM "$A_TRIM" "auto y n"
	cfg_enum A_DOAS_NOPASS "$A_DOAS_NOPASS" "y n"
	cfg_enum A_LOCK_ROOT "$A_LOCK_ROOT" "y n"
	cfg_enum A_SSH_PASSWORD_AUTH "$A_SSH_PASSWORD_AUTH" "y n"
	cfg_enum A_HARDEN_TMP "$A_HARDEN_TMP" "y n"
	cfg_enum A_MAC_RANDOMIZE "$A_MAC_RANDOMIZE" "y n"
	cfg_enum A_BTRFS_NO_SNAPSHOT_CACHE "$A_BTRFS_NO_SNAPSHOT_CACHE" "y n"
	cfg_enum A_ZRAM "$A_ZRAM" "y n"
	cfg_enum A_CHROOT_SHELL "$A_CHROOT_SHELL" "y n"
	cfg_enum A_REBOOT "$A_REBOOT" "y n"
	for _s in $A_SETS; do
		case " devel net media office virt gaming cli " in
		*" $_s "*) ;;
		*) cfg_err "A_SETS contains an unknown set '$_s' (try: devel net media office virt gaming cli)" ;;
		esac
	done

	# --- things that only make sense together -----------------------
	[ "$A_SNAPSHOT" = btrfs ] && [ "$A_ROOT_FS" != btrfs ] && \
		cfg_err "A_SNAPSHOT=btrfs needs A_ROOT_FS=btrfs (this config has $A_ROOT_FS)"
	[ "$A_ENCRYPT" = y ] && [ -z "$A_ENCRYPT_PASS" ] && \
		cfg_err "A_ENCRYPT=y but A_ENCRYPT_PASS is empty"
	[ "$A_ENCRYPT" = y ] && [ "$A_ROOT_FS" = zfs ] && \
		cfg_err "A_ENCRYPT=y cannot be combined with A_ROOT_FS=zfs (zfs encrypts itself)"
	[ "$A_NET" = wifi ] && [ -z "$A_WIFI_SSID" ] && \
		cfg_err "A_NET=wifi but A_WIFI_SSID is empty"
	[ "$A_NET" = static ] && [ -z "$A_IP" ] && \
		cfg_err "A_NET=static but A_IP is empty"
	[ "$A_SWAP" = partition ] && [ -z "$A_SWAPDEV" ] && \
		cfg_err "A_SWAP=partition but A_SWAPDEV is empty"
	[ -n "$A_USERPASS" ] && [ -z "$A_USER" ] && \
		cfg_warn "A_USERPASS is set but A_USER is empty - no account will be created"
	[ -n "$A_ROOT_PART" ] && [ "$A_FORMAT" = n ] && \
		cfg_warn "installing onto $A_ROOT_PART without formatting - whatever is already there stays"
	[ "$A_LOCK_ROOT" = y ] && [ -z "$A_USER" ] && \
		cfg_warn "A_LOCK_ROOT=y but A_USER is empty - ignored, that would leave no way in at all"
	[ "$A_SSH_PASSWORD_AUTH" = n ] && [ "$A_SSH" != y ] && \
		cfg_warn "A_SSH_PASSWORD_AUTH=n has nothing to do - A_SSH is not y"
	[ -n "$A_SSH_KEYS" ] && [ "$A_SSH" != y ] && \
		cfg_warn "A_SSH_KEYS is set but A_SSH is not y - the keys are still written, sshd just is not running to use them"

	# Wiping a disk that is currently mounted is never what anyone means.
	if [ -n "$A_DISK" ]; then
		if awk '{print $1}' /proc/mounts | grep -q "^$A_DISK"; then
			cfg_err "$A_DISK has partitions mounted right now - unmount them first"
		fi
	fi

	# --- verdict ----------------------------------------------------
	printf '\n'
	if [ -n "$CFG_ERRORS" ]; then
		printf '%sConfig file has errors%s\n' "${c_red:-}" "${t_reset:-}"
		printf '%s\n' "  $CFFILE"
		printf '%s\n' "$CFG_ERRORS"
		[ -n "$CFG_WARNINGS" ] && printf '\n  also:%s\n' "$CFG_WARNINGS"
		printf '\nNothing has been changed. Fix the config and run arctic-install again.\n\n'
		exit 1
	fi
	printf '%sConfig file accepted%s\n' "${c_teal:-}" "${t_reset:-}"
	printf '  %s\n' "$CFFILE"
	if [ -n "$A_DISK" ]; then
		if [ "$A_EASY_DISK" = y ]; then
			printf '  %-14s %s (easy disk - whole disk, %s, no encryption)\n' \
				"disk" "$A_DISK" "$A_ROOT_FS"
		else
			printf '  %-14s %s (whole disk - everything on it is destroyed)\n' "disk" "$A_DISK"
		fi
	else
		printf '  %-14s %s%s\n' "root" "$A_ROOT_PART" \
			"$([ "$A_FORMAT" = y ] && printf ' (reformatted as %s)' "$A_ROOT_FS")"
		[ -n "$A_BOOT_PART" ] && printf '  %-14s %s\n' "boot" "$A_BOOT_PART"
	fi
	printf '  %-14s %s\n' "filesystem" "$A_ROOT_FS"
	printf '  %-14s %s\n' "kernel" "$A_KERNEL"
	printf '  %-14s %s\n' "hostname" "$A_HOSTNAME"
	[ "$A_DESKTOP" != none ] && printf '  %-14s %s\n' "desktop" "$A_DESKTOP"
	[ "$A_ENCRYPT" = y ]   && printf '  %-14s %s\n' "encryption" "LUKS2"
	[ -n "$CFG_WARNINGS" ] && printf '\n  warnings:%s\n' "$CFG_WARNINGS"
	printf '\n'
}

# ------------------------------------------------------------- disk partitioning
#
# Only runs when the config sets A_DISK. Leaving it unset keeps the manual
# path: partition and mount a target yourself, same as always.

# cryptsetup is not baked into the live rootfs the way util-linux/e2fsprogs
# are - it comes from the same bundled repo target_alpm installs from later,
# just applied to the live system's own root instead of a chrooted target.
ensure_pkg() {
	have "$2" && return 0
	ALPM_YES=1 alpm ins "$1" >>"$LOGF" 2>&1
	have "$2"
}

list_disks() {
	for d in /sys/block/*; do
		n=$(basename "$d")
		case "$n" in loop*|ram*|sr*|dm-*|md*|zram*) continue ;; esac
		[ -r "$d/size" ] || continue
		sz=$(cat "$d/size" 2>/dev/null)
		[ "${sz:-0}" -gt 0 ] || continue
		printf '%s\n' "$n"
	done
}

# Make the filesystem chosen in the config, and lay out btrfs subvolumes.
make_root_fs() {
	dev=$1
	case "$A_ROOT_FS" in
	btrfs)
		mkfs.btrfs -f -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
		# The @ / @home split is what both timeshift and snapper expect: the
		# root subvolume can then be rolled back without taking home with it.
		# A_BTRFS_SUBVOLS names which ones to create; A_BTRFS_NO_SNAPSHOT_CACHE
		# adds @cache for /var/cache when the config asks for it, so cache
		# churn does not bloat every root snapshot taken afterward.
		subvols=${A_BTRFS_SUBVOLS:-"@ @home @snapshots @log"}
		[ "$A_BTRFS_NO_SNAPSHOT_CACHE" = y ] && \
			case " $subvols " in *" @cache "*) ;; *) subvols="$subvols @cache" ;; esac

		mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1
		for sv in $subvols; do
			btrfs subvolume create "$TARGET/$sv" >>"$LOGF" 2>&1 || \
				{ [ "$sv" = "@" ] && { umount "$TARGET" >>"$LOGF" 2>&1; return 1; }; }
		done
		umount "$TARGET" >>"$LOGF" 2>&1 || return 1

		A_BTRFS_OPTS=${A_BTRFS_OPTS:-rw,noatime,compress=zstd:3,space_cache=v2}
		mount -o "$A_BTRFS_OPTS,subvol=@" "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1
		for sv in $subvols; do
			case "$sv" in
			"@")          continue ;;
			"@home")      d=home ;;
			"@snapshots") d=.snapshots ;;
			"@log")       d=var/log ;;
			"@cache")     d=var/cache ;;
			# A subvolume with no known mountpoint is still created above -
			# it exists on disk for whoever wants it - but nothing here
			# knows where it should live, so it is left unmounted. Say so
			# in A_MOUNTS with subvol=<name> if you want it mounted too.
			*) logit "btrfs subvolume $sv created but not auto-mounted (unknown name)"; continue ;;
			esac
			mkdir -p "$TARGET/$d"
			mount -o "$A_BTRFS_OPTS,subvol=$sv" "$dev" "$TARGET/$d" >>"$LOGF" 2>&1 || :
		done
		;;
	xfs)  mkfs.xfs -f -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	f2fs) mkfs.f2fs -f -l arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	ext3) mkfs.ext3 -q -F -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	ext2) mkfs.ext2 -q -F -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	zfs)
		# Best-effort: Arctic has no zfs-utils package yet (OpenZFS needs an
		# out-of-tree kernel module), so this path is untested end to end.
		zpool create -f -O mountpoint=none -O compression=zstd \
			-O acltype=posixacl -O xattr=sa -o cachefile=none \
			arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
		zfs create -o mountpoint=legacy arctic-root/root >>"$LOGF" 2>&1 || return 1
		mount -t zfs arctic-root/root "$TARGET" >>"$LOGF" 2>&1 || return 1
		;;
	# ^metadata_csum,^metadata_csum_seed,^64bit,^orphan_file: current
	# e2fsprogs turns these on by default, but Limine's BIOS-mode ext4
	# reader cannot parse any of them - it just reports "Stage 3 file not
	# found" and refuses to boot even though limine-bios.sys is sitting
	# right there in the root directory. This partition is exactly what
	# a BIOS install has to read before the kernel's own (fully capable)
	# ext4 driver ever gets involved, so the on-disk format has to stay
	# inside what that reader understands.
	*)    mkfs.ext4 -O ^metadata_csum,^metadata_csum_seed,^64bit,^orphan_file \
	          -q -F -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	esac
	return 0
}

# Lay down a GPT and format it: one EFI partition when the machine booted
# through UEFI, one root filesystem taking the rest; on BIOS, a raw 1M
# partition for Limine's stage2 plus a small FAT32 /boot/limine, since
# upstream Limine's BIOS build no longer has an ext2/3/4 driver (see
# ports/main/limine's recipe) - stage3, the kernel and the initramfs need
# a filesystem it can still read, same trick UEFI already uses for the ESP.
# Sets A_ESP/A_BIOS_BOOTPART/A_ROOTDEV/A_BOOT_FW for do_install's own
# bootloader step at the end.
partition_disk() {
	disk=$A_DISK
	[ -b "$disk" ] || bail "A_DISK=$disk is not a block device"
	fw=$(detect_firmware)
	A_BOOT_FW=$fw

	step "Partitioning $disk" "wiping old signatures"
	wipefs -a "$disk" >>"$LOGF" 2>&1 || :

	# A_DISK_RESERVE leaves free space at the end of the disk instead of
	# giving all of it to root - for a partition to be added later. The
	# root partition is always last, so this only has to turn its size
	# from "the rest of the disk" into an explicit sector count - sfdisk's
	# script format takes a bare number as sectors, not bytes.
	rootsize=""
	if [ -n "$A_DISK_RESERVE" ]; then
		reserve_b=$(size_to_bytes "$A_DISK_RESERVE")
		disk_b=$(blockdev --getsize64 "$disk" 2>/dev/null)
		ss=$(blockdev --getss "$disk" 2>/dev/null); ss=${ss:-512}
		fw_b=$([ "$fw" = efi ] && echo $((512*1024*1024)) || echo $(((1+512)*1024*1024)))
		if [ -n "$disk_b" ] && [ -n "$reserve_b" ]; then
			rootsize=$(( (disk_b - fw_b - reserve_b) / ss ))
			[ "$rootsize" -gt 0 ] || bail "A_DISK_RESERVE=$A_DISK_RESERVE leaves no room for root on $disk"
		else
			warn_soft "could not size $disk to honour A_DISK_RESERVE - using the whole disk"
		fi
	fi

	if [ "$fw" = efi ]; then
		step "Partitioning $disk" "GPT: EFI + root"
		# sfdisk reads the whole layout on stdin, which avoids a pile of
		# interactive fdisk keystrokes.
		printf 'label: gpt\n,512M,U\n,%s,L\n' "$rootsize" | sfdisk --quiet "$disk" >>"$LOGF" 2>&1 \
			|| bail "partitioning $disk failed - see $LOGF"
		p1=$(part_name "$disk" 1); pb=""; p2=$(part_name "$disk" 2)
		step "Formatting $p1" "EFI (FAT32)"
		mkfs.vfat -F32 -n ARCTIC_EFI "$p1" >>"$LOGF" 2>&1 \
			|| bail "mkfs.vfat failed on $p1 - see $LOGF"
	else
		step "Partitioning $disk" "GPT: BIOS boot + /boot/limine + root"
		printf 'label: gpt\n,1M,21686148-6449-6E6F-744E-656564454649\n,512M,U\n,%s,L\n' "$rootsize" \
			| sfdisk --quiet "$disk" >>"$LOGF" 2>&1 \
			|| bail "partitioning $disk failed - see $LOGF"
		p1=""; pb=$(part_name "$disk" 2); p2=$(part_name "$disk" 3)
		step "Formatting $pb" "boot (FAT32)"
		mkfs.vfat -F32 -n ARCTIC_BOOT "$pb" >>"$LOGF" 2>&1 \
			|| bail "mkfs.vfat failed on $pb - see $LOGF"
	fi

	rootsrc=$p2
	if [ "$A_ENCRYPT" = y ]; then
		step "Encrypting $p2" "LUKS"
		ensure_pkg cryptsetup cryptsetup || bail "cryptsetup could not be installed from the medium"
		# --key-file - reads the whole of stdin as the key verbatim, so this
		# must not add a trailing newline the way echo would - whatever
		# passphrase is typed back at the interactive unlock prompt at boot
		# will not have one either, and the two have to match exactly.
		printf '%s' "$A_ENCRYPT_PASS" | \
			cryptsetup luksFormat -q --key-file - "$p2" >>"$LOGF" 2>&1 \
			|| bail "cryptsetup luksFormat failed on $p2 - see $LOGF"
		printf '%s' "$A_ENCRYPT_PASS" | \
			cryptsetup open --key-file - "$p2" cryptroot >>"$LOGF" 2>&1 \
			|| bail "could not unlock the new encrypted volume - see $LOGF"
		rootsrc=/dev/mapper/cryptroot
	fi

	step "Formatting $rootsrc" "$A_ROOT_FS"
	mkdir -p "$TARGET"
	make_root_fs "$rootsrc" || bail "could not create the $A_ROOT_FS filesystem on $rootsrc - see $LOGF"

	if [ -n "$p1" ]; then
		step "Mounting $p1" "$A_BOOT_MOUNT"
		mkdir -p "$TARGET$A_BOOT_MOUNT"
		mount "$p1" "$TARGET$A_BOOT_MOUNT" >>"$LOGF" 2>&1 || :
		A_ESP=$p1
	elif [ -n "$pb" ]; then
		step "Mounting $pb" "$A_BIOS_BOOT_MOUNT"
		mkdir -p "$TARGET$A_BIOS_BOOT_MOUNT"
		mount "$pb" "$TARGET$A_BIOS_BOOT_MOUNT" >>"$LOGF" 2>&1 || :
		A_BIOS_BOOTPART=$pb
	fi
	A_ROOTDEV=$p2
	logit "disk $disk ready and mounted on $TARGET"
}

# The other path: partitions the operator made themselves. Nothing is
# repartitioned and, unless A_FORMAT=y, nothing is reformatted either -
# whatever is on them stays and Arctic installs alongside it.
mount_existing() {
	fw=${A_BOOT_FW:-$(detect_firmware)}
	A_BOOT_FW=$fw

	rootsrc=$A_ROOT_PART
	if [ "$A_ENCRYPT" = y ]; then
		step "Encrypting $A_ROOT_PART" "LUKS"
		ensure_pkg cryptsetup cryptsetup || bail "cryptsetup could not be installed from the medium"
		printf '%s' "$A_ENCRYPT_PASS" | \
			cryptsetup luksFormat -q --key-file - "$A_ROOT_PART" >>"$LOGF" 2>&1 \
			|| bail "cryptsetup luksFormat failed on $A_ROOT_PART - see $LOGF"
		printf '%s' "$A_ENCRYPT_PASS" | \
			cryptsetup open --key-file - "$A_ROOT_PART" cryptroot >>"$LOGF" 2>&1 \
			|| bail "could not unlock the new encrypted volume - see $LOGF"
		rootsrc=/dev/mapper/cryptroot
	fi

	mkdir -p "$TARGET"
	if [ "$A_FORMAT" = y ]; then
		step "Formatting $rootsrc" "$A_ROOT_FS"
		make_root_fs "$rootsrc" \
			|| bail "could not create the $A_ROOT_FS filesystem on $rootsrc - see $LOGF"
	else
		step "Mounting $rootsrc" "as it is"
		# An existing btrfs almost certainly already has the @ layout from
		# whoever made it, so mount that rather than the top level - the
		# same subvolume the fstab is about to name.
		if [ "$(blkid -s TYPE -o value "$rootsrc" 2>/dev/null)" = btrfs ]; then
			A_ROOT_FS=btrfs
			A_BTRFS_OPTS=${A_BTRFS_OPTS:-rw,noatime,compress=zstd:3,space_cache=v2}
			if mount -o "$A_BTRFS_OPTS,subvol=@" "$rootsrc" "$TARGET" >>"$LOGF" 2>&1; then
				dirs="home .snapshots var/log"
				[ "$A_BTRFS_NO_SNAPSHOT_CACHE" = y ] && dirs="$dirs var/cache"
				for sv in $dirs; do
					case "$sv" in
					home)       s=@home ;;
					.snapshots) s=@snapshots ;;
					var/log)    s=@log ;;
					var/cache)  s=@cache ;;
					esac
					mkdir -p "$TARGET/$sv"
					mount -o "$A_BTRFS_OPTS,subvol=$s" "$rootsrc" "$TARGET/$sv" >>"$LOGF" 2>&1 || :
				done
			else
				mount "$rootsrc" "$TARGET" >>"$LOGF" 2>&1 \
					|| bail "could not mount $rootsrc - see $LOGF"
			fi
		else
			mount "$rootsrc" "$TARGET" >>"$LOGF" 2>&1 \
				|| bail "could not mount $rootsrc - see $LOGF"
			t=$(awk -v t="$TARGET" '$2==t{print $3}' /proc/mounts | tail -1)
			[ -n "$t" ] && A_ROOT_FS=$t
		fi
	fi

	if [ -n "$A_BOOT_PART" ]; then
		if [ "$fw" = efi ]; then bm=$A_BOOT_MOUNT; else bm=/boot; fi
		if [ "$A_FORMAT" = y ] && [ "$fw" = efi ]; then
			step "Formatting $A_BOOT_PART" "$A_BOOT_FS"
			case "$A_BOOT_FS" in
			vfat) mkfs.vfat -F32 -n ARCTIC_EFI "$A_BOOT_PART" >>"$LOGF" 2>&1 || : ;;
			# Same reasoning as make_root_fs's ext4 case: keep this
			# readable by a bootloader that predates modern e2fsprogs
			# defaults.
			ext4) mkfs.ext4 -O ^metadata_csum,^metadata_csum_seed,^64bit,^orphan_file \
			          -q -F -L arctic-boot "$A_BOOT_PART" >>"$LOGF" 2>&1 || : ;;
			ext3) mkfs.ext3 -q -F -L arctic-boot "$A_BOOT_PART" >>"$LOGF" 2>&1 || : ;;
			ext2) mkfs.ext2 -q -F -L arctic-boot "$A_BOOT_PART" >>"$LOGF" 2>&1 || : ;;
			esac
		fi
		step "Mounting $A_BOOT_PART" "$bm"
		mkdir -p "$TARGET$bm"
		mount "$A_BOOT_PART" "$TARGET$bm" >>"$LOGF" 2>&1 \
			|| warn_soft "could not mount $A_BOOT_PART on $bm"
		if [ "$fw" = efi ]; then
			A_ESP=$A_BOOT_PART
		else
			# Same reasoning as partition_disk: a separate mount here only
			# helps Limine on BIOS if A_BOOT_FS actually stayed something it
			# can read (vfat, the default) - ext2/3/4 hits the same dropped
			# driver either way. A_BIOS_BOOT_MOUNT is "/boot/limine" for
			# partition_disk's own layout; this one is plain "/boot" since
			# that is where $bm just mounted it.
			A_BIOS_BOOTPART=$A_BOOT_PART; A_BIOS_BOOT_MOUNT=$bm
		fi
	fi

	if [ -n "$A_HOME_PART" ]; then
		if [ "$A_FORMAT" = y ]; then
			step "Formatting $A_HOME_PART" "$A_ROOT_FS"
			case "$A_ROOT_FS" in
			btrfs) mkfs.btrfs -f -L arctic-home "$A_HOME_PART" >>"$LOGF" 2>&1 || : ;;
			xfs)   mkfs.xfs -f -L arctic-home "$A_HOME_PART" >>"$LOGF" 2>&1 || : ;;
			*)     mkfs.ext4 -q -F -L arctic-home "$A_HOME_PART" >>"$LOGF" 2>&1 || : ;;
			esac
		fi
		step "Mounting $A_HOME_PART" "/home"
		mkdir -p "$TARGET/home"
		mount "$A_HOME_PART" "$TARGET/home" >>"$LOGF" 2>&1 \
			|| warn_soft "could not mount $A_HOME_PART on /home"
	fi

	A_ROOTDEV=$A_ROOT_PART
	logit "existing partitions mounted on $TARGET"
}

# ----------------------------------------------------------------- init system
#
# busybox init is what Arctic is built around and needs nothing installed.
# Anything else means installing that init plus its supervision tools, then
# translating /etc/rc.d into whatever format it expects - which is
# arctic-init-setup's whole job, so this only has to decide the packages and
# hand the rest over.

init_packages() {
	case "$1" in
	busybox)       echo "" ;;
	openrc)        echo "openrc" ;;
	sysvinit)      echo "sysvinit" ;;
	runit)         echo "runit" ;;
	dinit)         echo "dinit" ;;
	systemd-libre)         echo "systemd" ;;
	esac
}

# What PID 1 actually is, for the kernel command line.
init_path() {
	case "$1" in
	busybox)       echo "" ;;                       # kernel default, /sbin/init
	openrc)        echo "/sbin/openrc-init" ;;
	sysvinit)      echo "/sbin/init" ;;
	runit)         echo "/sbin/runit-init" ;;
	dinit)         echo "/sbin/dinit" ;;
	systemd-libre)         echo "/usr/lib/systemd/systemd" ;;
	esac
}

install_init() {
	[ "$A_INIT" = busybox ] && { logit "busybox init: nothing extra to install"; return 0; }

	pkgs=$(init_packages "$A_INIT")
	step "Installing $A_INIT" "$pkgs"
	if [ -n "$pkgs" ]; then
		# shellcheck disable=SC2086
		if ! target_alpm ins $pkgs; then
			warn_soft "$A_INIT could not be installed - the system will boot busybox init instead"
			A_INIT=busybox
			return 0
		fi
	fi

	step "Configuring $A_INIT" "translating /etc/rc.d"
	setup=$(dirname "$0")/../skel/usr/bin/arctic-init-setup
	[ -x "$setup" ] || setup="$TARGET/usr/bin/arctic-init-setup"
	[ -x "$setup" ] || setup=arctic-init-setup
	if "$setup" "$A_INIT" --root "$TARGET" >>"$LOGF" 2>&1; then
		logit "$A_INIT service definitions written"
	else
		warn_soft "could not translate services to $A_INIT - see $LOGF"
	fi

	# Record the choice so arctic-rebuild knows which format to write when
	# system.conf changes later.
	mkdir -p "$TARGET/etc/arctic"
	printf '%s\n' "$A_INIT" >"$TARGET/etc/arctic/init"

	# Anything that is not busybox init needs init= on the kernel command
	# line, since /sbin/init stays busybox's.
	ip=$(init_path "$A_INIT")
	if [ -n "$ip" ] && [ "$A_INIT" != sysvinit ]; then
		A_KERNEL_ARGS="${A_KERNEL_ARGS:+$A_KERNEL_ARGS }init=$ip"
		logit "kernel command line gains init=$ip"
	fi
}

install_pkgit() {
	step "Installing pkgit" "alongside alpm"
	if target_alpm ins pkgit; then
		logit "pkgit installed"
	else
		warn_soft "pkgit is not in the repositories yet - alpm remains the only package manager"
	fi
}

# ------------------------------------------------------------------ the install

# Package sets, per repo. main is what every Arctic system needs.
PKGS_MAIN="glibc busybox toybox zsh doas libarchive mandoc onetrueawk bmake byacc \
alpm arctic-base arctic-init iana-etc tzdata ca-certificates"
PKGS_NET="networkmanager wpa_supplicant openssl curl dbus"
PKGS_EXTRA_BASE="foot vim less htop fastfetch pciutils usbutils"

step() {
	TUI_GAUGE_NOTE="$2"
	tui_gauge "$1"
	logit "$1"
}

run() {
	logit "+ $*"
	if "$@" >>"$LOGF" 2>&1; then
		return 0
	fi
	rc=$?
	logit "! failed ($rc): $*"
	return $rc
}

target_alpm() {
	# alpm honours --root, so the whole install is one package transaction.
	ALPM_ROOT="$TARGET" ALPM_YES=1 alpm "$@"
}

do_install() {
	step "Checking the target" "$TARGET"
	[ -d "$TARGET" ] || bail "$TARGET is not a directory"
	mountpoint -q "$TARGET" 2>/dev/null || \
		logit "warning: $TARGET is not a mount point"
	av=$(df -k "$TARGET" | awk 'NR==2{print $4}')
	[ "${av:-0}" -gt 1048576 ] || bail "$TARGET has less than 1 GiB free"

	step "Creating the directory tree" "filesystem layout"
	for d in boot dev etc home proc root run srv sys tmp var opt \
		usr/bin usr/lib usr/share usr/include usr/local \
		var/log var/cache var/lib var/tmp etc/alpm/repos.d \
		var/lib/alpm/local var/lib/alpm/sync
	do
		mkdir -p "$TARGET/$d"
	done
	chmod 1777 "$TARGET/tmp" "$TARGET/var/tmp"
	chmod 700 "$TARGET/root"
	# Arctic is a merged-/usr system; /bin, /sbin, /lib and /lib64 are
	# symlinks. glibc here installs into usr/lib (slibdir=/usr/lib, no
	# separate lib64), but the host gcc used to build every native package
	# still bakes in /lib64/ld-linux-x86-64.so.2 as the interpreter path -
	# that is the standard x86_64 default regardless of where the library
	# actually lives. /lib64 -> usr/lib64 (a separate, empty directory)
	# looked plausible but left every dynamically linked binary unable to
	# find its own interpreter after boot; it must point at usr/lib, same
	# as the live ISO's own rootfs already does.
	for l in bin sbin lib; do
		[ -e "$TARGET/$l" ] || ln -s "usr/$l" "$TARGET/$l" 2>/dev/null || :
	done
	[ -e "$TARGET/lib64" ] || ln -s usr/lib "$TARGET/lib64" 2>/dev/null || :

	# /var/run -> ../run and /var/lock -> ../run/lock. dbus listens on
	# /run/dbus/system_bus_socket, but ell - the library bluez is built on -
	# looks under /var/run/dbus. Without these, anything built on ell cannot
	# reach a perfectly healthy bus and reports "Failed to initialize D-Bus".
	rm -rf "$TARGET/var/run" "$TARGET/var/lock" 2>/dev/null || :
	ln -sfn ../run "$TARGET/var/run" 2>/dev/null || :
	ln -sfn ../run/lock "$TARGET/var/lock" 2>/dev/null || :
	mkdir -p "$TARGET/usr/sbin"

	step "Copying the package database" "repositories"
	for f in /etc/alpm/alpm.conf; do
		[ -f "$f" ] && { mkdir -p "$TARGET/etc/alpm"; cp -f "$f" "$TARGET/etc/alpm/"; }
	done
	cp -f /etc/alpm/repos.d/*.repo "$TARGET/etc/alpm/repos.d/" 2>/dev/null || :
	cp -a /var/lib/alpm/sync/. "$TARGET/var/lib/alpm/sync/" 2>/dev/null || :

	step "Installing the base system" "$PKGS_MAIN"
	if [ "$A_NET" = offline ]; then
		# Everything we need is already on the ISO's own package cache.
		mkdir -p "$TARGET/var/cache/alpm/pkg"
		cp -f /var/cache/alpm/pkg/*.alpmz "$TARGET/var/cache/alpm/pkg/" 2>/dev/null || :
	fi
	target_alpm ins $PKGS_MAIN || bail "the base system failed to install - see $LOGF"

	step "Installing the kernel" "$A_KERNEL"
	# -nomod keeps the kernel out of the bootloader until 'arctic-boot-strap' runs.
	target_alpm ins -nomod "$A_KERNEL" || bail "could not install $A_KERNEL"
	uc=$(detect_microcode)
	[ "$uc" != none ] && target_alpm ins "$uc" || :

	step "Installing firmware" "linux-firmware"
	case "$A_KERNEL" in
	Arctic-libre-kernel) logit "libre kernel: skipping nonfree firmware" ;;
	*) target_alpm ins linux-firmware || warn_soft "firmware not installed" ;;
	esac

	step "Installing network tools" "$PKGS_NET"
	target_alpm ins $PKGS_NET || :

	step "Installing base utilities" "$PKGS_EXTRA_BASE"
	target_alpm ins $PKGS_EXTRA_BASE || :

	install_init
	[ "$A_PKGIT" = y ] && install_pkgit || :

	step "Installing graphics drivers" "$A_GPU"
	g=$A_GPU
	[ "$g" = auto ] && g=$(detect_gpu)
	case "$g" in
	nvidia)
		# gcc-libs and libglvnd are not optional here: libnvidia-api needs
		# libstdc++.so.6 and libnvidia-rtcore needs libgcc_s.so.1, and glvnd is
		# what lets the NVIDIA GL live alongside mesa. gmake goes in too, so the
		# kernel module can be rebuilt when the kernel changes.
		target_alpm ins gcc-libs libglvnd gmake || :
		target_alpm ins nvidia-drivers nvidia-utils || : ;;
	nouveau) target_alpm ins mesa nouveau-drivers || : ;;
	amd) target_alpm ins mesa vulkan-radeon libva-mesa-driver || : ;;
	intel) target_alpm ins mesa vulkan-intel intel-media-driver || : ;;
	*) target_alpm ins mesa || : ;;
	esac

	step "Installing the desktop" "$A_DESKTOP"
	# The profile packages pull the whole environment - session, applications,
	# display manager, fonts and audio - so a desktop is one choice rather
	# than a list of parts to keep in step by hand. Falling back to the
	# individual packages keeps this working on a repo that has the pieces
	# but not the profile.
	case "$A_DESKTOP" in
	kde)   target_alpm ins arctic-kde  || target_alpm ins plasma-meta konsole dolphin || : ;;
	xfce)  target_alpm ins arctic-xfce || target_alpm ins xfce4-meta xorg-server || : ;;
	niri)  target_alpm ins niri-dms    || target_alpm ins niri waybar fuzzel || : ;;
	dwm)   target_alpm ins apiwow-dwm  || target_alpm ins dwm st dmenu xorg-server || : ;;
	none)  logit "no desktop requested" ;;
	esac

	# A desktop that came with its own display manager does not need another.
	# Only install one when it was asked for explicitly, or when a desktop
	# was chosen and the config left A_DM unset.
	dm=$A_DM
	if [ -z "$dm" ]; then
		case "$A_DESKTOP" in
		kde)  dm=sddm ;;
		xfce) dm=lightdm ;;
		*)    dm=none ;;
		esac
	fi
	case "$dm" in
	sddm)    target_alpm ins sddm sddm-arctic-theme || : ;;
	lightdm) target_alpm ins lightdm || : ;;
	greetd)  target_alpm ins greetd tuigreet || : ;;
	none)    : ;;
	esac
	A_DM=$dm

	step "Installing fonts" "${A_FONTS:-none}"
	[ -n "$A_FONTS" ] && target_alpm ins $A_FONTS || :
	step "Installing selected packages" "${A_PKGS:-none}"
	[ -n "$A_PKGS" ] && target_alpm ins $A_PKGS || :
	step "Installing package sets" "${A_SETS:-none}"
	for _set in $A_SETS; do
		case "$_set" in
		devel)  target_alpm ins cmake llvm meson ninja pkgconf gmake gdb || : ;;
		net)    target_alpm ins curl wget rsync openssh nmap || : ;;
		media)  target_alpm ins ffmpeg mpv || : ;;
		office) target_alpm ins libreoffice || : ;;
		virt)   target_alpm ins qemu libvirt docker podman containerd crun conmon || : ;;
		gaming) target_alpm ins wine steam gamemode gamescope dxvk || : ;;
		cli)    target_alpm ins ripgrep fd bat eza fzf zoxide || : ;;
		esac
	done
	# arctic-sound is the whole working stack: pipewire, wireplumber, the
	# pulse shim so anything expecting PulseAudio still plays, and alsamixer
	# for when levels need setting directly.
	[ "$A_AUDIO" = y ] && { target_alpm ins arctic-sound || \
		target_alpm ins pipewire wireplumber pipewire-pulse alsa-utils || :; }
	[ "$A_BLUETOOTH" = y ] && target_alpm ins bluez bluez-utils || :
	if [ "$A_SSH" = y ]; then
		target_alpm ins openssh || :
		if [ "$A_SSH_PASSWORD_AUTH" = n ] && [ -f "$TARGET/etc/ssh/sshd_config" ]; then
			if grep -q '^#\?PasswordAuthentication' "$TARGET/etc/ssh/sshd_config"; then
				sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' \
					"$TARGET/etc/ssh/sshd_config"
			else
				printf 'PasswordAuthentication no\n' >>"$TARGET/etc/ssh/sshd_config"
			fi
		fi
	fi
	[ "$A_FIREWALL" = y ] && target_alpm ins nftables || :

	step "Installing filesystem tools" "$A_ROOT_FS"
	case "$A_ROOT_FS" in
	btrfs) target_alpm ins btrfs-progs || : ;;
	xfs)   target_alpm ins xfsprogs || : ;;
	f2fs)  target_alpm ins f2fs-tools || : ;;
	zfs)   logit "zfs userspace tools are not packaged for Arctic yet" ;;
	*)     target_alpm ins e2fsprogs || : ;;  # ext4, ext3, ext2
	esac
	if [ "$A_ENCRYPT" = y ]; then
		step "Installing cryptsetup" "LUKS"
		target_alpm ins cryptsetup || warn_soft "cryptsetup did not install"
	fi

	step "Setting up snapshots" "${A_SNAPSHOT:-none}"
	setup_snapshots

	step "Writing fstab" "/etc/fstab"
	write_fstab

	step "Writing crypttab" "/etc/crypttab"
	write_crypttab

	step "Setting up swap" "$A_SWAP"
	setup_swap

	if [ "$A_ZRAM" = y ]; then
		step "Setting up zram" "$A_ZRAM_SIZE compressed with $A_ZRAM_ALGO"
		mkdir -p "$TARGET/etc/arctic" "$TARGET/etc/modules-load.d"
		printf 'ZRAM_SIZE=%s\nZRAM_ALGO=%s\n' "$A_ZRAM_SIZE" "$A_ZRAM_ALGO" \
			>"$TARGET/etc/arctic/zram.conf"
		grep -q '^zram$' "$TARGET/etc/modules-load.d/arctic.conf" 2>/dev/null || \
			printf 'zram\n' >>"$TARGET/etc/modules-load.d/arctic.conf"
	fi

	step "Configuring locale" "$A_LOCALE"
	printf '%s UTF-8\n' "$A_LOCALE" >"$TARGET/etc/locale.gen"
	printf 'LANG=%s\nLC_COLLATE=C\n' "$A_LANG" >"$TARGET/etc/locale.conf"
	printf 'KEYMAP=%s\nFONT=%s\n' "$A_KEYMAP" "${A_CONSOLE_FONT:-arctic}" >"$TARGET/etc/vconsole.conf"
	chroot_run locale-gen 2>/dev/null || logit "locale-gen unavailable, skipped"

	step "Setting the time zone" "$A_TZ"
	if [ -f "$TARGET/usr/share/zoneinfo/$A_TZ" ]; then
		ln -sf "/usr/share/zoneinfo/$A_TZ" "$TARGET/etc/localtime"
	else
		logit "zoneinfo for $A_TZ missing on the target"
	fi
	printf '%s\n' "$A_TZ" >"$TARGET/etc/timezone"

	step "Setting the hostname" "$A_HOSTNAME"
	printf '%s\n' "$A_HOSTNAME" >"$TARGET/etc/hostname"
	cat >"$TARGET/etc/hosts" <<EOF
127.0.0.1	localhost
::1		localhost
127.0.1.1	$A_HOSTNAME.localdomain	$A_HOSTNAME
EOF

	step "Creating the user account" "$A_USER"
	create_users

	step "Configuring doas" "/etc/doas.conf"
	cat >"$TARGET/etc/doas.conf" <<EOF
# Arctic Linux - doas rules
# Members of the wheel group may act as root after entering their password.
permit persist :wheel
# Let anyone in wheel sync repositories without a prompt; it changes nothing.
permit nopass :wheel cmd alpm args fetch all
EOF
	chmod 0400 "$TARGET/etc/doas.conf"

	step "Configuring the network" "$A_NET"
	configure_network

	step "Enabling services" "init"
	enable_services

	step "Writing the Arctic release file" "/etc/arctic-release"
	write_release

	step "Generating the initramfs" "$A_KERNEL"
	chroot_run arctic-mkinitramfs || logit "initramfs generation skipped"

	step "Seeding system.conf" "the declarative starting point"
	seed_system_conf

	step "Recording generation 1" "the install itself"
	# Generation 1 is the machine exactly as installed. Recording it here
	# rather than waiting for the first arctic-rebuild means there is always
	# something to roll back to - including from the very first rebuild,
	# which is the one most likely to be wrong.
	chroot_run arctic-generation create "initial install" >/dev/null 2>&1 || \
		logit "could not record generation 1"

	if [ -n "$A_POST" ]; then
		step "Running post-install commands" "A_POST"
		if chroot_run "$A_POST"; then
			logit "A_POST commands finished"
		else
			warn_soft "one or more A_POST commands failed - see $LOGF"
		fi
	fi

	# mkiso's 00-medium-*.repo files point at file:///run/arctic/medium/... -
	# real on the live session this install ran from, gone the moment this
	# system boots on its own without that disc/USB in it. mkiso disabled
	# the matching network repo rather than deleting it specifically so this
	# step could put it back; skipping it left every fresh install with
	# main/kernels/source/profile silently unreachable afterward, until
	# someone noticed 'alpm fetch' coming up empty and fixed repos.d by
	# hand. Done last, once every package this install needs has already
	# come from wherever it was actually going to come from.
	step "Restoring network repositories" "medium repos were only for install time"
	rm -f "$TARGET"/etc/alpm/repos.d/00-medium-*.repo
	for r in main kernels source profile; do
		f="$TARGET/etc/alpm/repos.d/$r.repo"
		[ -f "$f" ] && sed -i 's/^enabled = no$/enabled = yes/' "$f"
	done

	step "Finishing up" "cleaning the cache"
	rm -rf "$TARGET/var/cache/alpm/build"/* 2>/dev/null || :
	# The first boot of a finished install shows the Arctic greeting.
	: >"$TARGET/var/lib/arctic/firstboot" 2>/dev/null || {
		mkdir -p "$TARGET/var/lib/arctic"; : >"$TARGET/var/lib/arctic/firstboot"; }
	sync

	tui_gauge "Done" 100
	sleep 1
}

# The single entry point: partition (if A_DISK asked for it), install, and
# wire up the bootloader - one command, nothing to pre-mount by hand.
run_install() {
	: >"$LOGF"
	tui_gauge_init 41

	if [ -n "$A_DISK" ]; then
		partition_disk
	else
		mount_existing
	fi

	do_install

	# The bootloader goes in either way now - it used to only run on the
	# A_DISK path, which left anyone using their own partitions with an
	# installed system that could not boot.
	if true; then
		bootstrap=$(dirname "$0")/arctic-boot-strap
		[ -x "$bootstrap" ] || bootstrap=arctic-boot-strap
		if [ -n "$A_ESP" ]; then
			bootdir="$TARGET$A_BOOT_MOUNT"; bootflag="--efi"
		elif [ -n "$A_BIOS_BOOTPART" ]; then
			bootdir="$TARGET$A_BIOS_BOOT_MOUNT"; bootflag="--bios"
		else
			# Manually-partitioned installs (A_ROOT_PART, no A_BOOT_PART) get
			# no A_BIOS_BOOTPART from partition_disk - there really is no
			# separate /boot mount in that layout, so hand it the root
			# itself, same as before. Whoever partitioned by hand and picked
			# ext4 as A_ROOT_FS will hit the same "Limine can't read this on
			# BIOS" problem partition_disk's own layout now avoids; nothing
			# short of them adding a real /boot fixes that case.
			bootdir="$TARGET"; bootflag="--bios"
		fi
		step "Installing the bootloader" "$A_BOOT_FW"
		if [ -n "$A_BOOTLOADER" ] && [ "$A_BOOT_FW" = bios ]; then
			set -- "$bootdir" "$bootflag" "--loader=$A_BOOTLOADER"
		else
			set -- "$bootdir" "$bootflag"
		fi
		if "$bootstrap" "$@" >>"$LOGF" 2>&1; then
			logit "bootloader installed"
		else
			warn_soft "arctic-boot-strap failed - see $LOGF, then run it by hand"
		fi
	fi
}

# tui_log_line exists precisely so a non-fatal problem does not vanish into
# $LOGF unseen while the gauge keeps climbing to 100% - a warning here still
# means "still installed, but go check this" and the operator should not have
# to know to look at a log file to find out something needs their attention.
warn_soft() { logit "warning: $*"; tui_log_line "warning: $*"; }

# Snapshots only mean anything on btrfs, so everything here is conditional on it.
setup_snapshots() {
	[ "$A_ROOT_FS" = btrfs ] || { logit "not btrfs, skipping snapshot setup"; return 0; }
	case "${A_SNAPSHOT:-none}" in none|"") logit "snapshots declined"; return 0 ;; esac

	mkdir -p "$TARGET/etc/arctic" "$TARGET/.snapshots"
	cat >"$TARGET/etc/arctic/snapshot.conf" <<-EOF
		# Written by arctic-install.
		# Which tool arctic-snapshot hands over to. It drives btrfs directly
		# when that tool is not installed, which is what both of them do
		# underneath anyway.
		TOOL=$A_SNAPSHOT
		SUBVOL_DIR=/.snapshots
		# How many automatic snapshots to keep before the oldest are pruned.
		KEEP=20
	EOF

	# The real tool, if we have a package for it. alpm calls "arctic-snapshot
	# create" before every install and removal (see alpm/alpm's tx_snapshot),
	# and arctic-snapshot itself reads TOOL= above to decide who to delegate to.
	case "$A_SNAPSHOT" in
	timeshift) target_alpm ins timeshift 2>/dev/null || \
		logit "timeshift package not available; arctic-snapshot will drive btrfs directly" ;;
	snapper)   target_alpm ins snapper 2>/dev/null || \
		logit "snapper package not available; arctic-snapshot will drive btrfs directly" ;;
	esac
	logit "snapshots configured: $A_SNAPSHOT"
}

chroot_run() {
	[ -x "$TARGET/usr/bin/env" ] || [ -x "$TARGET/bin/sh" ] || return 1
	mount --bind /dev "$TARGET/dev" 2>/dev/null || :
	mount --bind /proc "$TARGET/proc" 2>/dev/null || :
	mount --bind /sys "$TARGET/sys" 2>/dev/null || :
	chroot "$TARGET" /bin/sh -lc "$*" >>"$LOGF" 2>&1
	rc=$?
	umount "$TARGET/dev" "$TARGET/proc" "$TARGET/sys" 2>/dev/null || :
	return $rc
}

# genfstab - write /etc/fstab from what is actually mounted right now.
#
# Everything comes out of /proc/mounts rather than from the config: whatever
# the install ended up with is what gets recorded, so a hand-made partition
# layout, a btrfs subvolume set that is not the default one, and an ordinary
# single-partition ext4 install all produce a correct fstab without this
# needing to know which of them happened.
#
# Devices are written as PARTUUID= (falling back to filesystem UUID= for
# anything that is not an actual partition, like a LUKS/device-mapper root)
# so nothing breaks when the kernel enumerates disks in a different order on
# the next boot. PARTUUID specifically, not filesystem UUID: arctic-boot-strap
# reads the root line straight back out of this fstab for the kernel's own
# root= parameter, and testing found the kernel's built-in root=UUID=
# resolution does not reliably find a match that early in boot (no initramfs
# tooling has run yet to help it) - it panics with "VFS: Unable to mount root
# fs on unknown-block(0,0)" even though the partition is right there. PARTUUID
# comes straight from the partition table itself, no filesystem probing
# needed, so the kernel resolves it immediately.
genfstab() {
	_t=${1:-$TARGET}
	printf '# Arctic Linux - /etc/fstab\n'
	printf '# Generated by arctic-install from the live mount table.\n'
	printf '# <device>\t<mount>\t<type>\t<options>\t<dump>\t<pass>\n'

	# Longest paths last so /boot/efi is written after /boot, which is the
	# order mount(8) needs to be able to replay them at boot.
	awk -v t="$_t" '
		$2 == t          { print $1, "/",                    $3, $4; next }
		index($2, t"/")==1 { print $1, substr($2, length(t)+1), $3, $4 }
	' /proc/mounts | sort -k2,2 | while read -r dev mnt type opts; do
		case "$type" in
		autofs|proc|sysfs|devtmpfs|devpts|tmpfs|cgroup*|securityfs|debugfs|\
		tracefs|mqueue|hugetlbfs|configfs|fusectl|pstore|bpf|ramfs|squashfs|overlay)
			continue ;;
		esac
		case "$dev" in /dev/*) ;; *) continue ;; esac

		partuuid=$(blkid -s PARTUUID -o value "$dev" 2>/dev/null)
		if [ -n "$partuuid" ]; then
			spec="PARTUUID=$partuuid"
		else
			uuid=$(blkid -s UUID -o value "$dev" 2>/dev/null)
			spec=${uuid:+UUID=$uuid}; spec=${spec:-$dev}
		fi

		# Keep only the mount options worth persisting. The kernel reports
		# plenty that are either defaults or meaningless in fstab.
		keep=""
		OIFS=$IFS; IFS=,
		for o in $opts; do
			case "$o" in
			rw|ro|noatime|relatime|nodiratime|nosuid|nodev|noexec|discard*|\
			compress=*|compress-force=*|subvol=*|subvolid=*|space_cache*|\
			ssd|autodefrag|commit=*|fmask=*|dmask=*|utf8*|iocharset=*|\
			shortname=*|errors=*|data=*|barrier*|journal_checksum)
				keep="${keep:+$keep,}$o" ;;
			esac
		done
		IFS=$OIFS
		[ -n "$keep" ] || keep=defaults

		# fsck pass: root first, other real filesystems after, never for
		# btrfs (which has no fsck to run at boot) or vfat ESPs.
		case "$type" in
		btrfs)     pass=0 ;;
		vfat)      pass=2 ;;
		*) [ "$mnt" = / ] && pass=1 || pass=2 ;;
		esac
		[ "$mnt" = / ] && [ "$type" = btrfs ] && pass=0

		printf '%s\t%s\t%s\t%s\t0\t%s\n' "$spec" "$mnt" "$type" "$keep" "$pass"
	done

	printf 'tmpfs\t/tmp\ttmpfs\trw,nosuid,nodev,size=50%%\t0\t0\n'
	printf 'proc\t/proc\tproc\trw,nosuid,nodev,noexec\t0\t0\n'
	printf 'sysfs\t/sys\tsysfs\trw,nosuid,nodev,noexec\t0\t0\n'
	printf 'devpts\t/dev/pts\tdevpts\trw,nosuid,noexec,gid=5,mode=620\t0\t0\n'
}

# The installed system's declarative configuration, written from what this
# install actually did. Without this, the first arctic-rebuild on a new
# machine has an empty system.conf and has to seed itself - which works, but
# means the file does not describe the machine until someone runs a rebuild.
seed_system_conf() {
	mkdir -p "$TARGET/etc/arctic"
	f="$TARGET/etc/arctic/system.conf"
	{
		printf '# Arctic Linux - declarative system configuration\n'
		printf '#\n'
		printf '# This is the machine, as a file. Edit it, then run:\n'
		printf '#\n'
		printf '#     arctic-rebuild\n'
		printf '#\n'
		printf '# Every field below is the complete, authoritative value - not something\n'
		printf '# to add to. SYS_PACKAGES/SYS_SERVICES/SYS_USERS list everything that\n'
		printf '# should exist; removing a name removes it on the next rebuild. SYS_USERS\n'
		printf '# is the one exception: an existing account not listed is left alone\n'
		printf '# rather than deleted.\n'
		printf '#\n'
		printf '# Every rebuild records a generation first, so a bad edit can be undone\n'
		printf '# with `arctic rollback` - or from the boot menu if it will not boot.\n'
		printf '#\n'
		printf '# Written by arctic-install %s from the install itself.\n\n' \
			"$(date '+%Y-%m-%d %H:%M:%S')"

		printf 'SYS_DESCRIPTION=""\n\n'

		printf 'SYS_HOSTNAME="%s"\n' "$A_HOSTNAME"
		printf 'SYS_TZ="%s"\n' "$A_TZ"
		printf 'SYS_LOCALE="%s"\n' "$A_LOCALE"
		printf 'SYS_LANG="%s"\n' "$A_LANG"
		printf 'SYS_KEYMAP="%s"\n\n' "$A_KEYMAP"

		printf 'SYS_USERS="\n'
		if [ -n "$A_USER" ]; then
			# chroot_run logs to $LOGF rather than returning output through a
			# command substitution, so this uses what the config itself
			# declared rather than querying the account back out of the
			# chroot - the same groups create_users() actually applied.
			ug=$(printf '%s' "$A_USER_GROUPS" | tr -s ' ' ',')
			printf '\t%s:%s:%s\n' "$A_USER" "$A_SHELL" "$ug"
		fi
		printf '"\n\n'

		printf 'SYS_SERVICES="\n'
		for s in "$TARGET"/etc/arctic/services/*; do
			[ -e "$s" ] || continue
			printf '\t%s\n' "$(basename "$s")"
		done
		printf '"\n\n'

		printf 'SYS_PACKAGES="\n'
		for d in "$TARGET"/var/lib/alpm/local/*/; do
			[ -d "$d" ] || continue
			[ "$(cat "$d/REASON" 2>/dev/null)" = explicit ] || continue
			printf '\t%s\n' "$(basename "$d")"
		done
		printf '"\n\n'

		nf=no
		for r in "$TARGET"/etc/alpm/repos.d/*nonfree*.repo; do
			[ -f "$r" ] || continue
			grep -q '^enabled = yes' "$r" 2>/dev/null && nf=yes
		done
		printf 'SYS_ALLOW_NONFREE="%s"\n' "$nf"
	} >"$f"
	logit "seeded $f"
}

write_fstab() {
	genfstab "$TARGET" >"$TARGET/etc/fstab"

	# genfstab always gives /tmp a plain tmpfs line; A_HARDEN_TMP just adds
	# noexec to it rather than writing a second, conflicting entry.
	if [ "$A_HARDEN_TMP" = y ]; then
		sed -i \
			's#^tmpfs\t/tmp\ttmpfs\trw,nosuid,nodev,#tmpfs\t/tmp\ttmpfs\trw,nosuid,nodev,noexec,#' \
			"$TARGET/etc/fstab"
	fi

	if [ -n "$A_MOUNTS" ]; then
		printf '\n# Extra mounts from install.conf (A_MOUNTS)\n' >>"$TARGET/etc/fstab"
		printf '%s\n' "$A_MOUNTS" | while read -r dev mnt fst opts; do
			case "$dev" in ""|\#*) continue ;; esac
			printf '%s\t%s\t%s\t%s\t0\t2\n' "$dev" "$mnt" "$fst" "${opts:-defaults}"
		done >>"$TARGET/etc/fstab"
	fi

	logit "fstab written:"
	sed 's/^/    /' "$TARGET/etc/fstab" >>"$LOGF"
}

# /etc/crypttab is the one thing arctic-mkinitramfs actually reads to decide
# whether to bundle cryptsetup and the dm-crypt/essiv modules at all - see
# that script for why. A_ROOTDEV is the raw partition auto_partition laid
# LUKS onto (kept separate from the /dev/mapper/cryptroot path that actually
# got formatted and mounted), so its LUKS UUID is what both this and the
# boot loader's kernel command line need.
write_crypttab() {
	[ "$A_ENCRYPT" = y ] || return 0
	[ -n "$A_ROOTDEV" ] || { warn_soft "encryption chosen but no root device recorded"; return 0; }
	uuid=$(blkid -s UUID -o value "$A_ROOTDEV" 2>/dev/null)
	[ -n "$uuid" ] || { warn_soft "could not read the LUKS UUID of $A_ROOTDEV"; return 0; }
	printf 'cryptroot\tUUID=%s\tnone\tluks\n' "$uuid" >"$TARGET/etc/crypttab"
	chmod 600 "$TARGET/etc/crypttab"
}

setup_swap() {
	case "$A_SWAP" in
	none) return 0 ;;
	partition)
		[ -n "$A_SWAPDEV" ] || return 0
		run mkswap -L arctic-swap "$A_SWAPDEV" || return 0
		uuid=$(blkid -s UUID -o value "$A_SWAPDEV" 2>/dev/null)
		printf '%s\tnone\tswap\tsw,pri=10\t0\t0\n' "${uuid:+UUID=$uuid}${uuid:-$A_SWAPDEV}" \
			>>"$TARGET/etc/fstab"
		return 0 ;;
	file)
		sz=$(printf '%s' "$A_SWAPSIZE" | sed 's/[Gg]$//')
		mb=$(( ${sz:-4} * 1024 ))
		logit "creating a ${mb}MiB swap file"
		# fallocate leaves holes on some filesystems, so write it out.
		if ! run fallocate -l "${mb}M" "$TARGET/swapfile"; then
			run dd if=/dev/zero of="$TARGET/swapfile" bs=1M count="$mb"
		fi
		chmod 600 "$TARGET/swapfile"
		run mkswap "$TARGET/swapfile" || return 0
		printf '/swapfile\tnone\tswap\tsw,pri=10\t0\t0\n' >>"$TARGET/etc/fstab"
		return 0 ;;
	esac
}

create_users() {
	# Groups first. Arctic uses wheel for administrative access.
	#
	# netdev is not decoration: NetworkManager (like iwd before it) ships a
	# D-Bus policy referencing that group, and dbus-daemon rejects a policy
	# naming a group that does not exist. The whole file is then ignored
	# and NetworkManager fails to claim its bus name - with a running dbus
	# sitting right there, which is what made this look like a dbus problem
	# rather than a missing group the one time it happened with iwd.
	#
	# Without polkit (not built here - see the networkmanager recipe),
	# actually changing a connection over nmcli/nmtui still needs root:
	# NetworkManager's own D-Bus policy falls back to uid=0-only for the
	# settings-modification methods when polkit isn't present to ask
	# instead. `doas nmtui` is the expected way to run it as A_USER.
	for g in wheel audio video input storage network netdev render kvm; do
		chroot_run "grep -q '^$g:' /etc/group || addgroup -S $g" || :
	done
	# dbus-daemon --system drops root to this user once it has bound the bus
	# socket - see /usr/share/dbus-1/system.conf. Without the account it
	# cannot start at all, which is why plain iwd (needs the system bus to
	# register itself) used to fail with "failed to initialize dbus" - and
	# NetworkManager needs it for the exact same reason now.
	chroot_run "grep -q '^messagebus:' /etc/group || addgroup -S messagebus" || :
	chroot_run "grep -q '^messagebus:' /etc/passwd || \
		adduser -S -H -D -G messagebus -s /sbin/nologin messagebus" || :
	if [ -n "$A_USER" ]; then
		chroot_run "adduser -D -s $A_SHELL -h /home/$A_USER $A_USER" || \
			chroot_run "useradd -m -s $A_SHELL $A_USER" || :
		for g in wheel audio video input storage network render; do
			chroot_run "addgroup $A_USER $g 2>/dev/null || usermod -aG $g $A_USER" || :
		done
		if [ -n "$A_USERPASS" ]; then
			printf '%s:%s\n' "$A_USER" "$A_USERPASS" | \
				chroot "$TARGET" chpasswd >>"$LOGF" 2>&1 || \
				logit "could not set the password for $A_USER"
		fi
		# Drop the Arctic shell configuration into the new home.
		for f in .zshrc .zshenv .zprofile; do
			[ -f "$TARGET/etc/skel/$f" ] && \
				cp -f "$TARGET/etc/skel/$f" "$TARGET/home/$A_USER/$f"
		done
	fi
	# A_SSH_KEYS goes to whichever account will actually be logged into -
	# A_USER if there is one, root otherwise.
	if [ -n "$A_SSH_KEYS" ]; then
		if [ -n "$A_USER" ]; then kd="$TARGET/home/$A_USER/.ssh"
		else kd="$TARGET/root/.ssh"; fi
		mkdir -p "$kd"
		printf '%s\n' "$A_SSH_KEYS" >"$kd/authorized_keys"
		chmod 700 "$kd"; chmod 600 "$kd/authorized_keys"
		logit "wrote authorized_keys to $kd"
	fi
	[ -n "$A_USER" ] && { chroot_run "chown -R $A_USER:$A_USER /home/$A_USER" || :; }
	if [ "$A_LOCK_ROOT" = y ] && [ -n "$A_USER" ]; then
		chroot_run "passwd -l root" || :
		logit "root account locked (A_LOCK_ROOT=y)"
	elif [ "$A_ROOTPASS" = "!locked" ]; then
		chroot_run "passwd -l root" || :
		logit "root account locked"
	elif [ -n "$A_ROOTPASS" ]; then
		printf 'root:%s\n' "$A_ROOTPASS" | \
			chroot "$TARGET" chpasswd >>"$LOGF" 2>&1 || logit "could not set the root password"
	fi
}

# NetworkManager keyfile connections need a real UUID or they fail to load
# at all; /proc/sys/kernel/random/uuid is always there, no uuidgen needed.
gen_uuid() { cat /proc/sys/kernel/random/uuid 2>/dev/null || echo "00000000-0000-0000-0000-000000000000"; }

configure_network() {
	mkdir -p "$TARGET/etc/NetworkManager/system-connections"
	case "$A_NET" in
	wifi)
		# NetworkManager's keyfile plugin: one file per connection, mode 600
		# (it refuses to load a world-readable one - the PSK is right there
		# in plain text).
		if [ -n "$A_WIFI_SSID" ]; then
			f="$TARGET/etc/NetworkManager/system-connections/arctic-wifi.nmconnection"
			{
				printf '[connection]\n'
				printf 'id=%s\n' "$A_WIFI_SSID"
				printf 'uuid=%s\n' "$(gen_uuid)"
				printf 'type=wifi\n'
				printf 'autoconnect=true\n'
				[ -n "$A_WIFI_IFACE" ] && printf 'interface-name=%s\n' "$A_WIFI_IFACE"
				printf '\n[wifi]\n'
				printf 'mode=infrastructure\n'
				printf 'ssid=%s\n' "$A_WIFI_SSID"
				printf '\n[wifi-security]\n'
				printf 'key-mgmt=wpa-psk\n'
				printf 'psk=%s\n' "$A_WIFI_PSK"
				printf '\n[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
			} >"$f"
			chmod 600 "$f"
		fi
		;;
	static)
		f="$TARGET/etc/NetworkManager/system-connections/arctic-wired.nmconnection"
		{
			printf '[connection]\n'
			printf 'id=arctic-wired\n'
			printf 'uuid=%s\n' "$(gen_uuid)"
			printf 'type=ethernet\n'
			printf 'autoconnect=true\n'
			printf '\n[ipv4]\n'
			printf 'method=manual\n'
			printf 'address1=%s,%s\n' "$A_IP" "$A_GATEWAY"
			dns=$(printf '%s' "$A_DNS" | tr ' ' ';')
			printf 'dns=%s;\n' "$dns"
			printf '\n[ipv6]\nmethod=auto\n'
		} >"$f"
		chmod 600 "$f"
		;;
	*)
		# dhcp, and offline too - matching the previous behaviour, where
		# "offline" never actually meant no networking, it meant "no
		# explicit config", and rc.d/network's own default case ran DHCP
		# regardless. No profile is written here; NetworkManager brings up
		# a wired interface with its own auto-default DHCP connection the
		# same way, so the observable result doesn't change.
		:
		;;
	esac

	# Randomise the MAC NetworkManager presents per network rather than
	# broadcasting the adapter's real, permanent one - a global default
	# applied to every connection, not just the one written above.
	if [ "$A_MAC_RANDOMIZE" = y ]; then
		mkdir -p "$TARGET/etc/NetworkManager/conf.d"
		printf '[connection]\nwifi.cloned-mac-address=stable\n' \
			>"$TARGET/etc/NetworkManager/conf.d/mac-randomization.conf"
	fi
}

enable_services() {
	svc() {
		mkdir -p "$TARGET/etc/arctic/services"
		: >"$TARGET/etc/arctic/services/$1"
		logit "enabled service $1"
	}
	svc udev
	svc dbus
	# NetworkManager replaces the old rc.d/network + iwd pairing outright -
	# it drives DHCP, static config and wifi (via wpa_supplicant) all
	# itself, so it is enabled unconditionally the same way rc.d/network
	# used to be, not only when A_NET=wifi.
	svc NetworkManager
	[ "$A_NTP" = y ] && svc ntpd
	[ "$A_SSH" = y ] && svc sshd
	[ "$A_FIREWALL" = y ] && svc nftables
	[ "$A_BLUETOOTH" = y ] && svc bluetoothd
	[ "$A_AUDIO" = y ] && svc pipewire
	[ "$A_TRIM" = y ] && [ "$(detect_rotational)" = ssd ] && svc fstrim
	[ "$A_ZRAM" = y ] && svc zram
	case "${A_DM:-none}" in
	sddm)    svc sddm ;;
	lightdm) svc lightdm ;;
	greetd)  svc greetd ;;
	esac
	for s in $A_SERVICES; do svc "$s"; done
	:
}

write_release() {
	cat >"$TARGET/etc/arctic-release" <<EOF
NAME="Arctic Linux"
PRETTY_NAME="Arctic Linux"
ID=arctic
BUILD_ID=$(date '+%Y.%m.%d')
KERNEL=$A_KERNEL
INSTALLED=$(date '+%Y-%m-%d %H:%M:%S')
INSTALLER="arctic-install $VERSION"
LIBC=glibc
TOOLCHAIN=llvm
USERLAND=bsd
INIT=busybox
HOME_URL="https://github.com/apiwo/arctic-linux"
EOF
	ln -sf /etc/arctic-release "$TARGET/etc/os-release" 2>/dev/null || \
		cp "$TARGET/etc/arctic-release" "$TARGET/etc/os-release"
	printf 'Arctic Linux \\r (\\l)\n\n' >"$TARGET/etc/issue"
}

finished_banner() {
	if [ -n "$A_DISK" ]; then
		cat <<EOF

$(printf '%s' "$c_teal$t_bold")  Arctic Linux is installed on $A_DISK, bootloader included.$(printf '%s' "$t_reset")

  To change anything inside the new system first:

      $(printf '%s' "$c_snow")arctic-chroot$(printf '%s' "$t_reset")

  Otherwise:

      $(printf '%s' "$c_snow")reboot$(printf '%s' "$t_reset")

EOF
	else
		cat <<EOF

$(printf '%s' "$c_teal$t_bold")  Arctic Linux is installed.$(printf '%s' "$t_reset")

  Next: mount the boot partition and install the bootloader.

      $(printf '%s' "$c_snow")mount /dev/nvme0n1p2 $TARGET/boot$(printf '%s' "$t_reset")
      $(printf '%s' "$c_snow")arctic-boot-strap $TARGET/boot --efi$(printf '%s' "$t_reset")   (or --bios)

  To change anything inside the new system first:

      $(printf '%s' "$c_snow")arctic-chroot$(printf '%s' "$t_reset")

  Otherwise:

      $(printf '%s' "$c_snow")reboot$(printf '%s' "$t_reset")

EOF
	fi
}

# ----------------------------------------------------------------------- main

need_root 2>/dev/null || { echo "Must be run as root." >&2; exit 1; }

FORCE=""
CHECKONLY=""
CFFILE="$CONF"
while [ $# -gt 0 ]; do
	case "$1" in
	-c|--config) shift; CFFILE=${1:?usage: arctic-install -c <file>}; shift ;;
	-f|--force)  FORCE=1; shift ;;
	-n|--check|--dry-run) CHECKONLY=1; shift ;;
	-h|--help|help)
		sed -n '2,27p' "$0" | sed 's/^# \?//'; exit 0 ;;
	--version)
		printf 'arctic-install %s\n' "$VERSION"; exit 0 ;;
	-*) echo "arctic-install: unknown option $1" >&2; exit 1 ;;
	*)
		# There is deliberately no target argument any more. The config
		# says which disk or partitions to use; where they get mounted
		# while installing is arctic-install's own business, not something
		# to type on the command line and keep in sync by hand.
		echo "arctic-install: unexpected argument: $1" >&2
		echo "  the target is set in $CONF (A_DISK or A_ROOT_PART), not here." >&2
		exit 1 ;;
	esac
done

# The dot builtin searches PATH when given a bare filename, so a relative path
# like "install.conf" is not found. Make it absolute first.
case "$CFFILE" in
/*) ;;
*) CFFILE="$(pwd)/$CFFILE" ;;
esac
if [ -f "$CFFILE" ]; then
	# shellcheck disable=SC1090
	. "$CFFILE"
elif [ "$CFFILE" != "$CONF" ]; then
	bail "no such config file: $CFFILE"
else
	echo "arctic-install: no config at $CONF - installing with built-in defaults" >&2
fi

# Where the target gets mounted while installing. Private to this script -
# under /run so it never survives a reboot and never collides with whatever
# the operator has mounted at /mnt themselves.
TARGET=/run/arctic/target
mkdir -p "$TARGET"

check_config
[ -n "$CHECKONLY" ] && exit 0

if [ -z "$FORCE" ]; then
	if detect_existing_install "$TARGET"; then
		printf '\033[38;5;215mThere is already an Arctic install on %s.\033[0m\n' "$TARGET"
		printf 'Continuing will overwrite files that belong to packages.\n\n'
	fi
	printf 'Make these changes? [y/N] '
	read -r a
	case "$a" in y|Y|yes) ;; *) echo "nothing was changed."; exit 0 ;; esac
fi

tui_init
run_install
tui_done

if [ "$A_CHROOT_SHELL" = y ]; then
	printf '\nA_CHROOT_SHELL=y - dropping into %s. Type "exit" when done.\n\n' "$TARGET"
	mount --bind /dev "$TARGET/dev" 2>/dev/null || :
	mount --bind /proc "$TARGET/proc" 2>/dev/null || :
	mount --bind /sys "$TARGET/sys" 2>/dev/null || :
	chroot "$TARGET" /bin/sh -l
	umount "$TARGET/dev" "$TARGET/proc" "$TARGET/sys" 2>/dev/null || :
fi

finished_banner

if [ "$A_REBOOT" = y ]; then
	printf '\nA_REBOOT=y - rebooting.\n'
	sleep 2
	reboot
fi
