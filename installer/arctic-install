A_BTRFS_OPTS=""
A_ENCRYPT="n"
A_ENCRYPT_PASS=""
A_SWAP="none"
A_SWAPSIZE="4G"
A_SWAPDEV=""
A_GPU="auto"
A_AUDIO="n"
A_BLUETOOTH="n"
A_SSH="n"
A_FIREWALL="y"
A_TRIM="auto"
A_EXTRA=""
A_FONTS=""
A_PKGS=""
A_SERVICES=""
A_SETS=""
