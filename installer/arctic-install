A_BOOT_MOUNT="/boot/efi"
A_BIOS_BOOT_MOUNT="/boot/limine"
A_BOOT_FS="vfat"
A_BOOT_TIMEOUT="3"
A_KERNEL_ARGS=""
A_GENERATIONS="5"
