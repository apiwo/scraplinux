#!/bin/sh
# arctic-qemu - boot the Arctic ISO in QEMU, or run a full install test.
#
#   arctic-qemu live            boot the ISO (BIOS), graphical window
#   arctic-qemu live-uefi       boot the ISO through OVMF (UEFI)
#   arctic-qemu install         boot the ISO with a blank 20G disk attached,
#                               so you can install onto it
#   arctic-qemu boot            boot that disk, after installing to it
#   arctic-qemu serial          boot the ISO with output on this terminal
#   arctic-qemu wipe            delete the test disk and UEFI variables
#
# The test disk and UEFI variables live under ~/.cache/arctic-qemu, so this works
# as an ordinary user even when the build tree belongs to root. Override with
# ARCTIC_QEMU_STATE.
# shellcheck shell=sh

set -u

B=${ARCTIC_BUILD:-/home/apiwo/arctic-build}

# State goes somewhere the invoking user can write. The build tree is owned by
# whoever ran the build (often root), and /tmp collides between users - both of
# which turn into a confusing "Permission denied" at the wrong moment.
STATE=${ARCTIC_QEMU_STATE:-${XDG_CACHE_HOME:-$HOME/.cache}/arctic-qemu}
DISK=$STATE/arctic-test.qcow2
VARS=$STATE/OVMF_VARS.fd
MEM=${ARCTIC_QEMU_MEM:-4096}
CPUS=${ARCTIC_QEMU_CPUS:-4}

OVMF_CODE=""
for f in /usr/share/edk2-ovmf/OVMF_CODE.fd /usr/share/edk2/x64/OVMF_CODE.4m.fd \
         /usr/share/OVMF/OVMF_CODE.fd /usr/share/qemu/OVMF_CODE.fd; do
	[ -f "$f" ] && { OVMF_CODE=$f; break; }
done
OVMF_VARS_SRC=$(printf '%s' "$OVMF_CODE" | sed 's/CODE/VARS/')

# Newest Arctic-*.iso, whatever the release is called - the name carries the
# version tag now (Arctic-alpha-v1-x86_64.iso), so a glob pinned to one past
# name silently kept booting an older image after a rebuild.
ISO=${ARCTIC_ISO:-$(ls -t "$B"/iso/Arctic-*.iso 2>/dev/null | head -1)}
[ -n "$ISO" ] && [ -f "$ISO" ] || {
	echo "arctic-qemu: no ISO found. Build one first:" >&2
	echo "  build/arctic-sandbox iso/mkiso minimal" >&2
	exit 1
}

KVM=""
[ -w /dev/kvm ] && KVM="-enable-kvm -cpu host"

# Pick a display backend that this QEMU actually has. A Gentoo qemu built
# without gtk and sdl cannot open a window at all and silently falls back to a
# VNC server, which looks like "nothing happened". Since Arctic is a text
# console system anyway, curses is a perfectly good default.
BACKENDS=$(qemu-system-x86_64 -display help 2>/dev/null)
have_backend() { printf '%s' "$BACKENDS" | grep -qx "[[:space:]]*$1"; }

pick_display() {
	case "${ARCTIC_QEMU_DISPLAY:-auto}" in
	auto) ;;
	*) printf '%s' "-display $ARCTIC_QEMU_DISPLAY"; return ;;
	esac
	if have_backend gtk; then printf '%s' "-display gtk"
	elif have_backend sdl; then printf '%s' "-display sdl"
	elif have_backend curses; then printf '%s' "-display curses"
	else printf '%s' "-display none -vnc 127.0.0.1:0"; fi
}

display_note() {
	if have_backend gtk || have_backend sdl; then return 0; fi
	if have_backend curses; then
		cat >&2 <<'NOTE'
   note: this QEMU was built without gtk or sdl, so there is no window to open.
         Using the curses display - the VGA console is drawn in this terminal.
         Leave with ctrl-a x.  For a real window instead:
           sudo emerge --newuse -a app-emulation/qemu   # with USE="gtk"
         Or watch it over VNC:
           ARCTIC_QEMU_DISPLAY=none arctic-qemu live-uefi   # then vncviewer :0

NOTE
	fi
}

mkdir -p "$STATE" 2>/dev/null || {
	echo "arctic-qemu: cannot write to $STATE" >&2
	echo "  set ARCTIC_QEMU_STATE to a directory you own" >&2
	exit 1
}

need_disk() {
	[ -f "$DISK" ] && return 0
	echo ":: creating a 20G test disk at $DISK"
	qemu-img create -f qcow2 "$DISK" 20G >/dev/null
}

need_vars() {
	[ -f "$VARS" ] && return 0
	[ -f "$OVMF_VARS_SRC" ] || { echo "arctic-qemu: no OVMF vars template" >&2; exit 1; }
	cp "$OVMF_VARS_SRC" "$VARS"
}

# shellcheck disable=SC2086
case "${1:-live}" in
live)
	echo ":: booting $(basename "$ISO") (BIOS)"
	display_note
	exec qemu-system-x86_64 $KVM -m "$MEM" -smp "$CPUS" \
		$(pick_display) -cdrom "$ISO" -boot d -no-reboot
	;;

live-uefi)
	need_vars
	echo ":: booting $(basename "$ISO") (UEFI)"
	display_note
	exec qemu-system-x86_64 $KVM -m "$MEM" -smp "$CPUS" \
		$(pick_display) \
		-drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
		-drive if=pflash,format=raw,file="$VARS" \
		-cdrom "$ISO" -no-reboot
	;;

install)
	need_disk; need_vars
	cat <<EOF

:: booting the installer with a blank disk attached (UEFI)

   Inside the VM, the disk is /dev/vda:

     vi /etc/arctic/install.conf   # uncomment A_DISK=/dev/vda, and anything else
     arctic-install

     poweroff

   That one command partitions /dev/vda, formats it, installs the base
   system and the bootloader, asking for confirmation first. To use
   partitions you made yourself instead, leave A_DISK commented out and
   point A_ROOT_PART / A_BOOT_PART at what you made:

     fdisk /dev/vda
       g          new GPT
       n  1  <enter>  +512M   then  t 1  and type 1  (EFI System)
       n  2  <enter>  <enter>
       w

     mkfs.vfat -F32 /dev/vda1
     mkfs.ext4 /dev/vda2
     vi /etc/arctic/install.conf
       A_ROOT_PART=/dev/vda2
       A_BOOT_PART=/dev/vda1
     arctic-install

     poweroff

   Then boot what you installed:   arctic-qemu boot

EOF
	display_note
	exec qemu-system-x86_64 $KVM -m "$MEM" -smp "$CPUS" \
		$(pick_display) \
		-drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
		-drive if=pflash,format=raw,file="$VARS" \
		-drive file="$DISK",if=virtio,format=qcow2 \
		-cdrom "$ISO" -boot d -no-reboot
	;;

boot)
	[ -f "$DISK" ] || { echo "no test disk yet - run: arctic-qemu install" >&2; exit 1; }
	need_vars
	echo ":: booting the installed system from $DISK"
	display_note
	exec qemu-system-x86_64 $KVM -m "$MEM" -smp "$CPUS" \
		$(pick_display) \
		-drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
		-drive if=pflash,format=raw,file="$VARS" \
		-drive file="$DISK",if=virtio,format=qcow2 \
		-no-reboot
	;;

serial)
	echo ":: booting on this terminal - log in as root, then 'poweroff'"
	echo "   (ctrl-a x also kills QEMU)"
	exec qemu-system-x86_64 $KVM -m "$MEM" -smp "$CPUS" \
		-cdrom "$ISO" -boot d -no-reboot \
		-nographic -serial mon:stdio -display none
	;;

wipe)
	rm -f "$DISK" "$VARS"
	echo "test disk and UEFI variables removed"
	;;

*)
	sed -n '2,14p' "$0" | sed 's/^# \?//'
	exit 1 ;;
esac
