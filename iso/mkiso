#!/bin/sh
# mkiso - build an Arctic Linux installation image.
#
#   mkiso minimal     Arctic-base-glibc: a TTY, zsh, and the installer
#
# There is one image on purpose. Arctic boots to a text console running zsh -
# no display manager, no desktop, no bash anywhere in the tree.
#
# The result is a hybrid image: it boots on BIOS and on UEFI, from a disc or
# from a USB stick written with dd.
#
# Layout inside the image:
#   /boot/vmlinuz-arctic          the kernel
#   /boot/initramfs-arctic.img    the early userspace that finds the medium
#   /boot/limine*                 the bootloader, for both firmware types
#   /arctic/rootfs.squashfs       the compressed root filesystem
#   /arctic/version               build metadata
#
# shellcheck shell=sh disable=SC2039

set -eu

PROFILE=${1:-minimal}
B=${ARCTIC_BUILD:-/home/apiwo/arctic-build}
SRCTREE=${ARCTIC_TREE:-/home/apiwo/arctic}
ROOTFS=$B/stage/rootfs
WORK=$B/iso/$PROFILE
OUT=$B/iso
KREL=$(cat "$B/stage/kernel-base/lib/modules"/*/../*.release 2>/dev/null || \
       ls "$B/stage/kernel-base/lib/modules" | head -1)
BUILD_ID=$(date '+%Y.%m.%d')
# One label for the whole distribution. Everything that shows a version -
# the ISO filename and volume id, /etc/arctic-release, the boot menu,
# arcticfetch's "os" line - reads it from here rather than spelling out its
# own variation of it.
#
# One dot, and the digits after it are read one at a time - not as a decimal
# number and not as further dotted fields:
#
#   a1     the main release - Alpha 1
#   a1.2   the first digit moves for a major bugfix
#   a1.23  the second moves for minor fixes and quality-of-life changes
#
# So a1.23 follows a1.22, a1.3 is the next major bugfix after a1.29, and
# there is never a second dot.
VERSION_TAG="a1.23"
VERSION="Arctic Linux - Alpha 1.23"
LABEL="ARCTIC"

case "$PROFILE" in
minimal) ISONAME="Arctic-linux-$VERSION_TAG.iso"; LABEL="ARCTIC_MIN" ;;
*) echo "mkiso: unknown profile '$PROFILE' (only 'minimal' exists)" >&2; exit 1 ;;
esac

step() { printf '\n\033[1;36m:: %s\033[0m\n' "$*"; }
ok()   { printf '   \033[32mok\033[0m %s\n' "$*"; }
die()  { printf '   \033[31mfatal\033[0m %s\n' "$*" >&2; exit 1; }

[ -d "$ROOTFS/usr/bin" ] || die "no rootfs at $ROOTFS - run build-rootfs.sh first"
[ -n "$KREL" ] || die "cannot determine the kernel release"

# Never rm -rf into a live mount. If anything is still bind-mounted under the
# work tree - /proc, /sys and /dev from a chroot session, say - a recursive
# delete would walk straight into the host's filesystems. Unmount first,
# deepest path first, and refuse to continue if any of them will not come loose.
unmount_work() {
	[ -d "$WORK" ] || return 0
	awk -v w="$WORK" '$2 ~ "^"w {print $2}' /proc/mounts \
		| sort -r | while read -r m; do
		printf '   unmounting stale mount %s\n' "$m"
		umount -l "$m" 2>/dev/null || umount -f "$m" 2>/dev/null || :
	done
	if awk -v w="$WORK" '$2 ~ "^"w {found=1} END{exit !found}' /proc/mounts; then
		die "something is still mounted under $WORK - refusing to delete it"
	fi
}
unmount_work

rm -rf "$WORK"
mkdir -p "$WORK/iso/boot" "$WORK/iso/arctic" "$WORK/iso/EFI/BOOT" "$WORK/squash"

# --------------------------------------------------------- 1. assemble the root
step "assembling the live root filesystem"
cp -a "$ROOTFS/." "$WORK/squash/"
S=$WORK/squash

# Arctic's own tooling. On the installed system these arrive as packages; on the
# ISO they are copied in directly so the installer exists before alpm runs.
install -Dm755 "$SRCTREE/alpm/alpm"        "$S/usr/bin/alpm"
install -Dm755 "$SRCTREE/alpm/alpm-build"  "$S/usr/bin/alpm-build"
install -Dm755 "$SRCTREE/alpm/alpm-repo"   "$S/usr/bin/alpm-repo"
install -Dm644 "$SRCTREE/alpm/libalpm.sh"  "$S/usr/lib/alpm/libalpm.sh"
install -Dm755 "$SRCTREE/installer/arctic-install"      "$S/usr/bin/arctic-install"
install -Dm755 "$SRCTREE/installer/arctic-boot-strap" "$S/usr/bin/arctic-boot-strap"
install -Dm755 "$SRCTREE/installer/arctic-chroot"     "$S/usr/bin/arctic-chroot"
install -Dm644 "$SRCTREE/installer/lib/tui.sh"        "$S/usr/lib/arctic/tui.sh"

# The base system skeleton: inittab, rc.boot, rc.d, zsh config, profile.
cp -a "$SRCTREE/skel/etc/." "$S/etc/"
cp -a "$SRCTREE/skel/usr/." "$S/usr/"
chmod +x "$S/etc/rc.boot" "$S/etc/rc.shutdown" "$S/etc/rc.d"/* \
	"$S/usr/bin/service" "$S/usr/bin/arcticfetch" "$S/usr/bin/arctic-firstboot"

# Branding: logos, wallpapers, the boot splash, the ascii art.
mkdir -p "$S/usr/share/arctic"
cp -a "$SRCTREE/branding/ascii"     "$S/usr/share/arctic/"
cp -a "$SRCTREE/branding/limine"    "$S/usr/share/arctic/"
cp -a "$SRCTREE/branding/plasma"    "$S/usr/share/arctic/"
cp -a "$SRCTREE/branding/wallpaper" "$S/usr/share/arctic/" 2>/dev/null || :
cp -a "$SRCTREE/branding/icons"     "$S/usr/share/arctic/" 2>/dev/null || :

# The ports tree, so 'alpm add -s' works offline on a fresh install.
mkdir -p "$S/var/lib/alpm/ports"
cp -a "$SRCTREE/ports/." "$S/var/lib/alpm/ports/"

ok "arctic tooling in place"

# ------------------------------------------------------------- 2. configure it
step "configuring the image"

cat >"$S/etc/arctic-release" <<EOF
NAME="Arctic Linux"
PRETTY_NAME="$VERSION"
ID=arctic
VERSION="$VERSION"
VERSION_ID=$VERSION_TAG
BUILD_ID=$BUILD_ID
PROFILE=$PROFILE
KERNEL=arctic-base-kernel
KERNEL_RELEASE=$KREL
LIBC=glibc
LIBC_VERSION=2.44
TOOLCHAIN=llvm
USERLAND=bsd
INIT=busybox
SHELL=zsh
PACKAGE_MANAGER=alpm
HOME_URL="https://github.com/apiwo/arctic-linux"
EOF
cp -f "$S/etc/arctic-release" "$S/etc/os-release"

printf 'arctic\n' >"$S/etc/hostname"
cat >"$S/etc/hosts" <<'EOF'
127.0.0.1	localhost
::1		localhost
127.0.1.1	arctic.localdomain	arctic
EOF
printf 'nameserver 1.1.1.1\nnameserver 9.9.9.9\n' >"$S/etc/resolv.conf"
printf 'LANG=en_US.UTF-8\nLC_COLLATE=C\n' >"$S/etc/locale.conf"
printf 'KEYMAP=us\n' >"$S/etc/vconsole.conf"

# Accounts. The live image logs straight in as root; there is nothing to steal
# on a read-only image, and the installer needs root anyway.
cat >"$S/etc/passwd" <<'EOF'
root:x:0:0:root:/root:/bin/zsh
messagebus:x:81:81:D-Bus system bus:/:/sbin/nologin
nobody:x:65534:65534:nobody:/:/sbin/nologin
EOF
cat >"$S/etc/group" <<'EOF'
root:x:0:
wheel:x:10:root
tty:x:5:
disk:x:6:
audio:x:63:
video:x:39:
input:x:97:
render:x:28:
kvm:x:78:
storage:x:95:
network:x:90:
netdev:x:91:
messagebus:x:81:
nobody:x:65534:
EOF
printf 'root::20000:0:99999:7:::\nmessagebus:!:20000:0:99999:7:::\nnobody:!:20000:0:99999:7:::\n' >"$S/etc/shadow"
chmod 600 "$S/etc/shadow"
printf '/bin/sh\n/bin/zsh\n/usr/bin/zsh\n' >"$S/etc/shells"

cat >"$S/etc/doas.conf" <<'EOF'
# Arctic Linux - doas rules
# nopass here specifically: the live session already logs straight in as
# root with an empty password (see the passwd/shadow block above) - doas's
# own auth check does not treat that shadow entry as "no password needed"
# the way login does, so a password-required rule just fails every time
# with "Authentication failed" for a password that, by design, does not
# exist yet to enter. Nothing on a live, read-only image is protected by
# asking anyway. arctic-install writes its own doas.conf for the installed
# system, unaffected by this - that one keeps password-required.
permit nopass :wheel
EOF
chmod 400 "$S/etc/doas.conf"

# alpm configuration and the repository list.
mkdir -p "$S/etc/alpm/repos.d"
cp -f "$SRCTREE/skel/etc/alpm/alpm.conf" "$S/etc/alpm/alpm.conf"
cp -f "$SRCTREE/skel/etc/alpm/repos.d/"*.repo "$S/etc/alpm/repos.d/"

# repos.d ships as-is: every entry points at the network mirror. Nothing is
# disabled in favour of a copy on the disc any more, which also means
# arctic-install has no medium-only entries left to clean up afterwards.
#
# The sync database is not pre-seeded either - there is nothing local to seed
# it from, and a stale index that looks current is worse than an empty one.
# The live session runs `alpm fetch all` before it installs anything.

# Tools that have to be on the installer image itself, not just available to
# install onto the target. The rootfs build only produces the minimum needed
# to boot; these come out of the packages the repo already has.
#
#   nano, vim   editing install.conf is the whole installation procedure now,
#               so an editor beyond busybox vi is not optional
#   curl        the only HTTPS client on the image. toybox's wget - the one
#   ca-certs    thing the rootfs had - answers every https:// URL with
#               "unsupported protocol", so `alpm fetch all` reported the
#               four network repositories unreachable on every single live
#               session while the four carried on the medium (file://)
#               worked, and nothing outside the disc could ever be
#               installed. ca-certificates is what curl verifies against.
#
# Wired networking during the install is rc.d/network + busybox udhcpc
# (built into the rootfs already); wireless is wpa_supplicant + wifi-connect,
# both staged straight into the rootfs by build-usable.sh - neither needs
# installing here as a separate live-only package the way dhcpcd used to.
# bmake is what provides /usr/bin/make. build-rootfs copies the bmake and
# gmake binaries into the image but not that symlink, so the live session had
# no `make` at all and every source build died on "make: not found" - dwm's
# among them. Installing the package puts the symlink where it belongs.
#   iw          the only way to find out what wireless networks are in range.
#               wpa_supplicant can associate with a network whose name you
#               already know and nothing else on the image could tell you
#               one, so "wifi-connect scan" answered "iw is not installed"
#               and the documented way onto a network was to type an SSID
#               exactly right from memory.
#   llvm        clang and lld, so the medium can compile. It is 1 GiB
#               installed and it is the single largest thing on the image by
#               a long way - the alternative is an installer that cannot
#               build anything until it has downloaded a compiler, on a
#               machine whose network may be the thing being repaired.
LIVE_EXTRAS="curl ca-certificates iw nano vim bmake llvm ttf-jetbrains-mono ttf-nerd-fonts-symbols"

# Dependencies are resolved, not assumed. Unpacking only the named packages
# put curl on the image without libnghttp2 or brotli, so it died at startup
# with "libnghttp2.so.14: cannot open shared object file" - and since curl is
# what every https repository is fetched with, every network repository was
# unreachable on the live session with no useful message about why.
#
# Walks the same INDEX files alpm reads. Anything the rootfs already provides
# is unpacked again harmlessly; anything with no package at all is reported
# rather than silently skipped.
live_deps() {
	_ld_seen=""
	_ld_todo="$*"
	while [ -n "$_ld_todo" ]; do
		_ld_next=""
		for _ld_p in $_ld_todo; do
			case " $_ld_seen " in *" $_ld_p "*) continue ;; esac
			_ld_seen="$_ld_seen $_ld_p"
			for _ld_i in "$B"/repo/*/x86_64/INDEX; do
				[ -f "$_ld_i" ] || continue
				_ld_d=$(awk -F'\t' -v n="$_ld_p" '$1==n{print $8; exit}' "$_ld_i")
				[ -n "$_ld_d" ] && break
			done
			for _ld_x in $_ld_d; do
				[ "$_ld_x" = "-" ] && continue
				case " $_ld_seen $_ld_next " in *" $_ld_x "*) continue ;; esac
				_ld_next="$_ld_next $_ld_x"
			done
		done
		_ld_todo=$_ld_next
	done
	printf '%s\n' $_ld_seen
}

step "installing live tools"
LIVE_SET=$(live_deps $LIVE_EXTRAS)
printf '   %s requested, %s with dependencies\n' \
	"$(printf '%s\n' $LIVE_EXTRAS | wc -l | tr -d ' ')" \
	"$(printf '%s\n' $LIVE_SET | wc -l | tr -d ' ')"
for p in $LIVE_SET; do
	pkg=$(ls -t "$B"/repo/*/x86_64/"$p"-*.alpmz 2>/dev/null | head -1)
	if [ -z "$pkg" ]; then
		printf '   %s not built - skipping\n' "$p" >&2
		continue
	fi
	# .alpmz is a plain tar.xz rooted at /, so unpacking it over the live
	# tree is all an install amounts to here. The metadata files are the
	# only thing that must not land in the filesystem itself.
	#
	# --keep-directory-symlink matters on a merged-/usr tree: a package with
	# files under usr/sbin/ would otherwise make tar replace the
	# usr/sbin -> bin symlink with a real directory, silently un-merging
	# /usr and splitting binaries across two places.
	tar -xf "$pkg" -C "$S" --keep-directory-symlink \
		--exclude=.PKGINFO --exclude=.FILES --exclude=.INSTALL \
		2>/dev/null || { printf '   %s failed to unpack\n' "$p" >&2; continue; }
	# Record it in the live image's own package database, so `alpm list` on
	# the installer agrees with what is actually installed there.
	d="$S/var/lib/alpm/local/$p"
	mkdir -p "$d"
	tar -xOf "$pkg" .PKGINFO >"$d/PKGINFO" 2>/dev/null || :
	tar -xOf "$pkg" .FILES   >"$d/FILES"   2>/dev/null || :
	# DEPS as well, from the package's own depend lines. Without it these
	# entries look installed but have no recorded dependencies, and the
	# resolver printed "can't open /var/lib/alpm/local/<pkg>/DEPS: no such
	# file" straight over its own progress bar for every one of them.
	sed -n 's/^depend = //p' "$d/PKGINFO" >"$d/DEPS" 2>/dev/null || : >"$d/DEPS"
	printf 'explicit\n' >"$d/REASON"
	printf 'activated = yes\n' >"$d/STATE"
	ok "$(basename "$pkg")"
done

# busybox --install symlinks every applet it was built with, vi among them.
# Arctic ships real vim and neovim, so the busybox one is only ever a worse
# editor that happens to win on PATH order. Point vi at vim instead of
# deleting it outright - plenty of muscle memory and more than one script
# still types "vi", and they should all get the real thing.
if [ -e "$S/usr/bin/vim" ]; then
	rm -f "$S/usr/bin/vi"
	ln -sf vim "$S/usr/bin/vi"
	ok "vi -> vim (busybox vi dropped)"
elif [ -e "$S/usr/bin/nvim" ]; then
	rm -f "$S/usr/bin/vi"
	ln -sf nvim "$S/usr/bin/vi"
	ok "vi -> nvim (busybox vi dropped)"
fi

# The live image mounts itself, so its fstab only describes the pseudo mounts.
cat >"$S/etc/fstab" <<'EOF'
# Arctic Linux live image
tmpfs	/tmp	tmpfs	rw,nosuid,nodev,size=50%	0 0
proc	/proc	proc	rw,nosuid,nodev,noexec	0 0
sysfs	/sys	sysfs	rw,nosuid,nodev,noexec	0 0
devpts	/dev/pts	devpts	rw,nosuid,noexec,gid=5,mode=620	0 0
EOF

# Services that should be up on the installer image. Wired DHCP comes up on
# its own; wireless is manual (`wifi-connect <ssid> <psk>`) since
# wpa_supplicant needs credentials it has no way to already have. Neither
# dbus nor NetworkManager ship on the live image at all - NetworkManager is
# the installed system's wireless story (see ports/main/networkmanager),
# too big a dependency tree to justify building into this early bootstrap
# stage just for an installer.
mkdir -p "$S/etc/arctic/services"
: >"$S/etc/arctic/services/network"
: >"$S/etc/arctic/services/syslogd"

# Log in on tty1 without asking, and greet the operator.
sed -i 's|^tty1::respawn:/sbin/getty 38400 tty1 linux|tty1::respawn:/sbin/getty -n -l /usr/bin/arctic-welcome 38400 tty1 linux|' \
	"$S/etc/inittab"

mkdir -p "$(dirname $S/usr/bin/arctic-welcome)"
cat >"$S/usr/bin/arctic-welcome" <<'WELCOME'
#!/bin/sh
# The Arctic installer greeting, shown on tty1 of the live image.
export HOME=/root
export TERM=${TERM:-linux}
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export ARCTIC_GREETED=1

R=$(printf '\033[0m'); B=$(printf '\033[1m')
TEAL=$(printf '\033[38;5;44m'); SNOW=$(printf '\033[38;5;231m')
GREY=$(printf '\033[38;5;245m'); AMB=$(printf '\033[38;5;215m')

# If Arctic is already installed on a disk here, say hello the Arctic way.
found=""
for d in /dev/sd?[0-9]* /dev/nvme?n?p[0-9]* /dev/vd?[0-9]*; do
	[ -b "$d" ] || continue
	mkdir -p /run/probe 2>/dev/null
	if mount -o ro "$d" /run/probe 2>/dev/null; then
		[ -f /run/probe/etc/arctic-release ] && found=$d
		umount /run/probe 2>/dev/null
	fi
	[ -n "$found" ] && break
done

clear
if [ -n "$found" ]; then
	printf '%s' "$TEAL$B"
	cat <<'ARCTIC'
 _____________________
< Enjoy Arctic linux! >
 ---------------------
   \
    \
        .--.
       |o_o |
       |:_/ |
      //   \ \
     (|     | )
    /'\_   _/`\
    \___)=(___/
ARCTIC
	printf '%s\n' "$R"
	printf '  %sArctic Linux is already installed on %s.%s\n\n' "$GREY" "$found" "$R"
else
	arcticfetch 2>/dev/null || true
	printf '\n'
fi

# Ctrl-D at the prompt ends the shell, which hands tty1 back to init to
# respawn. Do it a few times in a row and busybox init decides the console is
# "respawning too fast" and disables it for five minutes - from the outside
# that looks exactly like the live session breaking for no reason. Two things
# stop it: the shell below ignores EOF (ARCTIC_IGNORE_EOF, see /etc/zsh/zshrc),
# and if someone types "exit" anyway they get a fresh shell from here rather
# than a dead tty.
while :; do
	ARCTIC_IGNORE_EOF=1 /bin/zsh -l
	printf '\n%s  session ended - starting another. poweroff to shut down.%s\n\n' "$GREY" "$R"
	sleep 1
done
WELCOME
chmod 755 "$S/usr/bin/arctic-welcome"

# ------------------------------------------------- shared-library closure
# Pull in whatever the installed binaries actually link against.
#
# A package's recorded dependencies are what the manifest says, and that is
# not always what the compiler produced: curl's entry lists libressl, zlib,
# nghttp2, brotli and zstd, while the binary that got built also needs
# libidn2 and libpsl. Trusting the metadata put curl on the image twice with
# a different missing library each time - "libnghttp2.so.14: cannot open
# shared object file", then "libidn2.so.0" - and since curl is what fetches
# every https repository, the whole network side of the image was dead both
# times with a message that pointed nowhere near the cause.
#
# So this asks the ELF headers instead: collect every DT_NEEDED under the
# image, drop the ones already present, and find the package that ships each
# one that is missing. Repeats until nothing is missing, because a library
# pulled in this way brings its own.
close_libs() {
	# One pass over the repository builds a soname -> package map; the rounds
	# below look libraries up in it. Scanning every .alpmz once per missing
	# library instead meant decompressing 200-odd archives for each one,
	# which took longer than the rest of the image build put together.
	if [ ! -s "$WORK/sonames" ]; then
		printf '   indexing what each package provides\n'
		for pkg in "$B"/repo/*/x86_64/*.alpmz; do
			[ -f "$pkg" ] || continue
			_cl_n=$(basename "$pkg" | sed 's/-[^-]*-[0-9]*\.[^.]*\.alpmz$//')
			tar -xOf "$pkg" .FILES 2>/dev/null | \
				sed -n 's|.*/\([^/]*\.so[^/]*\)$|\1|p' | \
				while read -r so; do printf '%s\t%s\t%s\n' "$so" "$_cl_n" "$pkg"; done
		done >"$WORK/sonames"
	fi

	_cl_round=0
	while [ "$_cl_round" -lt 8 ]; do
		_cl_round=$((_cl_round+1))
		find "$S/usr/bin" "$S/usr/lib" "$S/usr/libexec" -type f 2>/dev/null | \
		while read -r f; do
			case "$f" in *.so|*.so.*|*/bin/*|*/libexec/*) ;; *) continue ;; esac
			readelf -d "$f" 2>/dev/null | sed -n 's/.*Shared library: \[\(.*\)\]/\1/p'
		done | sort -u >"$WORK/needed"
		find "$S/usr/lib" -name '*.so*' 2>/dev/null | \
			while read -r l; do basename "$l"; done | sort -u >"$WORK/have"
		comm -23 "$WORK/needed" "$WORK/have" >"$WORK/missing"
		if [ ! -s "$WORK/missing" ]; then
			printf '   every linked library is present\n'
			return 0
		fi

		_cl_added=""
		while read -r lib; do
			[ -n "$lib" ] || continue
			_cl_hit=$(awk -F'\t' -v l="$lib" '$1==l{print $2"\t"$3; exit}' "$WORK/sonames")
			[ -n "$_cl_hit" ] || continue
			_cl_n=$(printf '%s' "$_cl_hit" | cut -f1)
			pkg=$(printf '%s' "$_cl_hit" | cut -f2)
			case " $_cl_added " in *" $_cl_n "*) continue ;; esac
			_cl_added="$_cl_added $_cl_n"
			printf '   %s -> %s\n' "$lib" "$_cl_n"
			tar -xf "$pkg" -C "$S" --keep-directory-symlink \
				--exclude=.PKGINFO --exclude=.FILES --exclude=.INSTALL 2>/dev/null || :
			d="$S/var/lib/alpm/local/$_cl_n"
			mkdir -p "$d"
			tar -xOf "$pkg" .PKGINFO >"$d/PKGINFO" 2>/dev/null || :
			tar -xOf "$pkg" .FILES   >"$d/FILES"   2>/dev/null || :
			sed -n 's/^depend = //p' "$d/PKGINFO" >"$d/DEPS" 2>/dev/null || : >"$d/DEPS"
			printf 'dep\n' >"$d/REASON"
			printf 'activated = yes\n' >"$d/STATE"
		done <"$WORK/missing"

		if [ -z "$_cl_added" ]; then
			printf '   no package provides these, and the image needs them:\n'
			sed 's/^/     /' "$WORK/missing"
			return 1
		fi
	done
	return 0
}
step "resolving shared libraries"
close_libs || printf '   the image has unresolved libraries - see above\n' >&2

# An executable whose library is not on the image is not a program, it is a
# guaranteed "cannot open shared object file" the first time someone runs it.
# Three of them shipped this way: fuse2fs, and nghttp2's HPACK test tools
# inflatehd and deflatehd, none of which an installation image needs. Better
# absent than present and broken - and named here, so a binary that actually
# mattered would be noticed rather than quietly dropped.
if [ -s "$WORK/missing" ]; then
	while read -r sona; do
		[ -n "$sona" ] || continue
		for f in "$S"/usr/bin/* "$S"/usr/sbin/*; do
			[ -f "$f" ] || continue
			readelf -d "$f" 2>/dev/null | grep -q "\[$sona\]" || continue
			rm -f "$f"
			printf '   removed %s - nothing on the image provides %s\n' \
				"${f#"$S"}" "$sona"
		done
	done <"$WORK/missing"
fi

ok "image configured"

# ------------------------------------------------------- 3. depmod the modules
step "indexing kernel modules for $KREL"
if [ -d "$S/usr/lib/modules/$KREL" ]; then
	depmod -b "$S" "$KREL" 2>/dev/null || :
	ok "modules.dep written"
else
	printf '   modules for %s are not in the image\n' "$KREL"
fi

# ------------------------------------------------------------ 4. the initramfs
step "building the initramfs"
IRD=$WORK/initramfs
rm -rf "$IRD"
mkdir -p "$IRD"/{bin,dev,proc,sys,run,mnt,newroot,lib/modules}

# A static busybox: at this point nothing else exists to link against.
if [ -f "$B/stage/busybox.static" ]; then
	install -Dm755 "$B/stage/busybox.static" "$IRD/bin/busybox"
else
	install -Dm755 "$S/usr/bin/busybox" "$IRD/bin/busybox"
	printf '   warning: using the dynamic busybox in the initramfs\n'
fi
for a in sh mount umount switch_root mkdir sleep echo cat ls losetup modprobe \
	insmod findfs blkid dmesg mknod chroot printf test grep sed cut sync \
	poweroff reboot; do
	ln -sf busybox "$IRD/bin/$a"
done

cat >"$IRD/init" <<'INIT'
#!/bin/busybox sh
# Arctic Linux - live image early userspace.
#
# The job here is small: find the medium this kernel was booted from, mount the
# squashfs inside it, put a writable overlay on top, and hand over to the real
# init. Storage and filesystem support is built into the Arctic kernel, so no
# modules are needed to get this far.

PATH=/bin
export PATH

/bin/busybox --install -s /bin 2>/dev/null

mount -t proc     proc /proc
mount -t sysfs    sys  /sys
mount -t devtmpfs dev  /dev
mount -t tmpfs    run  /run

R=$(printf '\033[0m'); TEAL=$(printf '\033[38;5;44m')
say()  { printf '%s::%s %s\n' "$TEAL" "$R" "$*"; }
oops() {
	printf '\n%s!!%s %s\n\n' "$(printf '\033[38;5;203m')" "$R" "$*"
	printf 'Dropping to a shell. The medium was not found.\n'
	printf 'Try: ls /dev, then mount it by hand under /mnt.\n\n'
	exec sh
}

# The kernel command line tells us the label to look for.
LABEL=ARCTIC
for a in $(cat /proc/cmdline); do
	case "$a" in
	arctic.label=*) LABEL=${a#arctic.label=} ;;
	esac
done

say "looking for the Arctic medium ($LABEL)"

# Give USB and optical drives a moment to enumerate.
DEV=""
n=0
while [ "$n" -lt 20 ]; do
	DEV=$(findfs "LABEL=$LABEL" 2>/dev/null) && [ -n "$DEV" ] && break
	# Fall back to scanning anything that holds our payload.
	for d in /dev/sr* /dev/sd* /dev/nvme* /dev/vd* /dev/mmcblk*; do
		[ -b "$d" ] || continue
		mount -t iso9660 -o ro "$d" /mnt 2>/dev/null || \
			mount -o ro "$d" /mnt 2>/dev/null || continue
		if [ -f /mnt/arctic/rootfs.squashfs ]; then DEV=$d; break; fi
		umount /mnt 2>/dev/null
	done
	[ -n "$DEV" ] && break
	sleep 1
	n=$((n+1))
done

[ -n "$DEV" ] || oops "no medium with an Arctic filesystem on it"
say "found $DEV"

mountpoint -q /mnt 2>/dev/null || {
	mount -t iso9660 -o ro "$DEV" /mnt 2>/dev/null || mount -o ro "$DEV" /mnt
} || oops "could not mount $DEV"

[ -f /mnt/arctic/rootfs.squashfs ] || oops "$DEV has no /arctic/rootfs.squashfs"

say "mounting the root filesystem"
mkdir -p /run/lower /run/upper /run/work
mount -t squashfs -o ro,loop /mnt/arctic/rootfs.squashfs /run/lower \
	|| oops "the squashfs would not mount"

# A tmpfs overlay makes the read-only image writable for the session.
mount -t tmpfs -o size=75%,mode=755 tmpfs /run/upper || oops "no memory for the overlay"
mkdir -p /run/upper/upper /run/upper/work
mount -t overlay overlay \
	-o lowerdir=/run/lower,upperdir=/run/upper/upper,workdir=/run/upper/work \
	/newroot || oops "overlayfs failed"

# Keep the medium reachable from inside the running system.
#
# The tmpfs has to go down first. rc.boot mounts one on /run itself unless /run
# is already a mount point, and that would hide the medium - taking the offline
# package repository with it.
mkdir -p /newroot/run
mount -t tmpfs -o nosuid,nodev,mode=755 run /newroot/run 2>/dev/null || :
mkdir -p /newroot/run/arctic/medium
mount --move /mnt /newroot/run/arctic/medium 2>/dev/null \
	|| say "warning: the medium could not be carried across"

# The new root needs a populated /dev before init takes over. busybox init opens
# /dev/console for all of its output, and rc.boot cannot mount devtmpfs until it
# is already running - so an empty /dev means a completely silent boot, working
# or not. Move our devtmpfs across rather than unmounting it.
mkdir -p /newroot/dev /newroot/proc /newroot/sys
mount --move /dev /newroot/dev 2>/dev/null \
	|| mount -t devtmpfs -o nosuid,mode=755 dev /newroot/dev 2>/dev/null \
	|| oops "cannot give the new root a /dev"

say "starting Arctic Linux"
umount /sys 2>/dev/null || :
umount /proc 2>/dev/null || :
exec switch_root /newroot /sbin/init
INIT
chmod 755 "$IRD/init"

# Character devices the kernel expects before devtmpfs is up.
mknod -m 600 "$IRD/dev/console" c 5 1 2>/dev/null || :
mknod -m 666 "$IRD/dev/null" c 1 3 2>/dev/null || :

( cd "$IRD" && find . -print0 | cpio --null -o -H newc 2>/dev/null | \
	xz -T0 --check=crc32 -9 ) >"$WORK/iso/boot/initramfs-arctic.img"
ok "initramfs $(du -h "$WORK/iso/boot/initramfs-arctic.img" | cut -f1)"

# -------------------------------------------------------------- 5. the squashfs
step "compressing the root filesystem (this is the slow part)"
mksquashfs "$S" "$WORK/iso/arctic/rootfs.squashfs" \
	-comp zstd -Xcompression-level 19 \
	-b 1M -no-recovery -noappend -quiet \
	-e boot/vmlinuz-arctic-base boot/System.map-arctic-base
ok "squashfs $(du -h "$WORK/iso/arctic/rootfs.squashfs" | cut -f1)"

# ------------------------------------------------------------- 6. boot payload
step "installing the kernel and bootloader"
cp -f "$B/stage/kernel-base/boot/vmlinuz-arctic-base" "$WORK/iso/boot/vmlinuz-arctic"
cp -f "$B/stage/kernel-base/boot/config-arctic-base"  "$WORK/iso/boot/config-arctic"

LIM=$ROOTFS/usr/share/limine
[ -f "$LIM/limine-bios-cd.bin" ] || die "limine boot files are missing from the rootfs"
cp -f "$LIM/limine-bios-cd.bin"  "$WORK/iso/boot/"
cp -f "$LIM/limine-uefi-cd.bin"  "$WORK/iso/boot/"
cp -f "$LIM/limine-bios.sys"     "$WORK/iso/boot/"
cp -f "$LIM/BOOTX64.EFI"         "$WORK/iso/EFI/BOOT/BOOTX64.EFI"
[ -f "$LIM/BOOTIA32.EFI" ] && cp -f "$LIM/BOOTIA32.EFI" "$WORK/iso/EFI/BOOT/BOOTIA32.EFI"
cp -f "$SRCTREE/branding/limine/splash.png" "$WORK/iso/boot/arctic-splash.png" 2>/dev/null || :

# Limine's own configuration. The entry is named exactly "Arctic linux".
cat >"$WORK/iso/boot/limine.conf" <<EOF
# $VERSION - $PROFILE ($BUILD_ID)
timeout: 5
default_entry: 1
interface_branding: $VERSION
term_palette: 1a1b26;f7768e;9ece6a;e0af68;7aa2f7;bb9af7;7dcfff;c0caf5
term_palette_bright: 414868;ff899d;9fe044;faba4a;8db0ff;c7a9ff;a4daff;c8d3f5
term_background: 1a1b26
term_foreground: c8d3f5
graphics: yes
wallpaper: boot():/arctic-splash.png
wallpaper_style: centered
backdrop: 5f5bc6

/Arctic linux
    protocol: linux
    kernel_path: boot():/boot/vmlinuz-arctic
    module_path: boot():/boot/initramfs-arctic.img
    kernel_cmdline: arctic.label=$LABEL quiet loglevel=3

/Arctic linux (verbose)
    protocol: linux
    kernel_path: boot():/boot/vmlinuz-arctic
    module_path: boot():/boot/initramfs-arctic.img
    kernel_cmdline: arctic.label=$LABEL loglevel=7

/Arctic linux (safe graphics)
    protocol: linux
    kernel_path: boot():/boot/vmlinuz-arctic
    module_path: boot():/boot/initramfs-arctic.img
    kernel_cmdline: arctic.label=$LABEL nomodeset quiet

/Arctic linux (copy to RAM)
    protocol: linux
    kernel_path: boot():/boot/vmlinuz-arctic
    module_path: boot():/boot/initramfs-arctic.img
    kernel_cmdline: arctic.label=$LABEL arctic.toram quiet
EOF
cp -f "$WORK/iso/boot/limine.conf" "$WORK/iso/limine.conf"

# No repositories on the medium. The image used to carry main, kernels and
# profile - some 410 MiB of .alpmz - so that an install could run with no
# network at all. The cost was an install that fetched from a snapshot as old
# as the ISO and had to be brought up to date immediately afterwards, and a
# medium that had to be rebuilt for every package change. Packages come from
# the mirror now, which is where they are current.
step "repositories"
ok "none on the medium - packages are fetched from the network"

cat >"$WORK/iso/arctic/version" <<EOF
name=Arctic Linux
profile=$PROFILE
build=$BUILD_ID
kernel=$KREL
libc=glibc 2.44
userland=toybox + busybox
shell=zsh
init=busybox init
toolchain=llvm
bootloader=limine
package_manager=alpm
EOF
ok "bootloader configured"

# ---------------------------------------------------------------- 7. the image
step "mastering the ISO"
mkdir -p "$OUT"
rm -f "$OUT/$ISONAME"

xorriso -as mkisofs \
	-volid "$LABEL" \
	-appid "$VERSION ($BUILD_ID)" \
	-publisher "Arctic Linux" \
	-preparer "mkiso" \
	-joliet -rational-rock \
	-b boot/limine-bios-cd.bin \
		-no-emul-boot -boot-load-size 4 -boot-info-table \
		--efi-boot boot/limine-uefi-cd.bin \
		-efi-boot-part --efi-boot-image \
	--protective-msdos-label \
	"$WORK/iso" -o "$OUT/$ISONAME" 2>&1 | grep -viE '^xorriso : (UPDATE|NOTE)' || true

[ -f "$OUT/$ISONAME" ] || die "xorriso did not produce an image"

# Make the image bootable when written straight to a USB stick.
if [ -x "$ROOTFS/usr/bin/limine" ]; then
	"$ROOTFS/usr/bin/limine" bios-install "$OUT/$ISONAME" >/dev/null 2>&1 \
		&& ok "hybrid MBR written (dd to a USB stick and it boots)" \
		|| printf '   note: limine bios-install skipped\n'
fi

( cd "$OUT" && sha256sum "$ISONAME" >"$ISONAME.sha256" )

printf '\n\033[1;36m=== ISO DONE ===\033[0m\n'
printf 'image:   %s\n' "$OUT/$ISONAME"
printf 'size:    %s\n' "$(du -h "$OUT/$ISONAME" | cut -f1)"
printf 'label:   %s\n' "$LABEL"
printf 'kernel:  %s\n' "$KREL"
printf 'sha256:  %s\n' "$(cut -d' ' -f1 "$OUT/$ISONAME.sha256")"
